# Server Configuration
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Bangkok
DB_TIMEZONE=+07:00
# Optional comma-separated browser origins allowed to call the API cross-site.
# Leave empty when the web app and API are served from the same domain.
CORS_ORIGIN=

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME_HOSPITAL=hospital_db
DB_NAME_HOSOFFICE=hosoffice

# Notification Service (Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# Notification Service (LINE)
LINE_CHANNEL_ACCESS_TOKEN=your_line_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_ADMIN_USER_ID=your_line_admin_user_id

# Google Sheets Configuration (CSV Publish Link)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/pub?output=csv

# Real-time Notifications Switch (Set to false to disable)
ENABLE_REALTIME_NOTIFICATIONS=true
# Copy every scan card to TELEGRAM_ADMIN_CHAT_ID (default true). false = staff only get their own card.
# REALTIME_COPY_ADMIN=false
# LINE push quota: 'important' (default) = LINE only for approvals, reminders and admin alerts;
# scan cards / check-in / weekly summary go to Telegram. 'all' = push everything on LINE (paid OA plan).
# LINE_PUSH_POLICY=important
# Answer chat commands on Telegram (only ONE running instance may poll the same bot)
# ENABLE_TELEGRAM_POLLING=true
# LINE_CHANNEL_SECRET above is required: webhook calls without a valid X-Line-Signature are rejected.

# Shared secret for POST /api/attendance (scanner push, header X-Attendance-Token). Unset = endpoint disabled.
# ATTENDANCE_PUSH_TOKEN=

# Sessions are stored in MySQL (table `sessions`, created automatically in DB_NAME_HOSPITAL).
# Set SESSION_STORE=memory only for local development without a database.
# SESSION_STORE=memory
# DB_PORT=3306
# Public URL used in reminder links (e.g. https://hr.klonghad-hospital.go.th)
# SYSTEM_URL=

# ---- Mobile face scan (LINE LIFF) ----
# 32-byte key that encrypts face templates (PDPA biometric data). Generate once and keep it safe:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it means everyone must enrol again. Never commit the real value.
# FACE_TEMPLATE_KEY=
# LINE Login channel (same Provider as the Messaging API channel, so user ids match) and its LIFF app.
# LIFF endpoint URL: https://<your-domain>/m/face · size Full · scopes: openid, profile
# LINE_LOGIN_CHANNEL_ID=
# LIFF_ID=

# ---- Monitoring & backup ----
# Alert admins when no Hikvision scans arrive for this many minutes during the watch window (Mon–Fri, not holidays)
# SCANNER_SILENCE_MINUTES=45
# SCANNER_WATCH_HOURS=07:30-16:30
# Nightly 03:00 backup (gzip SQL). Default folder: ./backups. Restore: unzip, then run the .sql in Navicat.
# BACKUP_DIR=D:\\backup\\khh-hrm
# BACKUP_KEEP_DAYS=14
# Also back up these HOSoffice tables (mobile scans are written to hikvision), comma separated
# BACKUP_HOSOFFICE_TABLES=hikvision
# Working-day evening reminder for office staff who scanned in but not out (Telegram only)
# FORGOT_CHECKOUT_TIME=17:30
# Telegram bot @username for "เชื่อม Telegram" links (optional: asked from Telegram when empty).
# Linking needs ENABLE_TELEGRAM_POLLING=true so the bot receives /start.
# TELEGRAM_BOT_USERNAME=KH_SmartAccess_bot
