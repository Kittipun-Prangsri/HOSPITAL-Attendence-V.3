<!DOCTYPE html>
<html lang="th">

<head>
  <%- include("components/erp-head", { title: "ตารางเวร" }) %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</head>

<% const canManage = locals.user && (user.role === 'admin' || user.role === 'super'); %>

<body class="erp-page">
  <%- include("components/sidebar") %>
  <div class="main" role="main">
    <%- include("components/topbar") %>
    <% const months = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"]; %>
    <% const now = new Date(); const currentMonth = now.getMonth() + 1; const currentYear = now.getFullYear(); %>

    <div class="erp px-4 py-5 lg:px-6">
      <section class="mb-5 flex flex-wrap items-end justify-between gap-4 print:hidden" aria-labelledby="schedule-heading">
        <div>
          <h2 id="schedule-heading" class="text-xl font-semibold text-slate-900"><%= canManage ? 'ตารางเวรประจำสัปดาห์' : 'ตารางเวรของฉัน' %></h2>
          <p class="mt-1 text-[13px] text-slate-500"><%= canManage ? 'ดูและจัดการการลงเวรรายวันของบุคลากร' : 'ดูเวรที่ได้รับมอบหมาย การลงเวลา และสรุปประจำเดือนของคุณ' %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="erp-btn erp-btn-secondary" onclick="window.print()"><i class="bi bi-printer" aria-hidden="true"></i> พิมพ์ / PDF</button>
          <button type="button" class="erp-btn erp-btn-secondary" onclick="exportExcel()"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> ส่งออก Excel</button>
          <% if (canManage) { %>
            <button type="button" class="erp-btn erp-btn-primary" onclick="openAddEmpModal()"><i class="bi bi-plus-lg" aria-hidden="true"></i> ลงเวร</button>
          <% } %>
        </div>
      </section>

      <section class="erp-panel overflow-hidden">
        <div class="flex gap-1 overflow-x-auto border-b border-slate-200 px-3 print:hidden" role="tablist" id="tabBar">
          <% [['calendar','bi-calendar-week','ตารางสัปดาห์'],['team','bi-people', canManage ? 'รายชื่อบุคลากร' : 'ข้อมูลของฉัน'],['daily-report','bi-file-earmark-bar-graph','การลงเวลารายวัน'],['monthly-report','bi-calendar3','สรุปรายเดือน']].forEach(([id, icon, label], i) => { %>
            <button type="button" role="tab" class="erp-tab whitespace-nowrap <%= i === 0 ? 'active' : '' %>" data-tab="<%= id %>" aria-selected="<%= i === 0 %>">
              <i class="bi <%= icon %>" aria-hidden="true"></i> <%= label %>
            </button>
          <% }); %>
        </div>

        <!-- TAB: CALENDAR -->
        <div id="tab-calendar">
          <div class="grid grid-cols-2 border-b border-slate-200 sm:grid-cols-4 sm:divide-x sm:divide-slate-100">
            <% [['stat-total','บุคลากรที่ลงเวรสัปดาห์นี้','คน','text-slate-900'],['stat-morning','เวรเช้า','ครั้ง','text-amber-700'],['stat-afternoon','เวรบ่าย','ครั้ง','text-sky-700'],['stat-night','เวรดึก','ครั้ง','text-violet-700']].forEach(([id, label, unit, tone]) => { %>
              <div class="px-4 py-3">
                <div class="truncate text-2xs text-slate-500"><%= label %></div>
                <div class="flex items-baseline gap-1"><span id="<%= id %>" class="font-mono text-xl font-semibold tabular-nums <%= tone %>">–</span><span class="text-2xs text-slate-400"><%= unit %></span></div>
              </div>
            <% }); %>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 p-3 print:hidden">
            <h3 id="cal-title" class="px-1 text-[13px] font-semibold text-slate-800">–</h3>
            <div class="flex items-center gap-1">
              <button type="button" class="erp-icon-btn" onclick="prevWeek()" aria-label="สัปดาห์ก่อน"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
              <input type="date" id="cal-jump" class="erp-input h-8 w-auto" onchange="jumpToSpecificDate(this.value)" aria-label="ไปยังวันที่">
              <button type="button" class="erp-btn erp-btn-secondary h-8" onclick="goToday()">สัปดาห์นี้</button>
              <button type="button" class="erp-icon-btn" onclick="nextWeek()" aria-label="สัปดาห์ถัดไป"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[880px] table-fixed border-collapse text-left text-xs">
              <thead id="week-head"></thead>
              <tbody id="week-grid"></tbody>
            </table>
          </div>
        </div>

        <!-- TAB: TEAM -->
        <div id="tab-team" style="display:none;">
          <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 p-3">
            <div class="relative min-w-[220px] flex-1 sm:max-w-sm">
              <i class="bi bi-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
              <input type="search" id="teamSearch" class="erp-input pl-9" placeholder="ค้นหาชื่อหรือรหัส…" oninput="renderTeam()" aria-label="ค้นหา">
            </div>
            <span id="teamCount" class="ml-auto text-xs text-slate-500"></span>
          </div>
          <div class="max-h-[65vh] overflow-auto">
            <table class="w-full border-collapse text-left text-[13px]">
              <thead class="sticky top-0 bg-slate-50 text-2xs uppercase tracking-wide text-slate-500">
                <tr class="border-b border-slate-200">
                  <th class="px-4 py-2.5 font-semibold">บุคลากร</th>
                  <th class="px-3 py-2.5 font-semibold">กลุ่มงาน</th>
                  <th class="px-3 py-2.5 font-semibold">โทรศัพท์</th>
                  <th class="px-3 py-2.5 text-right font-semibold">เวรเดือนนี้</th>
                  <th class="px-4 py-2.5 font-semibold">เวรถัดไป</th>
                </tr>
              </thead>
              <tbody id="team-grid" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
        </div>

        <!-- TAB: DAILY REPORT -->
        <div id="tab-daily-report" style="display:none;">
          <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 p-3">
            <input type="date" id="report-date-input" class="erp-input w-auto" onchange="fetchDailyReportData()" aria-label="วันที่">
            <button type="button" class="erp-btn erp-btn-ghost" onclick="fetchDailyReportData()"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> รีเฟรช</button>
            <span class="ml-auto text-2xs text-slate-400">แสดงเฉพาะบุคลากรที่มีเวรในวันที่เลือก</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left text-[13px]">
              <thead class="bg-slate-50 text-2xs uppercase tracking-wide text-slate-500">
                <tr class="border-b border-slate-200">
                  <th class="px-4 py-2.5 font-semibold">ชื่อ-นามสกุล</th>
                  <th class="px-3 py-2.5 font-semibold">กลุ่มงาน</th>
                  <th class="px-3 py-2.5 font-semibold">เวร</th>
                  <th class="px-3 py-2.5 font-semibold">สถานะ</th>
                  <th class="px-3 py-2.5 text-center font-semibold">เข้า</th>
                  <th class="px-3 py-2.5 text-center font-semibold">ออก</th>
                  <th class="px-4 py-2.5 text-right font-semibold">ชั่วโมง</th>
                </tr>
              </thead>
              <tbody id="daily-report-body" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
        </div>

        <!-- TAB: MONTHLY REPORT -->
        <div id="tab-monthly-report" style="display:none;">
          <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 p-3">
            <select id="monthly-month-input" class="erp-input w-auto" onchange="fetchMonthlyReportData()" aria-label="เดือน">
              <% months.forEach((m, i) => { %><option value="<%= i + 1 %>" <%= (i + 1) === currentMonth ? 'selected' : '' %>><%= m %></option><% }); %>
            </select>
            <select id="monthly-year-input" class="erp-input w-auto" onchange="fetchMonthlyReportData()" aria-label="ปี">
              <% for (let y = currentYear - 1; y <= currentYear; y++) { %><option value="<%= y %>" <%= y === currentYear ? 'selected' : '' %>><%= y + 543 %></option><% } %>
            </select>
          </div>
          <div class="grid grid-cols-2 border-b border-slate-200 sm:grid-cols-4 sm:divide-x sm:divide-slate-100">
            <% [['monthly-stat-days','มาทำงานรวม','วัน'],['monthly-stat-late','มาสายสะสม','ครั้ง'],['monthly-stat-absent','ขาดงาน','วัน'],['monthly-stat-leave','ลา','วัน']].forEach(([id, label, unit]) => { %>
              <div class="px-4 py-3">
                <div class="text-2xs text-slate-500"><%= label %></div>
                <div class="flex items-baseline gap-1"><span id="<%= id %>" class="font-mono text-xl font-semibold tabular-nums text-slate-900">–</span><span class="text-2xs text-slate-400"><%= unit %></span></div>
              </div>
            <% }); %>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left text-[13px]">
              <thead class="bg-slate-50 text-2xs uppercase tracking-wide text-slate-500">
                <tr class="border-b border-slate-200">
                  <th class="px-4 py-2.5 font-semibold">ชื่อ-นามสกุล</th>
                  <th class="px-3 py-2.5 text-right font-semibold">มาทำงาน</th>
                  <th class="px-3 py-2.5 text-right font-semibold">มาสาย</th>
                  <th class="px-3 py-2.5 text-right font-semibold">ขาด</th>
                  <th class="px-3 py-2.5 text-right font-semibold">ลา</th>
                  <th class="px-4 py-2.5 font-semibold">สถานะ</th>
                </tr>
              </thead>
              <tbody id="monthly-report-body" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>

  <% if (canManage) { %>
    <!-- ASSIGNMENT DRAWER -->
    <div id="shift-modal-overlay" class="erp fixed inset-0 z-[10000] hidden" role="dialog" aria-modal="true" aria-labelledby="shift-modal-title">
      <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[2px]" onclick="closeModalDirect()"></div>
      <form id="shiftForm" class="absolute inset-y-0 right-0 m-0 flex w-full max-w-[460px] flex-col bg-white shadow-drawer">
        <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
          <h3 id="shift-modal-title" class="text-base font-semibold text-slate-900">ลงเวร</h3>
          <button type="button" class="erp-icon-btn" onclick="closeModalDirect()" aria-label="ปิด"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </header>
        <div class="flex-1 space-y-4 overflow-y-auto bg-slate-50/60 p-5">
          <section class="erp-panel space-y-3 p-4">
            <div>
              <label class="erp-label" for="f-person">บุคลากร <span class="text-red-500">*</span></label>
              <select id="f-person" class="erp-input" required></select>
            </div>
            <div>
              <label class="erp-label" for="f-date">วันที่ลงเวร <span class="text-red-500">*</span></label>
              <input type="date" id="f-date" class="erp-input" required>
            </div>
          </section>
          <fieldset class="erp-panel m-0 p-4">
            <legend class="sr-only">กะ</legend>
            <span class="erp-label">กะ</span>
            <div class="grid grid-cols-3 gap-2" id="shiftOptions"></div>
          </fieldset>
        </div>
        <footer class="flex items-center gap-2 border-t border-slate-200 px-5 py-3">
          <button type="button" id="btn-delete" class="erp-btn erp-btn-ghost mr-auto text-red-600 hover:bg-red-50" onclick="deleteEmployee()" style="display:none;"><i class="bi bi-trash3" aria-hidden="true"></i> ลบเวรนี้</button>
          <button type="button" class="erp-btn erp-btn-secondary" onclick="closeModalDirect()">ยกเลิก</button>
          <button type="submit" id="btn-save-shift" class="erp-btn erp-btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> บันทึก</button>
        </footer>
      </form>
    </div>
  <% } %>

  <script>
    const CAN_MANAGE = <%- JSON.stringify(!!canManage) %>;
    const SHIFT_TYPES = [
      { type: 'MORNING', name: 'เช้า', label: 'กะเช้า', chip: 'bg-amber-50 text-amber-800 ring-amber-200', dot: 'bg-amber-500', fallback: '08:00–16:00' },
      { type: 'AFTERNOON', name: 'บ่าย', label: 'กะบ่าย', chip: 'bg-sky-50 text-sky-800 ring-sky-200', dot: 'bg-sky-500', fallback: '16:00–24:00' },
      { type: 'NIGHT', name: 'ดึก', label: 'กะดึก', chip: 'bg-violet-50 text-violet-800 ring-violet-200', dot: 'bg-violet-500', fallback: '00:00–08:00' }
    ];
    // The monthly planner stores Thai shift names; this page stores MORNING/AFTERNOON/NIGHT — read both.
    const SHIFT_ALIASES = { MORNING: 'MORNING', 'เช้า': 'MORNING', AFTERNOON: 'AFTERNOON', 'บ่าย': 'AFTERNOON', NIGHT: 'NIGHT', 'ดึก': 'NIGHT' };
    const DAYS_TH = ['อา', 'จ', 'อ', 'พ', 'พฤ', 'ศ', 'ส'];
    const MONTHS_TH = <%- JSON.stringify(months) %>;
    const STATUS = { in: ['เข้างาน', 'green'], late: ['มาสาย', 'amber'], out: ['ออกงานแล้ว', 'sky'], leave: ['ลา', 'violet'], none: ['ยังไม่บันทึก', 'slate'] };
    const $ = id => document.getElementById(id);
    const esc = ERP.escapeHtml;
    const fmt = n => Number(n || 0).toLocaleString('th-TH');
    const localIso = d => d.toLocaleDateString('sv-SE');
    const me = String(typeof CURRENT_USER_ID !== 'undefined' ? CURRENT_USER_ID : '');

    let people = [];       // [{ id, name, dept, phone }]
    let assignments = [];  // [{ personId, date, shift }]
    let currentWeekOffset = 0;
    let editing = null;

    function shiftTime(s) {
      const configured = ((window.loadSettings && window.loadSettings().shifts) || []).find(x => x.name === s.name);
      return configured ? `${configured.start}–${configured.end}` : s.fallback;
    }

    function getWeekDates(offset = 0) {
      const today = new Date();
      today.setHours(12, 0, 0, 0);
      const monday = new Date(today);
      monday.setDate(today.getDate() - ((today.getDay() + 6) % 7) + offset * 7);
      return Array.from({ length: 7 }, (_, i) => { const d = new Date(monday); d.setDate(monday.getDate() + i); return d; });
    }

    /* ---------------- Data ---------------- */
    async function loadEmployees() {
      try {
        const [pRes, sRes] = await Promise.all([
          fetch('/api/personnel', { headers: { Accept: 'application/json' } }),
          fetch('/api/schedule', { headers: { Accept: 'application/json' } }).catch(() => null)
        ]);
        const pData = await pRes.json();
        const rows = sRes && sRes.ok ? await sRes.json() : [];
        people = (pData.personnel || []).map(p => ({
          id: String(p.FINGLE_ID || p.ID),
          name: `${p.HR_FNAME || ''} ${p.HR_LNAME || ''}`.trim() || 'ไม่ระบุชื่อ',
          dept: p.HR_DEPARTMENT_NAME || 'ไม่ระบุแผนก',
          phone: p.HR_PHONE || ''
        }));
        const known = new Set(people.map(p => p.id));
        assignments = (Array.isArray(rows) ? rows : [])
          .map(r => ({ personId: String(r.emp_id), date: r.date, shift: SHIFT_ALIASES[String(r.shift).trim()] || null }))
          .filter(a => a.shift && known.has(a.personId));
        renderCalendar();
        if ($('tab-team').style.display !== 'none') renderTeam();
      } catch (err) {
        console.error('Error fetching personnel', err);
        ERP.toast('ไม่สามารถดึงข้อมูลบุคลากรได้', 'error');
      }
    }
    const loadData = loadEmployees;

    const personById = id => people.find(p => p.id === String(id));

    /* ---------------- Calendar ---------------- */
    function renderCalendar() {
      const dates = getWeekDates(currentWeekOffset);
      const first = dates[0], last = dates[6];
      $('cal-title').textContent = `${first.getDate()} ${MONTHS_TH[first.getMonth()]} – ${last.getDate()} ${MONTHS_TH[last.getMonth()]} ${last.getFullYear() + 543}`;
      const todayIso = ERP.todayIso();
      $('week-head').innerHTML = `<tr class="border-b border-slate-200 bg-slate-50">
        <th class="w-32 px-3 py-2 text-2xs font-semibold uppercase tracking-wide text-slate-500">กะ</th>
        ${dates.map(d => {
          const iso = localIso(d);
          const isToday = iso === todayIso;
          const we = d.getDay() === 0 || d.getDay() === 6;
          return `<th class="border-l border-slate-200 px-2 py-2 text-center ${we ? 'bg-slate-100/70' : ''}">
            <div class="text-2xs font-normal ${isToday ? 'text-brand-700' : 'text-slate-500'}">${DAYS_TH[d.getDay()]}</div>
            <div class="mx-auto mt-0.5 flex h-7 w-7 items-center justify-center rounded-full text-sm font-semibold ${isToday ? 'bg-brand-600 text-white' : 'text-slate-800'}">${d.getDate()}</div>
          </th>`;
        }).join('')}
      </tr>`;

      const weekIso = dates.map(localIso);
      const inWeek = assignments.filter(a => weekIso.includes(a.date));
      $('week-grid').innerHTML = SHIFT_TYPES.map(s => `<tr class="border-b border-slate-100 align-top">
        <th class="px-3 py-3 text-left font-normal">
          <div class="flex items-center gap-1.5 text-[13px] font-semibold text-slate-800"><span class="h-2 w-2 rounded-full ${s.dot}"></span>${s.label}</div>
          <div class="mt-0.5 font-mono text-2xs text-slate-400">${esc(shiftTime(s))}</div>
        </th>
        ${weekIso.map((iso, i) => {
          const list = inWeek.filter(a => a.date === iso && a.shift === s.type);
          const we = dates[i].getDay() === 0 || dates[i].getDay() === 6;
          return `<td class="border-l border-slate-100 p-1.5 ${we ? 'bg-slate-50/70' : ''}">
            <div class="flex min-h-[64px] flex-col gap-1">
              ${list.map(a => {
                const p = personById(a.personId);
                const mine = a.personId === me;
                return `<button type="button" data-edit="${esc(a.personId)}|${a.date}" ${CAN_MANAGE ? '' : 'disabled'}
                  class="flex w-full items-center gap-1.5 rounded px-1.5 py-1 text-left ring-1 ring-inset ${s.chip} ${mine ? 'font-semibold outline outline-2 outline-brand-500' : ''} ${CAN_MANAGE ? 'hover:brightness-95' : 'cursor-default'}"
                  title="${esc(p.name)} · ${esc(p.dept)}">
                  <span class="truncate text-[11px]">${esc(p.name.split(' ')[0])}</span>
                </button>`;
              }).join('')}
              ${CAN_MANAGE ? `<button type="button" data-add="${iso}|${s.type}" class="mt-auto rounded border border-dashed border-slate-200 py-0.5 text-[11px] text-slate-400 hover:border-brand-300 hover:text-brand-700 print:hidden" aria-label="เพิ่มเวร${s.label} ${iso}">+</button>` : ''}
              ${!CAN_MANAGE && !list.length ? '<span class="m-auto text-[11px] text-slate-300">–</span>' : ''}
            </div>
          </td>`;
        }).join('')}
      </tr>`).join('');

      $('stat-total').textContent = new Set(inWeek.map(a => a.personId)).size;
      $('stat-morning').textContent = inWeek.filter(a => a.shift === 'MORNING').length;
      $('stat-afternoon').textContent = inWeek.filter(a => a.shift === 'AFTERNOON').length;
      $('stat-night').textContent = inWeek.filter(a => a.shift === 'NIGHT').length;
    }

    function prevWeek() { currentWeekOffset--; renderCalendar(); }
    function nextWeek() { currentWeekOffset++; renderCalendar(); }
    function goToday() { currentWeekOffset = 0; renderCalendar(); }

    function jumpToSpecificDate(dateStr) {
      if (!dateStr) return;
      const target = new Date(dateStr + 'T12:00:00');
      const thisMonday = getWeekDates(0)[0];
      const targetMonday = new Date(target);
      targetMonday.setDate(target.getDate() - ((target.getDay() + 6) % 7));
      currentWeekOffset = Math.round((targetMonday - thisMonday) / (7 * 864e5));
      renderCalendar();
    }

    /* ---------------- Team ---------------- */
    function renderTeam() {
      const q = $('teamSearch').value.trim().toLowerCase();
      const month = ERP.todayIso().slice(0, 7);
      const today = ERP.todayIso();
      const list = people.filter(p => !q || `${p.name} ${p.id}`.toLowerCase().includes(q));
      $('teamCount').textContent = `${fmt(list.length)} คน`;
      $('team-grid').innerHTML = list.length
        ? list.map(p => {
            const mine = assignments.filter(a => a.personId === p.id);
            const monthCount = mine.filter(a => a.date.startsWith(month)).length;
            const next = mine.filter(a => a.date >= today).sort((a, b) => a.date.localeCompare(b.date))[0];
            const nextShift = next && SHIFT_TYPES.find(s => s.type === next.shift);
            return `<tr class="hover:bg-slate-50">
              <td class="px-4 py-2.5"><div class="flex items-center gap-2.5">${ERP.avatar(p.name, p.id)}
                <div class="min-w-0"><div class="truncate font-medium text-slate-900">${esc(p.name)}</div><div class="font-mono text-2xs text-slate-400">${esc(p.id)}</div></div></div></td>
              <td class="max-w-[240px] px-3 py-2.5"><div class="truncate text-slate-600">${esc(p.dept)}</div></td>
              <td class="px-3 py-2.5 font-mono text-xs text-slate-600">${esc(p.phone ? maskSensitiveData(p.phone, 'view_phone', p.id) : '—')}</td>
              <td class="px-3 py-2.5 text-right font-mono text-xs ${monthCount ? 'text-slate-800' : 'text-slate-300'}">${monthCount || '–'}</td>
              <td class="px-4 py-2.5 text-xs">${next
                ? `<span class="erp-badge ring-1 ring-inset ${nextShift.chip}">${nextShift.label}</span> <span class="text-slate-500">${new Date(next.date + 'T12:00:00').toLocaleDateString('th-TH', { weekday: 'short', day: 'numeric', month: 'short' })}</span>`
                : '<span class="text-slate-300">–</span>'}</td>
            </tr>`;
          }).join('')
        : ERP.emptyRow(5, 'ไม่พบบุคลากร');
    }

    /* ---------------- Daily ---------------- */
    async function fetchDailyReportData() {
      const input = $('report-date-input');
      if (!input.value) input.value = ERP.todayIso();
      const date = input.value;
      const body = $('daily-report-body');
      body.innerHTML = '<tr><td colspan="7" class="px-4 py-12 text-center text-slate-400">กำลังโหลดข้อมูล…</td></tr>';
      try {
        const res = await fetch(`/api/data?date=${encodeURIComponent(date)}`, { headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error('API Error');
        const data = await res.json();
        const onDuty = new Map(assignments.filter(a => a.date === date).map(a => [a.personId, a.shift]));
        const rows = (data.employees || []).filter(e => onDuty.has(String(e.id)));
        if (!rows.length) { body.innerHTML = ERP.emptyRow(7, 'ไม่มีบุคลากรที่ลงเวรในวันที่เลือก'); return; }
        body.innerHTML = rows.map(e => {
          const [label, tone] = STATUS[e.status] || STATUS.none;
          const s = SHIFT_TYPES.find(x => x.type === onDuty.get(String(e.id)));
          const hours = Number(e.hours) || 0;
          return `<tr class="hover:bg-slate-50">
            <td class="px-4 py-2.5 font-medium text-slate-900">${esc(e.name)}</td>
            <td class="max-w-[220px] px-3 py-2.5"><div class="truncate text-xs text-slate-600">${esc(e.dept || '—')}</div></td>
            <td class="px-3 py-2.5"><span class="erp-badge ring-1 ring-inset ${s.chip}">${s.label}</span></td>
            <td class="px-3 py-2.5">${ERP.badge(label, tone)}</td>
            <td class="px-3 py-2.5 text-center font-mono text-xs">${esc(e.in ? String(e.in).slice(0, 5) : '–')}</td>
            <td class="px-3 py-2.5 text-center font-mono text-xs">${esc(e.out && e.out !== e.in ? String(e.out).slice(0, 5) : '–')}</td>
            <td class="px-4 py-2.5 text-right font-mono text-xs">${hours ? hours.toFixed(1) : '–'}</td>
          </tr>`;
        }).join('');
      } catch {
        body.innerHTML = ERP.emptyRow(7, 'เกิดข้อผิดพลาดในการโหลดข้อมูล', 'bi-exclamation-triangle');
      }
    }

    /* ---------------- Monthly ---------------- */
    let monthlyRows = [];
    async function fetchMonthlyReportData() {
      const month = $('monthly-month-input').value;
      const year = $('monthly-year-input').value;
      const body = $('monthly-report-body');
      body.innerHTML = '<tr><td colspan="6" class="px-4 py-12 text-center text-slate-400">กำลังรวบรวมข้อมูล…</td></tr>';
      try {
        const res = await fetch(`/api/report/monthly?month=${month}&year=${year}`, { headers: { Accept: 'application/json' } });
        const data = await res.json();
        if (!data.success) throw new Error(data.message);
        const ids = new Set(people.map(p => p.id));
        monthlyRows = (data.report || []).filter(r => !ids.size || ids.has(String(r.id)));
        const sum = k => monthlyRows.reduce((a, r) => a + (Number(r[k]) || 0), 0);
        $('monthly-stat-days').textContent = fmt(sum('daysPresent'));
        $('monthly-stat-late').textContent = fmt(sum('lateCount'));
        $('monthly-stat-absent').textContent = fmt(sum('absentCount'));
        $('monthly-stat-leave').textContent = fmt(sum('leaveCount'));
        if (!monthlyRows.length) { body.innerHTML = ERP.emptyRow(6, 'ไม่พบข้อมูลสรุปรายเดือน'); return; }
        const num = (v, tone) => `<td class="px-3 py-2.5 text-right font-mono text-xs ${Number(v) ? tone : 'text-slate-300'}">${Number(v) ? fmt(v) : '–'}</td>`;
        body.innerHTML = monthlyRows.map(r => `<tr class="hover:bg-slate-50">
          <td class="px-4 py-2.5 font-medium text-slate-900">${esc(r.name)}</td>
          ${num(r.daysPresent, 'text-slate-800')}
          ${num(r.lateCount, 'font-semibold text-amber-700')}
          ${num(r.absentCount, 'font-semibold text-red-600')}
          ${num(r.leaveCount, 'text-violet-700')}
          <td class="px-4 py-2.5">${ERP.badge(r.status === 'รอดำเนินการ (Overdue)' ? 'รอดำเนินการ' : r.status || 'ปกติ', r.status === 'ต้องปรับปรุง' ? 'red' : r.status && r.status !== 'ปกติ' ? 'amber' : 'green')}</td>
        </tr>`).join('');
      } catch {
        body.innerHTML = ERP.emptyRow(6, 'เกิดข้อผิดพลาดในการโหลดรายงานรายเดือน', 'bi-exclamation-triangle');
      }
    }

    /* ---------------- Tabs ---------------- */
    let currentTab = 'calendar';
    function showTab(tab) {
      currentTab = tab;
      document.querySelectorAll('#tabBar [data-tab]').forEach(b => {
        b.classList.toggle('active', b.dataset.tab === tab);
        b.setAttribute('aria-selected', String(b.dataset.tab === tab));
      });
      ['calendar', 'team', 'daily-report', 'monthly-report'].forEach(t => { $('tab-' + t).style.display = t === tab ? '' : 'none'; });
      if (tab === 'team') renderTeam();
      if (tab === 'daily-report') fetchDailyReportData();
      if (tab === 'monthly-report') fetchMonthlyReportData();
    }
    $('tabBar').addEventListener('click', e => { const b = e.target.closest('[data-tab]'); if (b) showTab(b.dataset.tab); });

    /* ---------------- Assignment drawer (admin / super) ---------------- */
    function renderShiftOptions(selected) {
      $('shiftOptions').innerHTML = SHIFT_TYPES.map(s => `
        <label class="flex cursor-pointer flex-col items-center gap-0.5 rounded-md border border-slate-200 bg-white py-2.5 text-[13px] font-medium text-slate-700 hover:border-slate-300 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 has-[:checked]:text-brand-800">
          <input type="radio" name="f-shift" value="${s.type}" class="sr-only" ${s.type === selected ? 'checked' : ''}>
          <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full ${s.dot}"></span>${s.label}</span>
          <span class="font-mono text-2xs text-slate-400">${esc(shiftTime(s))}</span>
        </label>`).join('');
    }

    function openAddEmpModal(date, shift, personId) {
      if (!CAN_MANAGE) return ERP.toast('เฉพาะผู้ดูแลระบบเท่านั้นที่จัดการตารางเวรได้');
      const existing = personId && date ? assignments.find(a => a.personId === personId && a.date === date) : null;
      editing = existing || null;
      $('shift-modal-title').textContent = existing ? 'แก้ไขเวร' : 'ลงเวร';
      $('f-person').innerHTML = people.map(p => `<option value="${esc(p.id)}">${esc(p.name)} · ${esc(p.dept)}</option>`).join('');
      $('f-person').value = personId || (people[0] && people[0].id) || '';
      $('f-person').disabled = !!existing;
      $('f-date').value = date || ERP.todayIso();
      renderShiftOptions(shift || (existing && existing.shift) || 'MORNING');
      $('btn-delete').style.display = existing ? '' : 'none';
      ERP.showOverlay($('shift-modal-overlay'), true);
    }
    const openAddSlot = date => openAddEmpModal(date);
    function closeModalDirect() { ERP.showOverlay($('shift-modal-overlay'), false); editing = null; }

    async function postShift(personId, date, shift) {
      const res = await fetch('/api/schedule', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ emp_id: personId, shift, date })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.error) throw new Error(data.error || res.status);
    }

    async function saveEmployee(e) {
      if (e) e.preventDefault();
      const personId = $('f-person').value;
      const date = $('f-date').value;
      const shift = (document.querySelector('input[name="f-shift"]:checked') || {}).value;
      if (!personId || !date || !shift) return ERP.toast('กรุณากรอกข้อมูลให้ครบ', 'error');
      const btn = $('btn-save-shift');
      btn.disabled = true;
      try {
        // Moving an existing assignment to another date clears the old slot first
        if (editing && editing.date !== date) await postShift(editing.personId, editing.date, 'EMPTY');
        await postShift(personId, date, shift);
        ERP.toast(`บันทึกเวรของ ${personById(personId).name} แล้ว`, 'success');
        closeModalDirect();
        await loadEmployees();
      } catch (err) {
        console.error(err);
        ERP.toast('บันทึกลงฐานข้อมูลไม่สำเร็จ', 'error');
      } finally {
        btn.disabled = false;
      }
    }

    async function deleteEmployee() {
      if (!editing) return;
      const p = personById(editing.personId);
      if (!confirm(`ลบเวรของ ${p ? p.name : ''} วันที่ ${editing.date} ใช่หรือไม่?`)) return;
      try {
        await postShift(editing.personId, editing.date, 'EMPTY');
        ERP.toast('ลบเวรแล้ว', 'success');
        closeModalDirect();
        await loadEmployees();
      } catch {
        ERP.toast('ลบไม่สำเร็จ', 'error');
      }
    }

    if (CAN_MANAGE) {
      $('shiftForm').addEventListener('submit', saveEmployee);
      $('week-grid').addEventListener('click', e => {
        const add = e.target.closest('[data-add]');
        const edit = e.target.closest('[data-edit]');
        if (add) { const [date, shift] = add.dataset.add.split('|'); openAddEmpModal(date, shift); }
        else if (edit) { const [personId, date] = edit.dataset.edit.split('|'); openAddEmpModal(date, null, personId); }
      });
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !$('shift-modal-overlay').classList.contains('hidden')) closeModalDirect();
      });
    }

    /* ---------------- Export ---------------- */
    function exportExcel() {
      if (typeof XLSX === 'undefined') return ERP.toast('โหลดไลบรารี Excel ไม่สำเร็จ', 'error');
      const wb = XLSX.utils.book_new();
      let sheet, name, file;
      if (currentTab === 'team') {
        sheet = XLSX.utils.aoa_to_sheet([['รหัสพนักงาน', 'ชื่อ-นามสกุล', 'กลุ่มงาน'], ...people.map(p => [p.id, p.name, p.dept])]);
        name = 'Personnel'; file = 'รายชื่อบุคลากร.xlsx';
      } else if (currentTab === 'monthly-report') {
        sheet = XLSX.utils.aoa_to_sheet([['ชื่อ-นามสกุล', 'มาทำงาน', 'มาสาย', 'ขาด', 'ลา', 'สถานะ'],
          ...monthlyRows.map(r => [r.name, r.daysPresent, r.lateCount, r.absentCount, r.leaveCount, r.status])]);
        name = 'Monthly'; file = `สรุปรายเดือน_${$('monthly-year-input').value}_${$('monthly-month-input').value}.xlsx`;
      } else if (currentTab === 'daily-report') {
        const rows = [...$('daily-report-body').querySelectorAll('tr')].filter(tr => tr.children.length > 1)
          .map(tr => [...tr.children].map(td => td.innerText.trim()));
        sheet = XLSX.utils.aoa_to_sheet([['ชื่อ-นามสกุล', 'กลุ่มงาน', 'เวร', 'สถานะ', 'เข้า', 'ออก', 'ชั่วโมง'], ...rows]);
        name = 'Daily'; file = `การลงเวลา_${$('report-date-input').value}.xlsx`;
      } else {
        const dates = getWeekDates(currentWeekOffset);
        const iso = dates.map(localIso);
        sheet = XLSX.utils.aoa_to_sheet([
          ['กะ / วันที่', ...dates.map(d => d.toLocaleDateString('th-TH', { weekday: 'short', day: '2-digit', month: '2-digit' }))],
          ...SHIFT_TYPES.map(s => [s.label, ...iso.map(day => assignments.filter(a => a.date === day && a.shift === s.type).map(a => personById(a.personId).name).join(', '))])
        ]);
        name = 'Weekly'; file = `ตารางเวร_${iso[0]}.xlsx`;
      }
      XLSX.utils.book_append_sheet(wb, sheet, name);
      XLSX.writeFile(wb, file);
    }

    $('cal-jump').value = ERP.todayIso();
    loadEmployees();
  </script>
</body>

</html>
