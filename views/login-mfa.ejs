<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ยืนยันตัวตน · KHH HRM</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="<%= asset('/css/erp.css') %>">
</head>

<body class="erp-page" style="background:#faf5ff">
  <main class="erp flex min-h-screen items-center justify-center px-4 py-10">
    <div class="w-full max-w-sm">
      <div class="mb-6 flex items-center gap-3">
        <img src="/images/LOGO%20KHH.jpg" alt="" class="h-11 w-11 rounded-md bg-white object-cover ring-1 ring-plum-100">
        <div class="leading-tight"><div class="text-sm font-semibold text-slate-900">KHH · HRM</div><div class="text-xs text-slate-500">โรงพยาบาลคลองหาด</div></div>
      </div>
      <div class="erp-panel p-6">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-plum-50 text-2xl text-plum-600"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
        <h1 class="mt-4 text-xl font-semibold text-slate-900">ยืนยันตัวตนขั้นที่ 2</h1>
        <p class="mt-1 text-[13px] text-slate-500"><%= name %> ·
          <% if (st.totp) { %>กรอกรหัส 6 หลักจากแอป Authenticator<% if (st.telegram) { %> หรือขอรหัสทาง Telegram<% } %><% } else { %>กรอกรหัส 6 หลักที่ส่งไปทาง Telegram<% } %>
        </p>

        <% if (error) { %>
          <div class="mt-4 flex items-start gap-2 rounded-md bg-red-50 px-3 py-2.5 text-[13px] text-red-700 ring-1 ring-inset ring-red-200" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-0.5" aria-hidden="true"></i><span><%= error %></span></div>
        <% } else if (sent) { %>
          <div class="mt-4 flex items-start gap-2 rounded-md bg-emerald-50 px-3 py-2.5 text-[13px] text-emerald-800 ring-1 ring-inset ring-emerald-200" role="status">
            <i class="bi bi-telegram mt-0.5" aria-hidden="true"></i><span>ส่งรหัสไปที่ Telegram แล้ว (ใช้ได้ 5 นาที)</span></div>
        <% } %>

        <form method="post" action="/login/mfa" class="mt-5 space-y-3" autocomplete="off">
          <label class="erp-label" for="code">รหัสยืนยัน</label>
          <input id="code" name="code" class="erp-input h-12 text-center font-mono text-xl tracking-[0.4em]" inputmode="numeric" autocomplete="one-time-code" maxlength="11" required autofocus placeholder="••••••">
          <button type="submit" class="erp-btn erp-btn-primary h-11 w-full"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> ยืนยันและเข้าสู่ระบบ</button>
        </form>

        <% if (st.telegram) { %>
          <form method="post" action="/login/mfa/telegram" class="mt-3">
            <button type="submit" class="erp-btn erp-btn-secondary h-10 w-full text-[13px]"><i class="bi bi-telegram" aria-hidden="true"></i> <%= sent ? 'ส่งรหัสทาง Telegram อีกครั้ง' : 'ส่งรหัสทาง Telegram' %></button>
          </form>
        <% } %>
        <details class="mt-4 text-2xs text-slate-500">
          <summary class="cursor-pointer">ใช้รหัสกู้คืน (กรณีโทรศัพท์หาย)</summary>
          <p class="mt-1">กรอกรหัสกู้คืนรูปแบบ <span class="font-mono">XXXXX-XXXXX</span> ในช่องด้านบน แต่ละรหัสใช้ได้ครั้งเดียว ถ้าไม่มีรหัสกู้คืน ติดต่อผู้ดูแลระบบอีกคน</p>
        </details>
        <a href="/login" class="mt-4 block text-center text-2xs text-slate-400 hover:text-slate-600">← เข้าสู่ระบบด้วยบัญชีอื่น</a>
      </div>
    </div>
  </main>
</body>

</html>
