<!DOCTYPE html>
<html lang="th">

<head>
  <%- include("components/erp-head", { title: "จำลอง LINE Flex" }) %>
</head>

<body class="erp-page">
  <%- include("components/sidebar") %>
  <div class="main" role="main">
    <%- include("components/topbar") %>

    <div class="erp px-4 py-5 lg:px-6">
      <section class="mb-5" aria-labelledby="flex-heading">
        <h2 id="flex-heading" class="text-xl font-semibold text-slate-900">จำลองและทดสอบ LINE Flex Message</h2>
        <p class="mt-1 text-[13px] text-slate-500">ดูตัวอย่างข้อความแจ้งเตือนการบันทึกเวลา ปรับข้อมูลทดสอบ และส่งเข้า LINE จริง</p>
      </section>

      <div class="grid grid-cols-1 items-start gap-5 xl:grid-cols-[minmax(0,1fr)_420px]">
        <!-- LEFT: controls -->
        <div class="space-y-5">
          <section class="erp-panel" aria-labelledby="presetTitle">
            <h3 id="presetTitle" class="border-b border-slate-200 px-4 py-3 text-[13px] font-semibold text-slate-800"><i class="bi bi-sliders text-brand-600" aria-hidden="true"></i> สถานะและข้อมูลทดสอบ</h3>
            <div class="space-y-4 p-4">
              <div>
                <span class="erp-label">สถานะ (Preset)</span>
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" id="presetGroup">
                  <% [['check-in','in','เข้างาน','bi-box-arrow-in-right','has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50 has-[:checked]:text-emerald-700'],
                      ['check-out','out','ออกงาน','bi-box-arrow-right','has-[:checked]:border-sky-500 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-700'],
                      ['late','late','เข้าสาย','bi-alarm','has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50 has-[:checked]:text-amber-700'],
                      ['failed','failed','สแกนไม่ผ่าน','bi-x-octagon','has-[:checked]:border-red-500 has-[:checked]:bg-red-50 has-[:checked]:text-red-700']].forEach(([value, id, label, icon, tone], i) => { %>
                    <label id="btn-preset-<%= id %>" class="flex cursor-pointer items-center justify-center gap-2 rounded-md border border-slate-200 bg-white py-2.5 text-[13px] font-medium text-slate-700 hover:border-slate-300 <%= tone %>">
                      <input type="radio" name="preset" value="<%= value %>" class="sr-only" <%= i === 0 ? 'checked' : '' %>>
                      <i class="bi <%= icon %>" aria-hidden="true"></i><%= label %>
                    </label>
                  <% }); %>
                </div>
              </div>
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-6">
                <div class="sm:col-span-4"><label class="erp-label" for="inp-name">ชื่อ-นามสกุล</label><input type="text" id="inp-name" class="erp-input" value="คุณกิตติพันธ์ ปรางศรี"></div>
                <div class="sm:col-span-2"><label class="erp-label" for="inp-empid">รหัสพนักงาน</label><input type="text" id="inp-empid" class="erp-input font-mono" value="KHH-8921"></div>
                <div class="sm:col-span-3"><label class="erp-label" for="inp-date">วันที่บันทึก</label><input type="text" id="inp-date" class="erp-input" value="20 สิงหาคม 2026"></div>
                <div class="sm:col-span-3"><label class="erp-label" for="inp-time">เวลาบันทึก</label><input type="text" id="inp-time" class="erp-input font-mono" value="08:15 น."></div>
                <div class="sm:col-span-4"><label class="erp-label" for="inp-device">จุดบันทึก / ประตูสแกน</label><input type="text" id="inp-device" class="erp-input" value="KHHin2 (ประตูหน้าหลัก)"></div>
                <div class="sm:col-span-2"><label class="erp-label" for="inp-temp">อุณหภูมิ (°C)</label><input type="text" id="inp-temp" class="erp-input font-mono" value="36.5"></div>
              </div>
            </div>
          </section>

          <section class="erp-panel" aria-labelledby="sendTitle">
            <h3 id="sendTitle" class="border-b border-slate-200 px-4 py-3 text-[13px] font-semibold text-slate-800"><i class="bi bi-send text-brand-600" aria-hidden="true"></i> ทดสอบส่งเข้า LINE จริง</h3>
            <div class="space-y-3 p-4">
              <div>
                <label class="erp-label" for="inp-line-id">LINE User ID ของผู้รับ</label>
                <input type="text" id="inp-line-id" class="erp-input font-mono" placeholder="U1234567890abcdef…">
                <p class="mt-1 text-2xs text-slate-400">เว้นว่างเพื่อใช้ <code class="font-mono">LINE_ADMIN_USER_ID</code> จากไฟล์ .env</p>
              </div>
              <button type="button" id="sendBtn" class="erp-btn erp-btn-primary w-full" onclick="sendTestLineFlex()"><i class="bi bi-send-fill" aria-hidden="true"></i> ส่ง Flex Message ทดสอบ</button>
              <div id="test-result-msg" class="hidden rounded-md px-3 py-2.5 text-[13px]" role="status"></div>
            </div>
          </section>

          <details class="erp-panel group" id="jsonDetails">
            <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-[13px] font-semibold text-slate-800">
              <span><i class="bi bi-code-slash text-brand-600" aria-hidden="true"></i> โครงสร้าง JSON (LINE Flex Payload)</span>
              <i class="bi bi-chevron-down transition-transform group-open:rotate-180" aria-hidden="true"></i>
            </summary>
            <div class="border-t border-slate-200 p-4">
              <textarea id="json-preview" class="block h-56 w-full resize-y rounded-md border-0 bg-slate-900 p-3 font-mono text-2xs text-sky-300 outline-none" readonly aria-label="JSON payload"></textarea>
              <button type="button" class="erp-btn erp-btn-secondary mt-2 w-full" onclick="copyJsonPayload()"><i class="bi bi-clipboard" aria-hidden="true"></i> คัดลอก JSON</button>
            </div>
          </details>
        </div>

        <!-- RIGHT: phone simulator -->
        <div class="xl:sticky xl:top-20">
          <div class="mx-auto w-full max-w-[380px] overflow-hidden rounded-[36px] border-[10px] border-slate-800 bg-[#7494C0] shadow-2xl">
            <div class="flex items-center justify-between bg-[#273248] px-5 py-3.5 text-sm font-semibold text-white">
              <span class="flex items-center gap-2"><i class="bi bi-chevron-left" aria-hidden="true"></i> KHH Attendance Bot</span>
              <i class="bi bi-list" aria-hidden="true"></i>
            </div>
            <div class="phone-body flex max-h-[640px] min-h-[540px] flex-col gap-3 overflow-y-auto p-4">
              <div class="text-center text-2xs text-white/70">วันนี้ <span id="clock-time">08:15</span></div>
              <div class="flex items-start gap-2.5">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-xs font-bold text-white shadow">KHH</div>
                <div class="w-full overflow-hidden rounded-2xl bg-white shadow-lg">
                  <div id="fx-header" class="px-5 py-4 text-center text-white transition-colors">
                    <div class="text-[10px] font-bold tracking-wide opacity-90">KLONG HAT HOSPITAL • ATTENDANCE LOG</div>
                    <div class="my-1 text-lg font-bold">บันทึกเวลาปฏิบัติงาน</div>
                    <div id="fx-header-tag" class="text-xs opacity-90"></div>
                  </div>
                  <div class="space-y-3.5 px-5 py-4">
                    <div class="flex items-center gap-3">
                      <div id="fx-user-circle" class="flex h-11 w-11 items-center justify-center rounded-full text-lg font-extrabold text-white"></div>
                      <div class="min-w-0">
                        <div id="fx-user-name" class="truncate text-[15px] font-bold text-slate-900"></div>
                        <div id="fx-user-id" class="text-xs text-slate-500"></div>
                      </div>
                    </div>
                    <div id="fx-status-box" class="flex items-center gap-2 rounded-xl border px-3.5 py-3 text-[13.5px] font-bold transition-colors">
                      <i id="fx-status-icon" class="bi" aria-hidden="true"></i><span id="fx-status-title"></span>
                    </div>
                    <dl class="m-0 space-y-2 rounded-xl bg-slate-50 px-3.5 py-3 text-[12.5px]">
                      <div class="flex justify-between gap-3"><dt class="text-slate-500">📅 วันที่</dt><dd id="fx-val-date" class="m-0 text-right font-bold text-slate-800"></dd></div>
                      <div class="flex justify-between gap-3"><dt class="text-slate-500">⏰ เวลาบันทึก</dt><dd id="fx-val-time" class="m-0 text-right font-bold text-slate-800"></dd></div>
                      <div class="flex justify-between gap-3"><dt class="text-slate-500">🚪 จุดบันทึก</dt><dd id="fx-val-device" class="m-0 text-right font-bold text-slate-800"></dd></div>
                      <div class="flex justify-between gap-3" id="fx-temp-row"><dt class="text-slate-500">🌡️ อุณหภูมิ</dt><dd id="fx-val-temp" class="m-0 text-right font-bold text-slate-800"></dd></div>
                    </dl>
                  </div>
                  <div class="space-y-2 px-4 pb-4">
                    <button type="button" id="fx-btn-primary" class="w-full rounded-lg py-2.5 text-[13px] font-bold text-white" onclick="simulateButtonClick('history')">📋 ดูประวัติการเข้างาน</button>
                    <button type="button" class="w-full rounded-lg border border-slate-300 bg-slate-50 py-2.5 text-[13px] font-semibold text-slate-600" onclick="simulateButtonClick('excuse')">📝 ยื่นใบลา / แจ้งเหตุสาย</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="mt-3 text-center text-2xs text-slate-400">กดปุ่มในข้อความเพื่อจำลองการตอบกลับของบอท</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const PRESETS = {
      'check-in': { headerBg: '#0D9488', headerTag: '[ ENTER • เข้างาน ]', badgeBg: '#ECFDF5', badgeBorder: '#A7F3D0', badgeTextColor: '#047857', badgeIcon: 'bi-check-circle-fill', statusTitle: 'สแกนเข้างาน (Check-In)' },
      'check-out': { headerBg: '#0284C7', headerTag: '[ EXIT • ออกงาน ]', badgeBg: '#F0F9FF', badgeBorder: '#BAE6FD', badgeTextColor: '#0369A1', badgeIcon: 'bi-box-arrow-right', statusTitle: 'สแกนออกงาน (Check-Out)' },
      late: { headerBg: '#D97706', headerTag: '[ LATE • เข้างานสาย ]', badgeBg: '#FFFBEB', badgeBorder: '#FDE68A', badgeTextColor: '#B45309', badgeIcon: 'bi-alarm-fill', statusTitle: 'เข้างานสาย (Late Arrival)' },
      failed: { headerBg: '#E11D48', headerTag: '[ FAILED • ไม่ผ่าน ]', badgeBg: '#FEF2F2', badgeBorder: '#FECDD3', badgeTextColor: '#BE123C', badgeIcon: 'bi-x-octagon-fill', statusTitle: 'สแกนไม่ผ่าน (Scan Failed)' }
    };
    const $ = id => document.getElementById(id);
    const esc = ERP.escapeHtml;
    let currentPreset = 'check-in';

    function selectPreset(preset) {
      currentPreset = PRESETS[preset] ? preset : 'check-in';
      const radio = document.querySelector(`input[name="preset"][value="${currentPreset}"]`);
      if (radio) radio.checked = true;
      updatePreview();
    }

    function updatePreview() {
      const p = PRESETS[currentPreset];
      const name = $('inp-name').value || 'ไม่ระบุชื่อ';
      const empid = $('inp-empid').value;
      const date = $('inp-date').value || 'วันนี้';
      const time = $('inp-time').value || '-';
      const device = $('inp-device').value || 'ไม่ระบุ';
      const temp = $('inp-temp').value.trim();

      $('fx-header').style.backgroundColor = p.headerBg;
      $('fx-header-tag').textContent = p.headerTag;
      $('fx-user-circle').style.backgroundColor = p.headerBg;
      $('fx-user-circle').textContent = name.trim().charAt(0).toUpperCase();
      $('fx-user-name').textContent = name;
      $('fx-user-id').textContent = empid ? `ID: ${empid}` : 'บุคลากรโรงพยาบาล';
      const box = $('fx-status-box');
      box.style.backgroundColor = p.badgeBg;
      box.style.borderColor = p.badgeBorder;
      box.style.color = p.badgeTextColor;
      $('fx-status-icon').className = 'bi ' + p.badgeIcon;
      $('fx-status-title').textContent = p.statusTitle;
      $('fx-val-date').textContent = date;
      $('fx-val-time').textContent = time;
      $('fx-val-device').textContent = device;
      $('fx-temp-row').style.display = temp ? 'flex' : 'none';
      $('fx-val-temp').textContent = `${temp} °C`;
      $('fx-btn-primary').style.backgroundColor = p.headerBg;
      $('clock-time').textContent = time.replace(' น.', '');
      updateJsonTextArea(name, p);
    }

    function updateJsonTextArea(name, p) {
      const json = {
        type: 'bubble',
        size: 'mega',
        header: {
          type: 'box', layout: 'vertical', backgroundColor: p.headerBg,
          contents: [
            { type: 'text', text: 'KLONG HAT HOSPITAL • ATTENDANCE LOG', color: '#FFFFFF', size: 'xxs', weight: 'bold', align: 'center' },
            { type: 'text', text: 'บันทึกเวลาปฏิบัติงาน', color: '#FFFFFF', size: 'xl', weight: 'bold', margin: 'xs', align: 'center' }
          ]
        },
        body: {
          type: 'box', layout: 'vertical',
          contents: [
            { type: 'text', text: name, weight: 'bold', size: 'md', color: '#0F172A' },
            { type: 'text', text: p.statusTitle, color: p.badgeTextColor, weight: 'bold', size: 'sm' }
          ]
        }
      };
      $('json-preview').value = JSON.stringify(json, null, 2);
    }

    async function copyJsonPayload() {
      try {
        await navigator.clipboard.writeText($('json-preview').value);
        ERP.toast('คัดลอก JSON แล้ว', 'success');
      } catch {
        ERP.toast('คัดลอกไม่สำเร็จ', 'error');
      }
    }

    function showResult(kind, message) {
      const el = $('test-result-msg');
      const tone = { info: 'bg-sky-50 text-sky-800 ring-sky-200', success: 'bg-emerald-50 text-emerald-800 ring-emerald-200', error: 'bg-red-50 text-red-800 ring-red-200' }[kind];
      const icon = { info: 'bi-hourglass-split', success: 'bi-check-circle-fill', error: 'bi-exclamation-triangle-fill' }[kind];
      el.className = `rounded-md px-3 py-2.5 text-[13px] ring-1 ring-inset ${tone}`;
      el.innerHTML = `<i class="bi ${icon}"></i> ${esc(message)}`;
    }

    async function sendTestLineFlex() {
      const btn = $('sendBtn');
      btn.disabled = true;
      showResult('info', 'กำลังส่ง Flex Message ทดสอบ…');
      try {
        const res = await fetch('/api/users/test-line-flex', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            lineUserId: $('inp-line-id').value.trim(),
            statusType: currentPreset,
            fullname: $('inp-name').value,
            employeeId: $('inp-empid').value,
            deviceName: $('inp-device').value
          })
        });
        const data = await res.json();
        if (data.success) showResult('success', data.message || 'ส่ง Flex Message สำเร็จ');
        else showResult('error', data.error || 'ไม่สามารถส่งข้อความได้');
      } catch {
        showResult('error', 'เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์');
      } finally {
        btn.disabled = false;
      }
    }

    function simulateButtonClick(type) {
      const body = document.querySelector('.phone-body');
      const old = $('sim-reply-msg');
      if (old) old.remove();
      const reply = document.createElement('div');
      reply.id = 'sim-reply-msg';
      reply.className = 'ml-[46px] rounded-2xl border-l-4 bg-white px-4 py-3 text-xs text-slate-800 shadow-md ' + (type === 'history' ? 'border-teal-600' : 'border-amber-500');
      const name = esc($('inp-name').value || 'ไม่ระบุชื่อ');
      const time = esc($('inp-time').value || '-');
      reply.innerHTML = type === 'history'
        ? `<div class="mb-1 font-bold text-teal-700"><i class="bi bi-chat-left-dots-fill"></i> บอทตอบกลับการสแกนวันนี้</div>
           <div class="text-[11.5px] text-slate-600">📊 <b>รายการสแกนสำเร็จวันนี้</b><br>👤 ${name} – ⏰ ${time}<br><i>(ระบบจริงดึงประวัติสแกนจากฐานข้อมูล)</i></div>`
        : `<div class="mb-1 font-bold text-amber-700"><i class="bi bi-chat-left-dots-fill"></i> บอทตอบกลับการยื่นใบลา</div>
           <div class="text-[11.5px] text-slate-600">📝 <b>ระบบแจ้งสาเหตุการลงเวลา / ยื่นใบลา</b><br>ยื่นใบลาหรือแจ้งเหตุผลเข้างานสายได้ที่ระบบออนไลน์<br>
           <a href="/excuses" target="_blank" rel="noopener" class="font-bold text-sky-700">🔗 ยื่นใบลาออนไลน์ (/excuses)</a></div>`;
      body.appendChild(reply);
      body.scrollTop = body.scrollHeight;
    }

    $('presetGroup').addEventListener('change', e => { if (e.target.name === 'preset') selectPreset(e.target.value); });
    ['inp-name', 'inp-empid', 'inp-date', 'inp-time', 'inp-device', 'inp-temp'].forEach(id => $(id).addEventListener('input', updatePreview));
    updatePreview();
  </script>
</body>

</html>
