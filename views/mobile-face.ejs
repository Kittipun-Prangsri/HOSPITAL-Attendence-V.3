<!DOCTYPE html>
<html lang="th">

<head>
  <%- include("components/erp-head", { title: "สแกนใบหน้า" }) %>
  <meta name="theme-color" content="#581c87" />
  <script charset="utf-8" src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
  <style>
    .face-stage { position: relative; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 28px; background: #1e1b4b; }
    .face-stage video, .face-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
    .face-oval { position: absolute; left: 50%; top: 46%; width: 62%; aspect-ratio: 3 / 4; transform: translate(-50%, -50%);
      border-radius: 50%; box-shadow: 0 0 0 9999px rgba(30, 27, 75, .55); border: 4px solid rgba(255,255,255,.5); transition: border-color .2s; }
    .face-oval.ok { border-color: #34d399; }
    .face-oval.warn { border-color: #fbbf24; }
  </style>
</head>

<body class="erp-page" style="background:#faf5ff">
  <div class="erp mx-auto min-h-screen max-w-md px-4 pb-10 pt-4">
    <header class="mb-4 flex items-center gap-3">
      <img src="/images/LOGO KHH.jpg" alt="" class="h-11 w-11 rounded-xl bg-white object-contain p-1 shadow-sm ring-1 ring-plum-100">
      <div>
        <div class="text-[15px] font-semibold text-plum-900">สแกนใบหน้า · KHH HRM</div>
        <div class="text-2xs text-slate-500">โรงพยาบาลคลองหาด</div>
      </div>
    </header>

    <!-- Loading -->
    <section id="v-loading" class="erp-panel p-8 text-center text-sm text-slate-500">
      <i class="bi bi-arrow-repeat inline-block animate-spin text-2xl text-plum-500" aria-hidden="true"></i>
      <p class="mt-2" id="loadingText">กำลังเตรียมระบบ…</p>
    </section>

    <!-- First visit from a LINE account that is not linked yet: sign in once to link it -->
    <section id="v-link" class="erp-panel hidden p-5">
      <h2 class="text-[15px] font-semibold text-plum-900"><i class="bi bi-link-45deg" aria-hidden="true"></i> ผูกบัญชี LINE กับระบบ</h2>
      <p class="mt-1 text-[13px] text-slate-600">ครั้งแรกเท่านั้น: เข้าสู่ระบบด้วยรหัสเดียวกับเว็บ KHH HRM ระบบจะผูก LINE นี้กับข้อมูลบุคลากรของท่านให้อัตโนมัติ</p>
      <form id="linkForm" class="mt-4 space-y-3">
        <label class="block text-xs font-medium text-slate-700">เลขบัตรประชาชน หรือรหัสพนักงาน
          <input id="linkUser" class="erp-input mt-1 h-11" autocomplete="username" inputmode="text" required maxlength="50"></label>
        <label class="block text-xs font-medium text-slate-700">รหัสผ่าน
          <input id="linkPass" type="password" class="erp-input mt-1 h-11" autocomplete="current-password" required maxlength="200"></label>
        <button type="submit" id="linkBtn" class="erp-btn erp-btn-primary h-12 w-full text-[15px]"><i class="bi bi-link" aria-hidden="true"></i> ผูกบัญชีและเข้าสู่ระบบ</button>
      </form>
      <p class="mt-3 text-2xs leading-relaxed text-slate-500">ลืมรหัสผ่าน หรือยังไม่มีรหัส? แจ้ง HR / IT พร้อมไอดีนี้: <code id="linkLineId" class="select-all font-mono"></code></p>
    </section>

    <!-- Not linked / errors -->
    <section id="v-error" class="erp-panel hidden p-6">
      <div class="flex items-start gap-3">
        <i class="bi bi-exclamation-triangle-fill text-xl text-amber-500" aria-hidden="true"></i>
        <div class="min-w-0">
          <p class="text-sm font-medium text-slate-800" id="errorText"></p>
          <div id="lineIdBox" class="mt-3 hidden">
            <div class="text-2xs text-slate-500">LINE User ID ของท่าน</div>
            <div class="mt-1 flex items-center gap-2">
              <code id="lineIdText" class="block min-w-0 flex-1 truncate rounded-lg bg-slate-100 px-2 py-1.5 font-mono text-xs"></code>
              <button type="button" class="erp-btn erp-btn-secondary h-8" onclick="copyLineId()"><i class="bi bi-clipboard" aria-hidden="true"></i> คัดลอก</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tabs: scan | my month -->
    <nav id="mobileTabs" class="mb-4 hidden grid-cols-2 gap-1 rounded-xl bg-white p-1 shadow-sm ring-1 ring-plum-100" aria-label="เมนู">
      <button type="button" data-mtab="main" class="rounded-lg py-2 text-[14px] font-semibold"><i class="bi bi-person-bounding-box" aria-hidden="true"></i> สแกนลงเวลา</button>
      <button type="button" data-mtab="month" class="rounded-lg py-2 text-[14px] font-semibold"><i class="bi bi-calendar3" aria-hidden="true"></i> เดือนนี้ของฉัน</button>
    </nav>

    <!-- My month -->
    <section id="v-month" class="hidden space-y-4">
      <div class="erp-panel p-4">
        <div class="flex items-center justify-between">
          <button type="button" id="mPrev" class="erp-icon-btn h-9 w-9" aria-label="เดือนก่อน"><i class="bi bi-chevron-left"></i></button>
          <h2 id="mTitle" class="text-[15px] font-semibold text-plum-900">—</h2>
          <button type="button" id="mNext" class="erp-icon-btn h-9 w-9" aria-label="เดือนถัดไป"><i class="bi bi-chevron-right"></i></button>
        </div>
        <div id="mTotals" class="mt-3 grid grid-cols-4 gap-2 text-center"></div>
        <div class="mt-3 grid grid-cols-7 gap-1 text-center text-2xs font-medium text-slate-400"><span>อา</span><span>จ</span><span>อ</span><span>พ</span><span>พฤ</span><span>ศ</span><span>ส</span></div>
        <div id="mGrid" class="mt-1 grid grid-cols-7 gap-1"></div>
        <div class="mt-3 flex flex-wrap justify-center gap-x-3 gap-y-1 text-2xs text-slate-500">
          <span><i class="bi bi-circle-fill text-emerald-400"></i> มา</span><span><i class="bi bi-circle-fill text-amber-400"></i> สาย</span>
          <span><i class="bi bi-circle-fill text-red-400"></i> ขาด</span><span><i class="bi bi-circle-fill text-sky-400"></i> ลา</span><span><i class="bi bi-circle-fill text-slate-200"></i> วันหยุด</span>
        </div>
      </div>
      <div id="mDetail" class="erp-panel hidden p-4"></div>
    </section>

    <!-- Status + consent -->
    <section id="v-main" class="hidden space-y-4">
      <div class="erp-panel p-5">
        <div class="text-2xs text-slate-500">ผู้ใช้งาน</div>
        <div class="text-base font-semibold text-slate-900" id="personName">—</div>
        <div class="font-mono text-2xs text-slate-400" id="personId"></div>
        <div id="statusBox" class="mt-4"></div>
      </div>

      <div id="scanBox" class="erp-panel hidden p-5">
        <h2 class="text-[15px] font-semibold text-plum-900"><i class="bi bi-geo-alt" aria-hidden="true"></i> สแกนลงเวลา</h2>
        <div class="mt-3 grid grid-cols-2 gap-3">
          <button type="button" class="flex h-28 flex-col items-center justify-center gap-1 rounded-2xl bg-gradient-to-br from-emerald-400 to-emerald-600 text-white shadow-lg shadow-emerald-200 active:scale-95" onclick="startScan('in')">
            <i class="bi bi-box-arrow-in-right text-3xl" aria-hidden="true"></i><span class="text-[17px] font-semibold">เข้างาน</span></button>
          <button type="button" class="flex h-28 flex-col items-center justify-center gap-1 rounded-2xl bg-gradient-to-br from-plum-500 to-plum-700 text-white shadow-lg shadow-plum-200 active:scale-95" onclick="startScan('out')">
            <i class="bi bi-box-arrow-right text-3xl" aria-hidden="true"></i><span class="text-[17px] font-semibold">ออกงาน</span></button>
        </div>
        <div id="todayList" class="mt-4"></div>
      </div>

      <div id="consentBox" class="erp-panel hidden p-5">
        <h2 class="text-[15px] font-semibold text-plum-900"><i class="bi bi-shield-lock" aria-hidden="true"></i> ความยินยอมการใช้ข้อมูลใบหน้า</h2>
        <div id="consentText" class="mt-3 max-h-64 space-y-2 overflow-auto rounded-lg bg-slate-50 p-3 text-[13px] leading-relaxed text-slate-700"></div>
        <label class="mt-3 flex items-start gap-2 text-[13px] text-slate-800">
          <input type="checkbox" id="consentCheck" class="mt-0.5 h-5 w-5 accent-pink-600">
          <span>ข้าพเจ้าได้อ่านและยินยอมให้โรงพยาบาลเก็บและใช้ข้อมูลใบหน้าตามที่ระบุข้างต้น</span>
        </label>
        <button type="button" id="startBtn" class="erp-btn erp-btn-primary mt-4 h-12 w-full text-[15px]" disabled onclick="startCamera()">
          <i class="bi bi-camera" aria-hidden="true"></i> เริ่มถ่ายภาพลงทะเบียน
        </button>
      </div>

      <div id="actionsBox" class="hidden space-y-2"></div>
    </section>

    <!-- Scan result -->
    <section id="v-result" class="hidden space-y-4">
      <div class="erp-panel p-6 text-center">
        <div id="resultIcon" class="mx-auto grid h-20 w-20 place-items-center rounded-full text-4xl"></div>
        <h2 id="resultTitle" class="mt-3 text-lg font-semibold text-slate-900"></h2>
        <p id="resultText" class="mt-1 text-[13px] text-slate-600"></p>
        <p id="resultPlace" class="mt-3 text-2xs text-slate-400"></p>
      </div>
      <button type="button" class="erp-btn erp-btn-secondary h-12 w-full" onclick="loadStatus()"><i class="bi bi-arrow-left" aria-hidden="true"></i> กลับ</button>
    </section>

    <!-- Camera -->
    <section id="v-camera" class="hidden space-y-3">
      <div class="face-stage">
        <video id="video" playsinline muted autoplay></video>
        <div id="oval" class="face-oval"></div>
        <div id="turnArrow" class="absolute top-1/2 hidden -translate-y-1/2 text-7xl text-white drop-shadow-lg"></div>
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 pt-10 text-center">
          <p id="hint" class="text-[15px] font-semibold text-white">กำลังเปิดกล้อง…</p>
          <p id="subhint" class="mt-0.5 text-xs text-white/80"></p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <button type="button" class="erp-btn erp-btn-secondary h-11" onclick="stopCamera(true)"><i class="bi bi-x-lg" aria-hidden="true"></i> ยกเลิก</button>
        <button type="button" id="manualBtn" class="erp-btn erp-btn-secondary h-11 hidden" onclick="capture()"><i class="bi bi-camera" aria-hidden="true"></i> ถ่ายภาพเอง</button>
      </div>
      <p id="camNote" class="text-center text-2xs text-slate-500">ถอดหน้ากาก/แว่นกันแดด · อยู่ในที่แสงสว่าง · ให้ใบหน้าอยู่ในกรอบ</p>
    </section>
  </div>

  <script>
    const LIFF_ID = <%- JSON.stringify(liffId || '') %>;
    // ?tab=month opens "เดือนนี้ของฉัน" (LIFF forwards it either as-is or inside liff.state)
    const START_TAB = (() => {
      const q = new URLSearchParams(location.search);
      const st = q.get('liff.state');
      return q.get('tab') || (st ? new URLSearchParams(st.replace(/^[^?]*\?/, '')).get('tab') : null);
    })();
    let startTabUsed = false;
    const SIGNED_IN = <%- JSON.stringify(Boolean(locals.user)) %>;
    const $ = id => document.getElementById(id);
    const esc = ERP.escapeHtml;
    let me = null;

    function show(view) {
      ['loading', 'error', 'main', 'camera', 'result', 'month', 'link'].forEach(v => $('v-' + v).classList.toggle('hidden', v !== view));
      // Tabs only on the two top-level screens
      const tabs = view === 'main' || view === 'month';
      $('mobileTabs').classList.toggle('hidden', !tabs);
      $('mobileTabs').classList.toggle('grid', tabs);
      document.querySelectorAll('[data-mtab]').forEach(b => {
        const on = b.dataset.mtab === view;
        b.className = 'rounded-lg py-2 text-[14px] font-semibold ' + (on ? 'bg-plum-600 text-white' : 'text-slate-600');
      });
    }
    function fail(message, lineUserId) {
      $('errorText').textContent = message;
      $('lineIdBox').classList.toggle('hidden', !lineUserId);
      if (lineUserId) $('lineIdText').textContent = lineUserId;
      show('error');
    }
    function copyLineId() {
      navigator.clipboard.writeText($('lineIdText').textContent).then(() => ERP.toast('คัดลอกแล้ว', 'success'));
    }
    async function api(url, opts) {
      const res = await fetch(url, Object.assign({ headers: { Accept: 'application/json', 'Content-Type': 'application/json' } }, opts));
      const data = await res.json().catch(() => ({}));
      if (!res.ok || data.success === false) { const e = new Error(data.error || `HTTP ${res.status}`); e.data = data; throw e; }
      return data;
    }

    /* ---------- Sign in: session, else LIFF ID token (verified by the server with LINE) ---------- */
    async function boot() {
      if (!SIGNED_IN) {
        if (!LIFF_ID || typeof liff === 'undefined') { location.href = '/login'; return; }
        $('loadingText').textContent = 'กำลังยืนยันตัวตนผ่าน LINE…';
        try {
          await liff.init({ liffId: LIFF_ID });
          if (!liff.isLoggedIn()) { liff.login({ redirectUri: location.href }); return; }
          await api('/api/liff/login', { method: 'POST', body: JSON.stringify({ idToken: liff.getIDToken() }) });
          location.reload();
        } catch (err) {
          if (err.data && err.data.notLinked) {
            $('linkLineId').textContent = err.data.lineUserId || '';
            return show('link');
          }
          fail(err.message, err.data && err.data.lineUserId);
        }
        return;
      }
      await loadStatus();
    }

    const STATUS = {
      pending: ['bg-amber-50 text-amber-800 ring-amber-200', 'bi-hourglass-split', 'รอผู้ดูแลระบบอนุมัติใบหน้า'],
      approved: ['bg-emerald-50 text-emerald-800 ring-emerald-200', 'bi-patch-check-fill', 'ลงทะเบียนใบหน้าแล้ว'],
      rejected: ['bg-red-50 text-red-700 ring-red-200', 'bi-x-octagon', 'ไม่ผ่านการอนุมัติ']
    };

    async function loadStatus() {
      try {
        me = await api('/api/face/me');
      } catch (err) { return fail(err.message); }
      $('personName').textContent = me.person ? me.person.fullname : '—';
      $('personId').textContent = me.person && me.person.employeeId ? `รหัสเครื่องสแกน ${me.person.employeeId}` : 'ยังไม่มีรหัสเครื่องสแกน (FINGLE_ID)';
      $('consentText').innerHTML = me.consent.text.map(p => `<p>${esc(p)}</p>`).join('');

      const latest = me.latest;
      const approved = me.approved;
      const pill = s => `<div class="flex items-start gap-2 rounded-xl p-3 text-[13px] ring-1 ring-inset ${STATUS[s.status][0]}">
          <i class="bi ${STATUS[s.status][1]} text-base" aria-hidden="true"></i>
          <div><div class="font-semibold">${STATUS[s.status][2]}</div>
          <div class="text-2xs opacity-80">ส่งเมื่อ ${new Date(s.createdAt).toLocaleString('th-TH')}</div>
          ${s.reviewNote ? `<div class="mt-1 text-xs">หมายเหตุ: ${esc(s.reviewNote)}</div>` : ''}</div></div>`;

      let html = '';
      if (approved) html += pill(approved);
      if (latest && latest.status !== 'approved') html += `<div class="${approved ? 'mt-2' : ''}">${pill(latest)}</div>`;
      if (!latest) html = '<div class="rounded-xl bg-slate-50 p-3 text-[13px] text-slate-600 ring-1 ring-inset ring-slate-200">ยังไม่ได้ลงทะเบียนใบหน้า</div>';
      if (!me.ready) html += '<div class="mt-2 rounded-xl bg-red-50 p-3 text-xs text-red-700 ring-1 ring-inset ring-red-200">ระบบยังไม่พร้อมรับลงทะเบียน (ผู้ดูแลยังไม่ได้ตั้งค่ากุญแจเข้ารหัส)</div>';
      $('statusBox').innerHTML = html;

      // Consent + camera when there is nothing waiting for review
      const canEnroll = me.ready && me.person && me.person.employeeId && !(latest && latest.status === 'pending');
      // Already approved: re-enrolment stays behind a button so the scan buttons are what people see first
      $('consentBox').classList.toggle('hidden', !canEnroll || Boolean(approved));
      $('startBtn').innerHTML = approved
        ? '<i class="bi bi-arrow-repeat" aria-hidden="true"></i> ลงทะเบียนใบหน้าใหม่'
        : '<i class="bi bi-camera" aria-hidden="true"></i> เริ่มถ่ายภาพลงทะเบียน';

      $('scanBox').classList.toggle('hidden', !(approved && me.scanEnabled));
      const STAT = { accepted: ['text-emerald-600', 'bi-check-circle-fill', 'บันทึกแล้ว'], pending: ['text-amber-600', 'bi-hourglass-split', 'รอตรวจ'], rejected: ['text-red-600', 'bi-x-circle-fill', 'ไม่ผ่าน'] };
      $('todayList').innerHTML = (me.todayScans || []).length
        ? '<div class="mb-1 text-2xs font-medium text-slate-500">วันนี้</div>' + me.todayScans.map(s => `<div class="flex items-center gap-2 border-t border-slate-100 py-2 text-[13px]">
            <span class="w-12 font-mono text-slate-800">${esc(s.time)}</span><span class="text-slate-600">${s.direction === 'in' ? 'เข้างาน' : 'ออกงาน'}</span>
            <span class="ml-auto ${STAT[s.status][0]}"><i class="bi ${STAT[s.status][1]}" aria-hidden="true"></i> ${STAT[s.status][2]}</span></div>`).join('')
        : '';
      const actions = [];
      if (approved && !me.scanEnabled) {
        actions.push('<div class="erp-panel p-4 text-center text-[13px] text-slate-600"><i class="bi bi-geo-alt" aria-hidden="true"></i> ผู้ดูแลระบบยังไม่เปิดให้สแกนลงเวลาผ่านมือถือ</div>');
      }
      if (canEnroll && approved) {
        actions.push('<button type="button" class="erp-btn erp-btn-secondary h-11 w-full" onclick="document.getElementById(\'consentBox\').classList.remove(\'hidden\'); this.remove()"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> ลงทะเบียนใบหน้าใหม่</button>');
      }
      if (latest || approved) {
        actions.push('<button type="button" class="erp-btn h-11 w-full border border-red-200 bg-white text-red-600" onclick="withdraw()"><i class="bi bi-shield-x" aria-hidden="true"></i> ถอนความยินยอมและลบข้อมูลใบหน้า</button>');
      }
      actions.unshift(await renderChannels());
      $('actionsBox').innerHTML = actions.join('');
      $('actionsBox').classList.toggle('hidden', !actions.length);
      show('main');
      if (START_TAB === 'month' && !startTabUsed) { startTabUsed = true; loadMonth(); }
    }

    $('consentCheck').addEventListener('change', e => { $('startBtn').disabled = !e.target.checked; });

    /* Link this LINE account: the server checks the LINE ID token AND the HOSoffice password */
    $('linkForm').addEventListener('submit', async e => {
      e.preventDefault();
      $('linkBtn').disabled = true;
      try {
        await api('/api/liff/link', { method: 'POST', body: JSON.stringify({ idToken: liff.getIDToken(), username: $('linkUser').value.trim(), password: $('linkPass').value }) });
        ERP.toast('ผูกบัญชี LINE เรียบร้อยแล้ว', 'success');
        location.reload();
      } catch (err) {
        ERP.toast(err.message, 'error');
        $('linkPass').value = '';
      } finally { $('linkBtn').disabled = false; }
    });

    /* Notification channels card: LINE status + one-tap Telegram linking */
    async function renderChannels() {
      let l;
      try { l = await api('/api/me/links'); } catch (err) { return ''; }
      const row = (icon, name, val, action) => `<div class="flex items-center gap-3 py-2">
          <i class="bi ${icon} text-xl ${val ? 'text-emerald-600' : 'text-slate-300'}" aria-hidden="true"></i>
          <div class="min-w-0 flex-1"><div class="text-[13px] font-medium text-slate-800">${name}</div>
            <div class="text-2xs ${val ? 'text-emerald-700' : 'text-slate-400'}">${val ? 'เชื่อมแล้ว · ' + esc(val) : 'ยังไม่เชื่อม'}</div></div>${action || ''}</div>`;
      const tgAction = !l.telegramReady ? '' : l.telegram
        ? '<button type="button" class="text-2xs text-slate-400 underline" onclick="unlinkTelegram()">ยกเลิก</button>'
        : '<button type="button" class="erp-btn erp-btn-primary h-9 px-3 text-xs" onclick="connectTelegram()"><i class="bi bi-telegram"></i> เชื่อม</button>';
      return `<div class="erp-panel p-4"><h2 class="mb-1 text-[14px] font-semibold text-plum-900"><i class="bi bi-bell" aria-hidden="true"></i> ช่องทางแจ้งเตือน</h2>
        ${row('bi-line', 'LINE', l.line)}${row('bi-telegram', 'Telegram (รับการ์ดสแกนทุกครั้ง)', l.telegram, tgAction)}</div>`;
    }
    async function connectTelegram() {
      try {
        const { url } = await api('/api/me/links/telegram', { method: 'POST', body: '{}' });
        // Inside LINE, open Telegram outside the in-app browser
        let inLine = false;
        try { inLine = typeof liff !== 'undefined' && liff.isInClient(); } catch (e) { inLine = false; }
        if (inLine) liff.openWindow({ url, external: true });
        else window.location.href = url;
        ERP.toast('กด Start ในแอป Telegram เพื่อเชื่อม (ลิงก์ใช้ได้ 10 นาที) แล้วกลับมาหน้านี้', 'success');
      } catch (err) { ERP.toast(err.message, 'error'); }
    }
    async function unlinkTelegram() {
      if (!confirm('ยกเลิกการรับแจ้งเตือนทาง Telegram?')) return;
      try { ERP.toast((await api('/api/me/links/telegram', { method: 'DELETE' })).message, 'success'); loadStatus(); }
      catch (err) { ERP.toast(err.message, 'error'); }
    }

    async function withdraw() {
      if (!confirm('ถอนความยินยอม? ระบบจะลบข้อมูลใบหน้าของท่านทั้งหมดทันที และจะสแกนผ่านมือถือไม่ได้จนกว่าจะลงทะเบียนใหม่')) return;
      try { ERP.toast((await api('/api/face/revoke', { method: 'POST', body: '{}' })).message, 'success'); loadStatus(); }
      catch (err) { ERP.toast(err.message, 'error'); }
    }

    /* ---------- Camera + on-device guidance (the server re-checks everything itself) ---------- */
    let stream = null, human = null, running = false, busy = false;
    let mode = 'enroll', stage = 'front', goodSince = 0, blinkAt = 0, stageAt = 0;
    let scan = null; // { direction, token, action, fix, front }

    async function loadHuman() {
      if (human) return human;
      const { Human } = await import('/vendor/human/human.esm.js');
      human = new Human({
        backend: 'webgl',
        modelBasePath: '/vendor/human/models/',
        wasmPath: '/vendor/tfjs-wasm/',
        debug: false,
        // Only what guidance needs; recognition (faceres) runs on the server
        face: { enabled: true, detector: { rotation: false, maxDetected: 2, return: false }, mesh: { enabled: true },
                iris: { enabled: true }, description: { enabled: false }, emotion: { enabled: false },
                antispoof: { enabled: false }, liveness: { enabled: false } },
        body: { enabled: false }, hand: { enabled: false }, object: { enabled: false },
        gesture: { enabled: true }, segmentation: { enabled: false }, filter: { enabled: true, flip: false }
      });
      await human.load();
      return human;
    }

    async function openCamera() {
      show('camera');
      setGuide('', 'กำลังเปิดกล้อง…');
      $('manualBtn').classList.add('hidden');
      $('turnArrow').classList.add('hidden');
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: { ideal: 720 }, height: { ideal: 960 } }, audio: false });
      } catch (err) {
        stopCamera(false);
        fail('เปิดกล้องไม่ได้ กรุณาอนุญาตการใช้กล้องให้ LINE / เบราว์เซอร์ แล้วลองใหม่');
        return false;
      }
      const video = $('video');
      video.srcObject = stream;
      await video.play().catch(() => {});
      running = true; goodSince = 0; blinkAt = 0; stageAt = Date.now();
      // Old phones: offer manual capture if guidance is slow (the server still validates every photo)
      setTimeout(() => { if (running) $('manualBtn').classList.remove('hidden'); }, 10000);
      setGuide('', 'กำลังโหลดระบบตรวจใบหน้า…');
      try { await loadHuman(); loop(); }
      catch (err) {
        console.warn('face model unavailable', err);
        setGuide('', mode === 'scan' && stage === 'turn' ? turnText() : 'ให้ใบหน้าอยู่ในกรอบ แล้วกด "ถ่ายภาพเอง"');
        $('manualBtn').classList.remove('hidden');
      }
      return true;
    }

    async function startCamera() {
      if (!$('consentCheck').checked) return;
      mode = 'enroll'; stage = 'front';
      $('camNote').textContent = 'ถอดหน้ากาก/แว่นกันแดด · อยู่ในที่แสงสว่าง · ให้ใบหน้าอยู่ในกรอบ แล้วกะพริบตา 1 ครั้ง';
      await openCamera();
    }

    function stopCamera(backToMain) {
      running = false;
      if (stream) stream.getTracks().forEach(t => t.stop());
      stream = null;
      if (backToMain) show('main');
    }

    function setGuide(state, hint, sub) {
      $('oval').className = 'face-oval ' + state;
      $('hint').textContent = hint;
      $('subhint').textContent = sub || '';
    }
    const turnText = () => `หันหน้าไปทาง${scan.action === 'left' ? 'ซ้าย' : 'ขวา'}ช้า ๆ`;

    /* GPS: a fix is optional (no fix → the scan goes to review), but always asked for */
    function getFix() {
      return new Promise(resolve => {
        if (!navigator.geolocation) return resolve(null);
        navigator.geolocation.getCurrentPosition(
          p => resolve({ lat: p.coords.latitude, lng: p.coords.longitude, accuracy: p.coords.accuracy }),
          () => resolve(null),
          { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 });
      });
    }

    async function startScan(direction) {
      show('loading');
      $('loadingText').textContent = 'กำลังหาตำแหน่ง GPS…';
      const fix = await getFix();
      if (!fix && !confirm('หาตำแหน่งไม่ได้ (ไม่ได้อนุญาต GPS หรือสัญญาณอ่อน)\nสแกนต่อได้ แต่จะต้องรอหัวหน้าอนุมัติ — ดำเนินการต่อ?')) return loadStatus();
      try {
        const ch = await api('/api/face/scan/challenge', { method: 'POST', body: JSON.stringify({ direction }) });
        scan = { direction, token: ch.token, action: ch.action, fix, front: null };
      } catch (err) { ERP.toast(err.message, 'error'); return loadStatus(); }
      mode = 'scan'; stage = 'front';
      $('camNote').textContent = `${direction === 'in' ? 'เข้างาน' : 'ออกงาน'} · ขั้นที่ 1 มองตรง → ขั้นที่ 2 ${turnText()}`;
      await openCamera();
    }

    async function loop() {
      if (!running) return;
      const video = $('video');
      const res = await human.detect(video);
      if (!running) return;
      const faces = res.face.filter(f => f.score > 0.6);
      const W = video.videoWidth, H = video.videoHeight;
      const turning = mode === 'scan' && stage === 'turn';
      if (!faces.length) { goodSince = 0; setGuide('', turning ? turnText() : 'มองตรงมาที่กล้อง', 'ไม่พบใบหน้า'); }
      else if (faces.length > 1) { goodSince = 0; setGuide('warn', 'ต้องมีใบหน้าเดียวในภาพ'); }
      else {
        const f = faces[0];
        const [x, y, w, h] = f.box;
        const cx = (x + w / 2) / W, cy = (y + h / 2) / H;
        const yaw = f.rotation && f.rotation.angle ? f.rotation.angle.yaw : 0;
        if (w < W * 0.35) { goodSince = 0; setGuide('warn', 'ขยับเข้าใกล้กล้องอีกนิด'); }
        else if (!turning && (Math.abs(cx - 0.5) > 0.15 || Math.abs(cy - 0.46) > 0.15)) { goodSince = 0; setGuide('warn', 'เลื่อนใบหน้าให้อยู่กลางกรอบ'); }
        else if (mode === 'enroll') {
          if (!goodSince) goodSince = Date.now();
          if (res.gesture.some(g => /blink/.test(g.gesture || ''))) blinkAt = Date.now();
          if (!blinkAt) setGuide('ok', 'กะพริบตา 1 ครั้ง', 'ตรวจว่าเป็นคนจริง');
          else if (Date.now() - goodSince > 600) { setGuide('ok', 'กำลังถ่ายภาพ…'); return capture(); }
        } else if (stage === 'front') {
          if (Math.abs(yaw) > 0.15) { goodSince = 0; setGuide('warn', 'มองตรงมาที่กล้อง'); }
          else {
            if (!goodSince) goodSince = Date.now();
            setGuide('ok', 'นิ่งไว้…');
            if (Date.now() - goodSince > 500) return capture();
          }
        } else {
          // Negative yaw = the person turned to their own left (raw camera frame, same as the server)
          const done = scan.action === 'left' ? yaw <= -0.32 : yaw >= 0.32;
          setGuide(done ? 'ok' : '', turnText(), done ? 'กำลังถ่ายภาพ…' : '');
          if (done) return capture();
        }
      }
      requestAnimationFrame(loop);
    }

    function frameJpeg() {
      const video = $('video');
      const scale = Math.min(1, 960 / Math.max(video.videoWidth, video.videoHeight));
      const c = document.createElement('canvas');
      c.width = Math.round(video.videoWidth * scale);
      c.height = Math.round(video.videoHeight * scale);
      c.getContext('2d').drawImage(video, 0, 0, c.width, c.height);
      return c.toDataURL('image/jpeg', 0.88);
    }

    async function capture() {
      if (busy) return;
      if (mode === 'scan' && stage === 'front') {
        // Step 2: keep the camera running and ask for the random head turn
        scan.front = frameJpeg();
        stage = 'turn'; stageAt = Date.now(); goodSince = 0;
        $('turnArrow').innerHTML = `<i class="bi bi-arrow-${scan.action === 'left' ? 'left' : 'right'}-circle-fill"></i>`;
        // The preview is mirrored, so the person's left appears on the screen's left
        $('turnArrow').style.left = scan.action === 'left' ? '6%' : '';
        $('turnArrow').style.right = scan.action === 'right' ? '6%' : '';
        $('turnArrow').classList.remove('hidden');
        setGuide('', turnText());
        if (running && human) requestAnimationFrame(loop);
        return;
      }
      busy = true;
      const photo = frameJpeg();
      stopCamera(false);
      show('loading');
      $('loadingText').textContent = 'กำลังตรวจสอบใบหน้า…';
      try {
        if (mode === 'enroll') {
          const data = await api('/api/face/enroll', { method: 'POST', body: JSON.stringify({ photo, consent: true, consentVersion: me.consent.version }) });
          ERP.toast(data.message, 'success');
          $('consentCheck').checked = false; $('startBtn').disabled = true;
          await loadStatus();
        } else {
          const body = { token: scan.token, front: scan.front, turn: photo };
          if (scan.fix) Object.assign(body, scan.fix);
          showResult(await api('/api/face/scan', { method: 'POST', body: JSON.stringify(body) }));
        }
      } catch (err) {
        ERP.toast(err.message, 'error');
        await loadStatus();
      } finally {
        busy = false;
        scan = mode === 'scan' ? null : scan;
      }
    }

    function showResult(r) {
      const look = {
        accepted: ['bg-emerald-100 text-emerald-600', 'bi-check-lg', `${r.direction === 'in' ? 'เข้างาน' : 'ออกงาน'}สำเร็จ`],
        pending: ['bg-amber-100 text-amber-600', 'bi-hourglass-split', 'รอหัวหน้าตรวจสอบ'],
        rejected: ['bg-red-100 text-red-600', 'bi-x-lg', 'สแกนไม่ผ่าน']
      }[r.status];
      $('resultIcon').className = 'mx-auto grid h-20 w-20 place-items-center rounded-full text-4xl ' + look[0];
      $('resultIcon').innerHTML = `<i class="bi ${look[1]}" aria-hidden="true"></i>`;
      $('resultTitle').textContent = look[2];
      $('resultText').textContent = r.message;
      $('resultPlace').textContent = r.site ? `${r.site}${r.distanceM != null ? ` · ห่าง ${Math.round(r.distanceM)} ม.` : ''}` : '';
      show('result');
    }

    /* ---------- My month ---------- */
    let monthYm = null;
    const MLOOK = {
      ok: 'bg-emerald-100 text-emerald-800', late: 'bg-amber-100 text-amber-800', absent: 'bg-red-100 text-red-700',
      leave: 'bg-sky-100 text-sky-800', off: 'bg-slate-100 text-slate-400', none: 'bg-white text-slate-700 ring-1 ring-inset ring-slate-200',
      future: 'bg-white text-slate-300'
    };
    const MTEXT = { ok: 'มาปฏิบัติงาน', late: 'มาสาย', absent: 'ไม่พบการสแกน (ขาด)', leave: 'ลา', off: 'วันหยุด', none: 'ไม่พบการสแกน', future: '' };
    const EXSTAT = { pending: ['text-amber-700', 'รอพิจารณา'], approved: ['text-emerald-700', 'อนุมัติแล้ว'], rejected: ['text-red-600', 'ไม่อนุมัติ'] };
    let monthData = null;

    async function loadMonth(ym) {
      show('month');
      $('mGrid').innerHTML = '<div class="col-span-7 py-8 text-center text-xs text-slate-400">กำลังโหลด…</div>';
      $('mDetail').classList.add('hidden');
      try {
        monthData = await api('/api/me/month' + (ym ? `?ym=${ym}` : ''));
      } catch (err) { $('mGrid').innerHTML = `<div class="col-span-7 py-8 text-center text-xs text-red-600">${esc(err.message)}</div>`; return; }
      monthYm = monthData.ym;
      const [y, m] = monthYm.split('-').map(Number);
      $('mTitle').textContent = new Date(y, m - 1, 1).toLocaleDateString('th-TH', { month: 'long', year: 'numeric' });
      $('mPrev').disabled = !monthData.canPrev; $('mNext').disabled = !monthData.canNext;
      const t = monthData.totals;
      $('mTotals').innerHTML = [['มา', t.ok + t.late, 'text-emerald-700'], ['สาย', t.late, 'text-amber-700'], ['ขาด', t.absent, 'text-red-600'], ['ลา', t.leave, 'text-sky-700']]
        .map(([l, n, c]) => `<div class="rounded-lg bg-slate-50 py-1.5"><div class="font-mono text-lg font-semibold ${c}">${n}</div><div class="text-2xs text-slate-500">${l}</div></div>`).join('');
      const lead = monthData.days[0].dow;
      $('mGrid').innerHTML = '<div></div>'.repeat(lead) + monthData.days.map(d => `
        <button type="button" data-day="${d.day}" class="relative aspect-square rounded-lg text-[13px] font-semibold ${MLOOK[d.status]}" ${d.status === 'future' ? 'disabled' : ''}>
          ${d.day}${d.excuse ? '<span class="absolute right-1 top-1 h-1.5 w-1.5 rounded-full bg-plum-500"></span>' : ''}
        </button>`).join('');
      // Open the most recent day that needs attention, if any
      const todo = [...monthData.days].reverse().find(d => (d.status === 'late' || d.status === 'absent') && !(d.excuse && d.excuse.status !== 'rejected'));
      if (todo) showDay(todo.day);
    }

    function showDay(day) {
      const d = monthData.days.find(x => x.day === day);
      if (!d) return;
      const dateTh = new Date(`${d.date}T00:00:00`).toLocaleDateString('th-TH', { weekday: 'long', day: 'numeric', month: 'long' });
      const needs = (d.status === 'late' || d.status === 'absent' || d.status === 'none') && !(d.excuse && d.excuse.status === 'approved');
      const issue = d.status === 'late' ? 'late' : d.status === 'absent' ? 'absent' : 'scan-failed';
      $('mDetail').innerHTML = `
        <div class="flex items-start justify-between gap-2">
          <div><div class="text-[15px] font-semibold text-slate-900">${esc(dateTh)}</div>
            <div class="text-xs text-slate-500">${esc(MTEXT[d.status])}${d.holiday ? ' · ' + esc(d.holiday) : ''}${d.shift ? ' · เวร' + esc(d.shift) : ''}${d.leave ? ' · ' + esc(d.leave) : ''}</div></div>
          <span class="rounded-md px-2 py-0.5 text-2xs font-semibold ${MLOOK[d.status]}">${d.day}</span>
        </div>
        <div class="mt-3 grid grid-cols-2 gap-2 text-center">
          <div class="rounded-lg bg-slate-50 py-2"><div class="text-2xs text-slate-500">สแกนเข้า</div><div class="font-mono text-base font-semibold text-slate-900">${d.first || '—'}</div></div>
          <div class="rounded-lg bg-slate-50 py-2"><div class="text-2xs text-slate-500">สแกนออก</div><div class="font-mono text-base font-semibold text-slate-900">${d.last || '—'}</div></div>
        </div>
        ${d.mobile ? '<p class="mt-2 text-center text-2xs text-plum-600"><i class="bi bi-phone"></i> มีการสแกนผ่านมือถือ</p>' : ''}
        ${d.excuse ? `<div class="mt-3 rounded-lg bg-plum-50 p-3 text-xs"><b>คำร้องแก้ต่าง:</b> <span class="${EXSTAT[d.excuse.status][0]} font-semibold">${EXSTAT[d.excuse.status][1]}</span>${d.excuse.comment ? `<div class="mt-1 text-slate-600">ความเห็น: ${esc(d.excuse.comment)}</div>` : ''}</div>` : ''}
        ${needs ? `
          <form id="exForm" class="mt-3 space-y-2">
            <label class="block text-xs font-medium text-slate-700">แจ้งเหตุ
              <select id="exType" class="erp-input mt-1 h-10">
                <option value="late" ${issue === 'late' ? 'selected' : ''}>มาสาย</option>
                <option value="absent" ${issue === 'absent' ? 'selected' : ''}>ขาดงาน</option>
                <option value="scan-failed" ${issue === 'scan-failed' ? 'selected' : ''}>มาทำงานแต่สแกนไม่ติด / ลืมสแกน</option>
                <option value="leave">ลา (แจ้งย้อนหลัง)</option>
              </select></label>
            <textarea id="exReason" class="erp-input min-h-[80px]" maxlength="1000" required placeholder="เหตุผล เช่น ไปประชุมนอกสถานที่, รถเสีย"></textarea>
            <button type="submit" class="erp-btn erp-btn-primary h-11 w-full"><i class="bi bi-send"></i> ${d.excuse ? 'ส่งใหม่' : 'ส่งคำร้อง'}</button>
          </form>` : ''}`;
      $('mDetail').classList.remove('hidden');
      const form = $('exForm');
      if (form) form.addEventListener('submit', async e => {
        e.preventDefault();
        try {
          const r = await api('/api/excuses', { method: 'POST', body: JSON.stringify({ date: d.date, issue_type: $('exType').value, reason: $('exReason').value.trim() }) });
          ERP.toast(r.message, 'success');
          await loadMonth(monthYm);
          showDay(d.day);
        } catch (err) { ERP.toast(err.message, 'error'); }
      });
      $('mDetail').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    $('mGrid').addEventListener('click', e => { const b = e.target.closest('[data-day]'); if (b) showDay(Number(b.dataset.day)); });
    const shiftYm = (ym, delta) => { const [y, m] = ym.split('-').map(Number); const d = new Date(y, m - 1 + delta, 1); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`; };
    $('mPrev').addEventListener('click', () => loadMonth(shiftYm(monthYm, -1)));
    $('mNext').addEventListener('click', () => loadMonth(shiftYm(monthYm, 1)));
    $('mobileTabs').addEventListener('click', e => {
      const b = e.target.closest('[data-mtab]');
      if (!b) return;
      if (b.dataset.mtab === 'month') loadMonth(monthYm); else loadStatus();
    });

    boot();
  </script>
</body>

</html>
