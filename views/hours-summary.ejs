<!DOCTYPE html>
<html lang="th">

<head>
  <%- include("components/erp-head", { title: "สรุปชั่วโมงทำงาน" }) %>
  <script src="/js/work-hours.js"></script>
</head>

<body class="erp-page">
  <%- include("components/sidebar") %>
  <div class="main" role="main">
    <%- include("components/topbar") %>
    <% const months = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"]; %>
    <% const now = new Date(); const currentMonth = now.getMonth() + 1; const currentYear = now.getFullYear(); %>

    <div class="erp px-4 py-5 lg:px-6">
      <section class="mb-5 flex flex-wrap items-end justify-between gap-4" aria-labelledby="hours-heading">
        <div>
          <h2 id="hours-heading" class="text-xl font-semibold text-slate-900">สรุปชั่วโมงทำงาน</h2>
          <p class="mt-1 text-[13px] text-slate-500">ชั่วโมงปฏิบัติงานจริงจากเวลาสแกนเข้า–ออก รายบุคคล พร้อมชั่วโมงที่เกินเกณฑ์ (OT)</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <select id="monthSel" class="erp-input w-auto" aria-label="เดือน">
            <% months.forEach((m, i) => { %><option value="<%= i + 1 %>" <%= (i + 1) === currentMonth ? 'selected' : '' %>><%= m %></option><% }); %>
          </select>
          <select id="yearSel" class="erp-input w-auto" aria-label="ปี">
            <% for (let y = currentYear - 2; y <= currentYear; y++) { %><option value="<%= y %>" <%= y === currentYear ? 'selected' : '' %>><%= y + 543 %></option><% } %>
          </select>
          <button type="button" class="erp-btn erp-btn-secondary" onclick="exportCsv()"><i class="bi bi-download" aria-hidden="true"></i> ส่งออก CSV</button>
        </div>
      </section>

      <section class="erp-panel mb-5 grid grid-cols-2 sm:grid-cols-4 sm:divide-x sm:divide-slate-100" aria-label="สรุป">
        <% [['kTotal','ชั่วโมงทำงานรวม','ชม.'],['kAvg','เฉลี่ยต่อคนต่อวัน','ชม.'],['kOt','ชั่วโมงเกินเกณฑ์ (จากเวลาสแกน)','ชม.'],['kOtPeople','บุคลากรที่ทำงานเกินเกณฑ์','คน']].forEach(([id, label, unit]) => { %>
          <div class="p-4">
            <div class="truncate text-xs text-slate-500"><%= label %></div>
            <div class="mt-1 flex items-baseline gap-1"><span id="<%= id %>" class="font-mono text-2xl font-semibold tabular-nums text-slate-900">–</span><span class="text-2xs text-slate-400"><%= unit %></span></div>
          </div>
        <% }); %>
      </section>

      <section class="erp-panel overflow-hidden" aria-labelledby="hoursTable">
        <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 p-3">
          <h3 id="hoursTable" class="sr-only">ตารางชั่วโมงทำงาน</h3>
          <div class="relative min-w-[220px] flex-1 sm:max-w-sm">
            <i class="bi bi-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
            <input type="search" id="search" class="erp-input pl-9" placeholder="ค้นหาชื่อหรือรหัส…" aria-label="ค้นหา">
          </div>
          <select id="deptSel" class="erp-input w-auto min-w-[180px] max-w-[260px]" aria-label="กลุ่มงาน"><option value="">ทุกกลุ่มงาน</option></select>
          <select id="typeSel" class="erp-input w-auto" aria-label="รูปแบบเวร">
            <option value="">ทุกรูปแบบเวร</option><option value="1">เวรปกติ</option><option value="2">เวร 8 ชม.</option>
          </select>
          <label class="flex items-center gap-1.5 text-xs text-slate-600"><input type="checkbox" id="otOnly" class="accent-brand-600"> เฉพาะผู้ที่เกินเกณฑ์</label>
          <span id="otNote" class="ml-auto text-2xs text-slate-400"></span>
        </div>
        <div class="max-h-[65vh] overflow-auto">
          <table class="w-full border-collapse text-left text-[13px]">
            <thead class="sticky top-0 z-10 bg-slate-50 text-2xs uppercase tracking-wide text-slate-500">
              <tr class="border-b border-slate-200">
                <% [['name','บุคลากร',''],['dept','กลุ่มงาน',''],['type','เวร',''],['days','วันทำงาน','text-right'],['total','ชั่วโมงรวม','text-right'],['avg','เฉลี่ย/วัน','text-right'],['max','สูงสุด/วัน','text-right'],['ot','เกินเกณฑ์','text-right'],['approvedOt','OT อนุมัติ','text-right']].forEach(([k, l, al], i) => { %>
                  <th class="<%= i === 0 ? 'px-4' : 'px-3' %> py-2.5 font-semibold <%= al %>"><button type="button" class="uppercase hover:text-slate-800" data-sort="<%= k %>"><%= l %> <i class="bi bi-arrow-down-up text-[10px]"></i></button></th>
                <% }); %>
              </tr>
            </thead>
            <tbody id="body" class="divide-y divide-slate-100">
              <tr><td colspan="9" class="px-4 py-16 text-center text-slate-400">กำลังคำนวณ…</td></tr>
            </tbody>
          </table>
        </div>
        <div id="foot" class="border-t border-slate-200 bg-slate-50/70 px-4 py-2.5 text-xs text-slate-500"></div>
      </section>
    </div>
  </div>

  <script>
    const $ = id => document.getElementById(id);
    const esc = ERP.escapeHtml;
    const fmt1 = n => (Number(n) || 0).toLocaleString('th-TH', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const TYPE_LABEL = { 1: 'ปกติ', 2: 'เวร 8' };
    let rows = [];
    let sortKey = 'total';
    let sortDir = -1;

    const otThreshold = () => {
      const s = (window.loadSettings && window.loadSettings()) || {};
      return Number(s.staffHours && s.staffHours.staff && s.staffHours.staff.ot) || 8;
    };

    async function fetchTemplate(ym, template) {
      const res = await fetch(`/api/personnel-template2?yearMonth=${ym}&template=${template}`, { headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(res.status);
      return res.json();
    }

    async function loadData() {
      const month = Number($('monthSel').value);
      const year = Number($('yearSel').value);
      const ym = `${year}-${String(month).padStart(2, '0')}`;
      const days = new Date(year, month, 0).getDate();
      const threshold = otThreshold();
      $('otNote').textContent = `เกินเกณฑ์ = ชั่วโมงที่เกิน ${threshold} ชม./วันจากเวลาสแกน · OT อนุมัติ = จากคำขอ OT`;
      $('body').innerHTML = '<tr><td colspan="9" class="px-4 py-16 text-center text-slate-400">กำลังคำนวณ…</td></tr>';
      try {
        const results = await Promise.all(['1', '2'].map(t => fetchTemplate(ym, t).then(d => ({ t, d }))));
        // Approved OT requests for the month (empty if the OT module isn't migrated yet)
        const otByEmployee = {};
        try {
          const lastDay = String(days).padStart(2, '0');
          const otRes = await fetch(`/api/ot?scope=all&status=approved&from=${ym}-01&to=${ym}-${lastDay}`, { headers: { Accept: 'application/json' } });
          const otData = otRes.ok ? await otRes.json() : {};
          (otData.requests || []).forEach(r => { otByEmployee[r.employee_id] = (otByEmployee[r.employee_id] || 0) + Number(r.hours); });
        } catch { /* OT unavailable */ }
        rows = [];
        results.forEach(({ t, d }) => {
          const scans = d.scans || {};
          const find = (arr, id) => (Array.isArray(arr) ? arr : []).find(r => String(r.hr_person_id) === String(id)) || {};
          (d.personnel || []).forEach(p => {
            const perDay = WorkHours.dailyHours({ morning: find(scans.morning, p.ID), afternoon: find(scans.afternoon, p.ID), night: find(scans.night, p.ID) }, t, days);
            const sum = WorkHours.summarizeHours(perDay, threshold);
            rows.push({
              id: String(p.FINGLE_ID || p.ID), name: `${p.HR_FNAME || ''} ${p.HR_LNAME || ''}`.trim() || 'ไม่ระบุชื่อ',
              dept: (p.HR_DEPARTMENT_NAME || 'ไม่ระบุ').trim(), type: t, ...sum,
              approvedOt: Math.round((otByEmployee[String(p.FINGLE_ID || p.ID)] || 0) * 10) / 10
            });
          });
        });
        ERP.fillSelect($('deptSel'), ERP.uniqueSorted(rows, 'dept'));
        render();
      } catch (err) {
        console.error(err);
        $('body').innerHTML = ERP.emptyRow(9, 'โหลดข้อมูลไม่สำเร็จ', 'bi-exclamation-triangle');
      }
    }

    function filtered() {
      const q = $('search').value.trim().toLowerCase();
      const dept = $('deptSel').value;
      const type = $('typeSel').value;
      const otOnly = $('otOnly').checked;
      return rows.filter(r => (!dept || r.dept === dept) && (!type || r.type === type) && (!otOnly || r.ot > 0) &&
        (!q || `${r.name} ${r.id}`.toLowerCase().includes(q)));
    }

    function render() {
      const list = filtered().sort((a, b) => {
        const x = a[sortKey], y = b[sortKey];
        return (typeof x === 'number' ? x - y : String(x).localeCompare(String(y), 'th')) * sortDir;
      });
      const worked = list.filter(r => r.days > 0);
      const total = list.reduce((s, r) => s + r.total, 0);
      const dayCount = worked.reduce((s, r) => s + r.days, 0);
      $('kTotal').textContent = fmt1(total);
      $('kAvg').textContent = dayCount ? fmt1(total / dayCount) : '–';
      $('kOt').textContent = fmt1(list.reduce((s, r) => s + r.ot, 0));
      $('kOtPeople').textContent = list.filter(r => r.ot > 0).length.toLocaleString('th-TH');
      $('foot').textContent = `${list.length.toLocaleString('th-TH')} คน · มีเวลาสแกนครบ ${worked.length.toLocaleString('th-TH')} คน`;
      if (!list.length) { $('body').innerHTML = ERP.emptyRow(9, 'ไม่พบข้อมูล'); return; }
      const maxTotal = Math.max(1, ...list.map(r => r.total));
      const num = (v, tone) => `<td class="px-3 py-2.5 text-right font-mono text-xs ${v ? tone : 'text-slate-300'}">${v ? fmt1(v) : '–'}</td>`;
      $('body').innerHTML = list.map(r => `<tr class="hover:bg-slate-50">
        <td class="px-4 py-2.5"><div class="flex items-center gap-2.5">${ERP.avatar(r.name, r.id)}
          <div class="min-w-0"><div class="truncate font-medium text-slate-900">${esc(r.name)}</div><div class="font-mono text-2xs text-slate-400">${esc(r.id)}</div></div></div></td>
        <td class="max-w-[220px] px-3 py-2.5"><div class="truncate text-slate-600" title="${esc(r.dept)}">${esc(r.dept)}</div></td>
        <td class="px-3 py-2.5">${ERP.badge(TYPE_LABEL[r.type], r.type === '2' ? 'violet' : 'slate')}</td>
        <td class="px-3 py-2.5 text-right font-mono text-xs ${r.days ? 'text-slate-800' : 'text-slate-300'}">${r.days || '–'}</td>
        <td class="px-3 py-2.5 text-right">
          <div class="font-mono text-xs ${r.total ? 'font-semibold text-slate-900' : 'text-slate-300'}">${r.total ? fmt1(r.total) : '–'}</div>
          <div class="ml-auto mt-1 h-1 w-20 overflow-hidden rounded-full bg-slate-100"><div class="h-full bg-brand-500" style="width:${(r.total / maxTotal) * 100}%"></div></div>
        </td>
        ${num(r.avg, 'text-slate-700')}
        ${num(r.max, 'text-slate-700')}
        ${num(r.ot, 'font-semibold text-amber-700')}
        ${num(r.approvedOt, 'font-semibold text-brand-700')}
      </tr>`).join('');
    }

    function exportCsv() {
      const list = filtered();
      if (!list.length) return ERP.toast('ไม่มีข้อมูลสำหรับส่งออก');
      ERP.downloadCsv(`work-hours-${$('yearSel').value}-${String($('monthSel').value).padStart(2, '0')}.csv`,
        ['รหัส', 'ชื่อ-นามสกุล', 'กลุ่มงาน', 'รูปแบบเวร', 'วันทำงาน', 'ชั่วโมงรวม', 'เฉลี่ย/วัน', 'สูงสุด/วัน', `เกินเกณฑ์ (${otThreshold()} ชม./วัน)`, 'OT ที่อนุมัติ'],
        list.map(r => [r.id, r.name, r.dept, TYPE_LABEL[r.type], r.days, r.total, r.avg, r.max, r.ot, r.approvedOt]));
    }

    document.querySelectorAll('[data-sort]').forEach(b => b.addEventListener('click', () => {
      const k = b.dataset.sort;
      sortDir = sortKey === k ? -sortDir : (['name', 'dept', 'type'].includes(k) ? 1 : -1);
      sortKey = k;
      render();
    }));
    ['search', 'deptSel', 'typeSel', 'otOnly'].forEach(id => $(id).addEventListener('input', render));
    ['monthSel', 'yearSel'].forEach(id => $(id).addEventListener('change', loadData));
    loadData();
  </script>
</body>

</html>
