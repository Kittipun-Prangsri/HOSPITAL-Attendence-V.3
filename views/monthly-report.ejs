<!DOCTYPE html>
<html lang="th">

<head>
  <%- include("components/erp-head", { title: "รายงานรายเดือน" }) %>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <style>
    @media print {
      @page { size: A4 landscape; margin: 10mm; }
      body.erp-page { background: #fff; }
      .erp-panel { box-shadow: none !important; }
      #table-wrapper { max-height: none !important; overflow: visible !important; }
    }
  </style>
</head>

<body class="erp-page">
  <%- include("components/sidebar") %>
  <div class="main" role="main">
    <%- include("components/topbar") %>
    <% const months = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"]; %>
    <% const now = new Date(); const currentMonth = now.getMonth() + 1; const currentYear = now.getFullYear(); %>

    <div class="erp px-4 py-5 lg:px-6">
      <section class="mb-5 flex flex-wrap items-end justify-between gap-4 print:hidden" aria-labelledby="monthly-report-heading">
        <div>
          <h2 id="monthly-report-heading" class="text-xl font-semibold text-slate-900">สรุปการปฏิบัติงานรายเดือน</h2>
          <p class="mt-1 text-[13px] text-slate-500">สรุปวันมาทำงาน มาสาย ขาด ลา รายบุคคล และตารางเวลาสแกนรายวันตลอดเดือน</p>
        </div>
        <div class="flex gap-2">
          <button type="button" class="erp-btn erp-btn-secondary" onclick="exportToPDF()"><i class="bi bi-printer" aria-hidden="true"></i> พิมพ์ / PDF</button>
          <button type="button" class="erp-btn erp-btn-primary" onclick="exportData()"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> ส่งออก Excel</button>
        </div>
      </section>

      <!-- Toolbar -->
      <section class="erp-panel mb-5 flex flex-wrap items-center gap-2 p-3 print:hidden" aria-label="ตัวกรอง">
        <div class="inline-flex rounded-md bg-slate-100 p-0.5" role="tablist" aria-label="มุมมองรายงาน">
          <button type="button" role="tab" id="summaryViewBtn" onclick="setView('summary')"
            class="rounded px-3 py-1.5 text-[13px] font-medium text-slate-600 aria-selected:bg-white aria-selected:text-slate-900 aria-selected:shadow-sm" aria-selected="true">
            <i class="bi bi-grid-1x2" aria-hidden="true"></i> สรุปรายบุคคล
          </button>
          <button type="button" role="tab" id="detailedViewBtn" onclick="setView('detailed')"
            class="rounded px-3 py-1.5 text-[13px] font-medium text-slate-600 aria-selected:bg-white aria-selected:text-slate-900 aria-selected:shadow-sm" aria-selected="false">
            <i class="bi bi-table" aria-hidden="true"></i> ตารางเวลาสแกนรายวัน
          </button>
        </div>
        <span class="mx-1 h-6 w-px bg-slate-200" aria-hidden="true"></span>
        <select id="monthSelector" class="erp-input w-auto" onchange="loadData()" aria-label="เดือน">
          <% months.forEach((m, i) => { %><option value="<%= i + 1 %>" <%= (i + 1) === currentMonth ? 'selected' : '' %>><%= m %></option><% }); %>
        </select>
        <select id="yearSelector" class="erp-input w-auto" onchange="loadData()" aria-label="ปี">
          <% for (let y = currentYear - 2; y <= currentYear; y++) { %><option value="<%= y %>" <%= y === currentYear ? 'selected' : '' %>><%= y + 543 %></option><% } %>
        </select>
        <div id="shiftTypeGroup" class="hidden rounded-md bg-slate-100 p-0.5" role="radiogroup" aria-label="ประเภทเวร">
          <label class="cursor-pointer rounded px-3 py-1.5 text-[13px] font-medium text-slate-600 has-[:checked]:bg-white has-[:checked]:text-slate-900 has-[:checked]:shadow-sm">
            <input type="radio" class="sr-only" name="shiftType" value="1" checked onchange="loadData()"> เวรปกติ
          </label>
          <label class="cursor-pointer rounded px-3 py-1.5 text-[13px] font-medium text-slate-600 has-[:checked]:bg-white has-[:checked]:text-slate-900 has-[:checked]:shadow-sm">
            <input type="radio" class="sr-only" name="shiftType" value="2" onchange="loadData()"> เวร 8
          </label>
        </div>
        <select id="deptFilter" class="erp-input w-auto min-w-[180px] max-w-[260px]" onchange="applyFilters()" aria-label="กลุ่มงาน">
          <option value="">ทุกกลุ่มงาน</option>
        </select>
        <div class="relative min-w-[200px] flex-1 sm:max-w-xs">
          <i class="bi bi-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
          <input type="search" id="nameSearch" class="erp-input pl-9" placeholder="ค้นหาชื่อหรือรหัส…" oninput="applyFilters()" aria-label="ค้นหา">
        </div>
      </section>

      <!-- KPIs -->
      <section class="erp-panel mb-5 grid grid-cols-2 lg:grid-cols-4 lg:divide-x lg:divide-slate-100" aria-label="สรุป">
        <% [['statTotalEmps','บุคลากรทั้งหมด','คน'],['statTotalHours','อัตราเข้างานเฉลี่ย',''],['statTotalLate','มาสายรวม','ครั้ง'],['statTotalAbsent','ขาดงานรวม','วัน']].forEach(([id, label, unit]) => { %>
          <div class="p-4">
            <div id="<%= id === 'statTotalHours' ? 'statCard2Label' : id + 'Label' %>" class="truncate text-xs text-slate-500"><%= label %></div>
            <div class="mt-1 flex items-baseline gap-1"><span id="<%= id %>" class="font-mono text-2xl font-semibold tabular-nums text-slate-900">–</span><span class="text-2xs text-slate-400"><%= unit %></span></div>
          </div>
        <% }); %>
      </section>

      <!-- Lateness by dept -->
      <section id="chartCard" class="erp-panel mb-5" aria-labelledby="chartTitle">
        <div class="border-b border-slate-200 px-4 py-3">
          <h3 id="chartTitle" class="text-[13px] font-semibold text-slate-800">มาสายแยกตามกลุ่มงาน (ครั้ง)</h3>
        </div>
        <div id="latenessChart" class="grid grid-cols-1 gap-x-8 gap-y-2.5 p-4 md:grid-cols-2"></div>
      </section>

      <!-- Report table -->
      <section class="erp-panel overflow-hidden" aria-labelledby="table-title">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-4 py-3">
          <div>
            <div class="hidden text-2xs uppercase tracking-wide text-slate-400 print:block">โรงพยาบาลคลองหาด</div>
            <h3 id="table-title" class="text-[13px] font-semibold text-slate-800">ตารางสรุปข้อมูลรายเดือน</h3>
            <p id="periodLabel" class="text-2xs text-slate-400"></p>
          </div>
          <div id="matrixLegend" class="hidden flex-wrap gap-3 text-2xs text-slate-500">
            <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm bg-slate-100 ring-1 ring-slate-200"></span>เสาร์–อาทิตย์</span>
            <span class="flex items-center gap-1"><span class="h-2.5 w-2.5 rounded-sm bg-violet-100"></span>ลา / ไปราชการ</span>
            <span class="flex items-center gap-1"><span class="font-mono font-semibold text-amber-700">08:45</span>เข้าสาย</span>
          </div>
        </div>
        <div id="table-wrapper" class="max-h-[68vh] overflow-auto">
          <table class="att-table w-full border-collapse text-left text-[13px]">
            <thead id="reportTableHead" class="sticky top-0 z-20 bg-slate-50 text-2xs uppercase tracking-wide text-slate-500"></thead>
            <tbody id="reportTableBody">
              <tr><td class="px-4 py-16 text-center text-slate-400"><i class="bi bi-hourglass-split mr-1"></i> กำลังดึงข้อมูล…</td></tr>
            </tbody>
          </table>
        </div>
        <div id="page-info" class="border-t border-slate-200 bg-slate-50/70 px-4 py-2.5 text-xs text-slate-500"></div>
      </section>
    </div>
  </div>

  <script>
    const MONTHS = <%- JSON.stringify(months) %>;
    const DAYS_TH = ['อา', 'จ', 'อ', 'พ', 'พฤ', 'ศ', 'ส'];
    const STATUS_META = { 'ปกติ': 'green', 'ต้องปรับปรุง': 'red', 'รอดำเนินการ (Overdue)': 'amber' };
    const $ = id => document.getElementById(id);
    const esc = ERP.escapeHtml;
    const fmt = n => Number(n || 0).toLocaleString('th-TH');

    let currentView = 'summary';
    let rawData = [];
    let filteredData = [];
    let rawSummaryData = [];
    let filteredSummaryData = [];
    let currentMonth = Number($('monthSelector').value);
    let currentYear = Number($('yearSelector').value);
    let daysInMonth = new Date(currentYear, currentMonth, 0).getDate();
    const dateKey = d => `${currentYear}-${String(currentMonth).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    // Same rule as the server (check-in later than work start + grace minutes), morning check-ins only
    const lateThresholdMin = (() => {
      const st = (window.loadSettings && window.loadSettings()) || {};
      const [h, m] = String(st.workStart || '08:00').split(':').map(Number);
      return (h * 60 + m) + (Number.isFinite(Number(st.lateMin)) ? Number(st.lateMin) : 31);
    })();
    const isLateTime = t => { const [h, m] = String(t).split(':').map(Number); return h < 12 && h * 60 + m > lateThresholdMin; };

    async function loadData() {
      currentMonth = Number($('monthSelector').value);
      currentYear = Number($('yearSelector').value);
      daysInMonth = new Date(currentYear, currentMonth, 0).getDate();
      $('periodLabel').textContent = `ประจำเดือน${MONTHS[currentMonth - 1]} ${currentYear + 543}`;
      if (currentView === 'summary') await fetchSummaryData();
      else await fetchDetailedData();
    }

    function setView(view) {
      currentView = view;
      const summary = view === 'summary';
      $('summaryViewBtn').setAttribute('aria-selected', String(summary));
      $('detailedViewBtn').setAttribute('aria-selected', String(!summary));
      $('chartCard').style.display = summary ? '' : 'none';
      $('shiftTypeGroup').classList.toggle('hidden', summary);
      $('shiftTypeGroup').classList.toggle('inline-flex', !summary);
      $('matrixLegend').classList.toggle('hidden', summary);
      $('matrixLegend').classList.toggle('flex', !summary);
      $('table-title').textContent = summary ? 'ตารางสรุปข้อมูลรายเดือน' : 'ตารางเวลาสแกนรายวัน';
      loadData();
    }

    /* ---------------- Summary view ---------------- */
    async function fetchSummaryData() {
      $('reportTableHead').innerHTML = '';
      $('reportTableBody').innerHTML = '<tr><td class="px-4 py-16 text-center text-slate-400">กำลังดึงข้อมูลสรุป…</td></tr>';
      try {
        const res = await fetch(`/api/report/monthly?month=${currentMonth}&year=${currentYear}`, { headers: { Accept: 'application/json' } });
        const data = await res.json();
        if (!data.success) throw new Error(data.message);
        rawSummaryData = data.report || [];
        ERP.fillSelect($('deptFilter'), ERP.uniqueSorted(rawSummaryData, 'dept'));
        $('reportTableHead').innerHTML = `<tr class="border-b border-slate-200">
          <th class="px-4 py-2.5 font-semibold">รหัส</th>
          <th class="px-3 py-2.5 font-semibold">ชื่อ-นามสกุล</th>
          <th class="px-3 py-2.5 font-semibold">กลุ่มงาน</th>
          <th class="px-3 py-2.5 text-right font-semibold">มาทำงาน (วัน)</th>
          <th class="px-3 py-2.5 text-right font-semibold">มาสาย (ครั้ง)</th>
          <th class="px-3 py-2.5 text-right font-semibold">ขาดงาน (วัน)</th>
          <th class="px-3 py-2.5 text-right font-semibold">ลา (วัน)</th>
          <th class="px-3 py-2.5 text-right font-semibold">ค้างส่ง</th>
          <th class="px-4 py-2.5 font-semibold">สถานะ</th>
        </tr>`;
        applyFilters();
      } catch (err) {
        console.error(err);
        $('reportTableBody').innerHTML = `<tr><td class="px-4 py-16 text-center text-red-600">ดึงข้อมูลไม่สำเร็จ${err.message ? ': ' + esc(err.message) : ''}</td></tr>`;
      }
    }

    function renderSummaryTableBody() {
      const tbody = $('reportTableBody');
      $('page-info').textContent = `ทั้งหมด ${fmt(filteredSummaryData.length)} คน`;
      if (!filteredSummaryData.length) { tbody.innerHTML = ERP.emptyRow(9, 'ไม่พบข้อมูลตามเงื่อนไขที่ระบุ'); return; }
      const num = (v, tone) => `<td class="px-3 py-2.5 text-right font-mono text-xs ${Number(v) ? tone : 'text-slate-300'}">${Number(v) ? fmt(v) : '–'}</td>`;
      tbody.innerHTML = filteredSummaryData.map(p => `<tr class="border-b border-slate-100 hover:bg-slate-50">
        <td class="px-4 py-2.5 font-mono text-xs text-slate-600">${esc(p.id)}</td>
        <td class="px-3 py-2.5 font-medium text-slate-900">${esc(p.name)}</td>
        <td class="max-w-[240px] px-3 py-2.5"><div class="truncate text-slate-600" title="${esc(p.dept)}">${esc(p.dept)}</div></td>
        ${num(p.daysPresent, 'text-slate-800')}
        ${num(p.lateCount, Number(p.lateCount) > 3 ? 'font-semibold text-amber-700' : 'text-slate-800')}
        ${num(p.absentCount, 'font-semibold text-red-600')}
        ${num(p.leaveCount, 'text-violet-700')}
        ${num(p.overdueCount, 'text-amber-700')}
        <td class="px-4 py-2.5">${ERP.badge(p.status === 'รอดำเนินการ (Overdue)' ? 'รอดำเนินการ' : p.status || 'ปกติ', STATUS_META[p.status] || 'slate')}</td>
      </tr>`).join('');
    }

    function updateSummaryStats() {
      let late = 0, absent = 0, present = 0;
      filteredSummaryData.forEach(p => { late += Number(p.lateCount) || 0; absent += Number(p.absentCount) || 0; present += Number(p.daysPresent) || 0; });
      $('statTotalEmps').textContent = fmt(filteredSummaryData.length);
      $('statCard2Label').textContent = 'อัตราเข้างานเฉลี่ย';
      $('statTotalHours').textContent = present + absent > 0 ? ((present / (present + absent)) * 100).toFixed(1) + '%' : '–';
      $('statTotalLate').textContent = fmt(late);
      $('statTotalAbsent').textContent = fmt(absent);
    }

    function renderSummaryChart() {
      const deptLates = {};
      filteredSummaryData.forEach(e => { if (e.lateCount > 0) deptLates[e.dept] = (deptLates[e.dept] || 0) + Number(e.lateCount); });
      const rows = Object.entries(deptLates).sort((a, b) => b[1] - a[1]).slice(0, 12);
      const max = Math.max(1, ...rows.map(r => r[1]));
      $('latenessChart').innerHTML = rows.length
        ? rows.map(([dept, n]) => `<div>
            <div class="mb-1 flex items-baseline justify-between gap-3 text-xs">
              <span class="truncate text-slate-700">${esc(String(dept).replace(/^กลุ่มงาน/, ''))}</span>
              <span class="font-mono font-semibold text-slate-800">${fmt(n)}</span>
            </div>
            <div class="h-2 rounded-sm bg-amber-500" style="width:${(n / max) * 100}%"></div>
          </div>`).join('')
        : '<p class="col-span-full py-6 text-center text-xs text-slate-400">ไม่มีการมาสายในเดือนนี้</p>';
    }

    /* ---------------- Detailed matrix ---------------- */
    async function fetchDetailedData() {
      const template = document.querySelector('input[name="shiftType"]:checked').value;
      $('reportTableHead').innerHTML = '';
      $('reportTableBody').innerHTML = '<tr><td class="px-4 py-16 text-center text-slate-400">กำลังดึงข้อมูลรายละเอียด…</td></tr>';
      try {
        const ym = `${currentYear}-${String(currentMonth).padStart(2, '0')}`;
        const res = await fetch(`/api/personnel-template2?yearMonth=${ym}&template=${template}`, { headers: { Accept: 'application/json' } });
        const data = await res.json();
        const scans = data.scans || { morning: [], afternoon: [], night: [] };
        rawData = (data.personnel || []).map(p => ({
          id: p.FINGLE_ID || p.ID,
          internalId: p.ID,
          name: p.HR_FNAME ? `${p.HR_FNAME} ${p.HR_LNAME}` : 'Unknown',
          role: p.role || '',
          dept: (p.HR_DEPARTMENT_NAME || 'ไม่ระบุแผนก').trim(),
          attendance: processRealAttendance(p.ID, scans, template)
        }));
        ERP.fillSelect($('deptFilter'), ERP.uniqueSorted(rawData, 'dept'));
        renderDetailedTableHeader();
        applyFilters();
      } catch (err) {
        console.error(err);
        $('reportTableBody').innerHTML = '<tr><td class="px-4 py-16 text-center text-red-600">เกิดข้อผิดพลาดในการโหลดข้อมูลรายละเอียด</td></tr>';
      }
    }

    function processRealAttendance(personId, scans, template) {
      const att = {};
      const find = arr => (Array.isArray(arr) ? arr : []).find(r => String(r.hr_person_id) === String(personId)) || {};
      const mRow = find(scans.morning), aRow = find(scans.afternoon), nRow = find(scans.night);
      for (let d = 1; d <= daysInMonth; d++) {
        const dow = new Date(currentYear, currentMonth - 1, d).getDay();
        const isWeekend = dow === 0 || dow === 6;
        const raw = template === '2'
          ? [mRow['dmi' + d], mRow['dmo' + d], aRow['dai' + d], aRow['dao' + d], nRow['dni' + d], nRow['dno' + d]]
          : [mRow['di' + d], aRow['do' + d], nRow['d' + d]];
        const vals = raw.filter(v => v != null && String(v).trim() !== '');
        const textVals = vals.filter(v => !/^\d{2}:\d{2}/.test(String(v)));
        if (textVals.length) {
          att[dateKey(d)] = { status: 'OFFICIAL', label: textVals[0], isWeekend };
        } else {
          const times = vals.filter(v => /^\d{2}:\d{2}/.test(String(v))).map(v => String(v).slice(0, 5)).sort();
          att[dateKey(d)] = times.length
            ? { in: times[0], out: times.length > 1 && times[times.length - 1] !== times[0] ? times[times.length - 1] : null, isWeekend }
            : { in: null, out: null, isWeekend };
        }
      }
      return att;
    }

    function renderDetailedTableHeader() {
      let row1 = '<tr><th rowspan="2" class="sticky left-0 z-30 min-w-[220px] border-b border-r border-slate-200 bg-slate-50 px-4 py-2 align-bottom font-semibold">บุคลากร</th>';
      let row2 = '<tr>';
      for (let d = 1; d <= daysInMonth; d++) {
        const dow = new Date(currentYear, currentMonth - 1, d).getDay();
        const we = dow === 0 || dow === 6 ? 'bg-slate-100 text-slate-400' : 'bg-slate-50';
        row1 += `<th colspan="2" class="border-b border-l border-slate-200 px-2 pt-2 text-center font-semibold normal-case ${we}">${d} <span class="font-normal">${DAYS_TH[dow]}</span></th>`;
        row2 += `<th class="border-b border-l border-slate-200 px-1 pb-1.5 text-center font-normal normal-case ${we}">เข้า</th><th class="border-b border-slate-200 px-1 pb-1.5 text-center font-normal normal-case ${we}">ออก</th>`;
      }
      $('reportTableHead').innerHTML = row1 + '</tr>' + row2 + '</tr>';
    }

    function renderTableBody() {
      const tbody = $('reportTableBody');
      $('page-info').textContent = `ทั้งหมด ${fmt(filteredData.length)} คน · ${daysInMonth} วัน`;
      if (!filteredData.length) { tbody.innerHTML = `<tr><td colspan="${daysInMonth * 2 + 1}" class="px-4 py-16 text-center text-slate-400">ไม่พบข้อมูลตามเงื่อนไขที่ระบุ</td></tr>`; return; }
      tbody.innerHTML = filteredData.map(p => {
        let html = `<tr class="border-b border-slate-100 hover:bg-slate-50/60">
          <td class="sticky left-0 z-10 border-r border-slate-200 bg-white px-4 py-2">
            <div class="truncate font-medium text-slate-900">${esc(p.name)}</div>
            <div class="truncate text-2xs text-slate-400">${esc(p.dept)}</div>
          </td>`;
        for (let d = 1; d <= daysInMonth; d++) {
          const r = p.attendance[dateKey(d)] || {};
          const we = r.isWeekend ? 'bg-slate-50' : '';
          if (r.status === 'OFFICIAL') {
            html += `<td colspan="2" class="border-l border-slate-100 bg-violet-50 px-1 py-2 text-center text-2xs font-medium text-violet-700" title="${esc(r.label)}"><div class="max-w-[96px] truncate">${esc(r.label || 'ไปราชการ')}</div></td>`;
          } else if (!r.in && !r.out) {
            html += `<td class="border-l border-slate-100 px-1 py-2 text-center text-slate-300 ${we}">–</td><td class="px-1 py-2 text-center text-slate-300 ${we}">–</td>`;
          } else {
            html += `<td class="border-l border-slate-100 px-1 py-2 text-center font-mono text-2xs ${isLateTime(r.in) ? 'font-semibold text-amber-700' : 'text-slate-700'} ${we}">${esc(r.in || '–')}</td>
              <td class="px-1 py-2 text-center font-mono text-2xs text-slate-700 ${we}">${esc(r.out || '–')}</td>`;
          }
        }
        return html + '</tr>';
      }).join('');
    }

    function updateGlobalStats() {
      let worked = 0, late = 0, absent = 0;
      filteredData.forEach(p => Object.values(p.attendance).forEach(r => {
        if (r.in || r.status === 'OFFICIAL') worked++;
        if (r.in && isLateTime(r.in)) late++;
        if (!r.isWeekend && !r.in && !r.status) absent++;
      }));
      $('statTotalEmps').textContent = fmt(filteredData.length);
      $('statCard2Label').textContent = 'วันปฏิบัติงานรวม';
      $('statTotalHours').textContent = fmt(worked);
      $('statTotalLate').textContent = fmt(late);
      $('statTotalAbsent').textContent = fmt(absent);
    }

    /* ---------------- Shared ---------------- */
    function applyFilters() {
      const dept = $('deptFilter').value;
      const search = $('nameSearch').value.trim().toLowerCase();
      const match = e => (!dept || e.dept === dept) && (!search || String(e.name).toLowerCase().includes(search) || String(e.id).includes(search));
      if (currentView === 'summary') {
        filteredSummaryData = rawSummaryData.filter(match);
        renderSummaryTableBody();
        updateSummaryStats();
        renderSummaryChart();
      } else {
        filteredData = rawData.filter(match);
        renderTableBody();
        updateGlobalStats();
      }
    }

    function exportToPDF() { window.print(); }

    function exportData() {
      if (typeof XLSX === 'undefined') return ERP.toast('โหลดไลบรารี Excel ไม่สำเร็จ', 'error');
      const monthStr = String(currentMonth).padStart(2, '0');
      let ws, filename;
      if (currentView === 'summary') {
        if (!filteredSummaryData.length) return ERP.toast('ไม่มีข้อมูลสำหรับส่งออก');
        filename = `รายงานสรุปรายเดือน_${currentYear}_${monthStr}.xlsx`;
        ws = XLSX.utils.json_to_sheet(filteredSummaryData.map(e => ({
          'รหัสพนักงาน': e.id, 'ชื่อ-นามสกุล': e.name, 'กลุ่มงาน/แผนก': e.dept, 'วันปฏิบัติงาน': e.daysPresent,
          'มาสาย (ครั้ง)': e.lateCount, 'ขาดงาน (วัน)': e.absentCount, 'วันลา (วัน)': e.leaveCount,
          'ค้างดำเนินการ (Overdue)': e.overdueCount || 0, 'สถานะ': e.status
        })));
      } else {
        if (!filteredData.length) return ERP.toast('ไม่มีข้อมูลสำหรับส่งออก');
        filename = `รายงานตารางสแกนรายละเอียด_${currentYear}_${monthStr}.xlsx`;
        const header = ['ชื่อ-นามสกุล', 'กลุ่มงาน'];
        for (let d = 1; d <= daysInMonth; d++) header.push(`${d} เข้า`, `${d} ออก`);
        const rows = filteredData.map(p => {
          const row = [p.name, p.dept];
          for (let d = 1; d <= daysInMonth; d++) {
            const r = p.attendance[dateKey(d)] || {};
            if (r.status === 'OFFICIAL') row.push(r.label, '');
            else row.push(r.in || '', r.out || '');
          }
          return row;
        });
        ws = XLSX.utils.aoa_to_sheet([header, ...rows]);
      }
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, 'รายงาน');
      XLSX.writeFile(wb, filename);
    }

    setView('summary');
  </script>
</body>

</html>
