<!DOCTYPE html>
<html lang="th">

<head>
  <%- include("components/erp-head", { title: "ภาพรวมการวิเคราะห์" }) %>
</head>

<body class="erp-page">
  <%- include("components/sidebar") %>
  <div class="main" role="main">
    <%- include("components/topbar") %>

    <div class="erp px-4 py-5 lg:px-6">
      <section class="mb-5 flex flex-wrap items-end justify-between gap-4 print:hidden" aria-labelledby="analytics-heading">
        <div>
          <h2 id="analytics-heading" class="text-xl font-semibold text-slate-900">ภาพรวมและแนวโน้มบุคลากร</h2>
          <p class="mt-1 text-[13px] text-slate-500">วิเคราะห์การมาปฏิบัติงาน มาสาย ขาดงาน และการลา รายเดือน เทียบกับเดือนก่อนหน้า</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <input type="month" id="monthInput" class="erp-input w-auto" aria-label="เลือกเดือน">
          <select id="reportDept" class="erp-input w-auto min-w-[180px] max-w-[260px]" aria-label="กรองตามกลุ่มงาน">
            <option value="">ทุกกลุ่มงาน</option>
          </select>
          <button type="button" class="erp-btn erp-btn-secondary" onclick="exportToExcel()"><i class="bi bi-download" aria-hidden="true"></i> ส่งออก CSV</button>
          <button type="button" class="erp-btn erp-btn-secondary" onclick="window.print()"><i class="bi bi-printer" aria-hidden="true"></i> พิมพ์ / PDF</button>
        </div>
      </section>

      <!-- KPIs with month-over-month delta -->
      <section class="erp-panel mb-5 grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 xl:divide-x xl:divide-slate-100" aria-label="ตัวชี้วัดหลัก">
        <% [['kStaff','บุคลากร','คน', ''],['kRate','อัตราการมาปฏิบัติงาน','%','up'],['kLate','มาสายรวม','ครั้ง','down'],
            ['kAbsent','ขาดงานรวม','วัน','down'],['kLeave','วันลารวม','วัน',''],['kWatch','ต้องติดตาม','คน','down']].forEach(([id, label, unit, good]) => { %>
          <div class="p-4">
            <div class="truncate text-xs text-slate-500"><%= label %></div>
            <div class="mt-1 flex items-baseline gap-1">
              <span id="<%= id %>" class="font-mono text-2xl font-semibold tabular-nums text-slate-900">–</span>
              <span class="text-2xs text-slate-400"><%= unit %></span>
            </div>
            <div id="<%= id %>Delta" data-good="<%= good %>" class="mt-0.5 h-4 text-2xs text-slate-400"></div>
          </div>
        <% }); %>
      </section>

      <div class="mb-5 grid grid-cols-1 items-start gap-5 xl:grid-cols-5">
        <!-- Department comparison -->
        <section class="erp-panel xl:col-span-3" aria-labelledby="deptChartTitle">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-4 py-3">
            <div>
              <h3 id="deptChartTitle" class="text-[13px] font-semibold text-slate-800">มาสาย / ขาดงาน แยกตามกลุ่มงาน</h3>
              <p class="text-2xs text-slate-400">จำนวนครั้งรวมในเดือนที่เลือก · เรียงจากมากไปน้อย</p>
            </div>
            <ul class="m-0 flex list-none gap-4 p-0 text-xs text-slate-600">
              <li class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-[#F59E0B]"></span>มาสาย</li>
              <li class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-[#DC2626]"></span>ขาดงาน</li>
            </ul>
          </div>
          <div id="deptChart" class="space-y-3 p-4"></div>
        </section>

        <!-- Status mix -->
        <section class="erp-panel xl:col-span-2" aria-labelledby="mixTitle">
          <div class="border-b border-slate-200 px-4 py-3">
            <h3 id="mixTitle" class="text-[13px] font-semibold text-slate-800">สถานะบุคลากรประจำเดือน</h3>
            <p class="text-2xs text-slate-400">ประเมินจากเกณฑ์ในรายงานรายเดือน</p>
          </div>
          <div class="p-4">
            <div id="mixBar" class="flex h-3 gap-[2px] overflow-hidden rounded bg-slate-100" role="img" aria-label="สัดส่วนสถานะบุคลากร"></div>
            <ul id="mixLegend" class="m-0 mt-3 list-none space-y-2 p-0 text-xs"></ul>
            <p class="mt-4 rounded-md bg-slate-50 p-3 text-2xs leading-relaxed text-slate-500">
              <strong class="text-slate-700">ต้องปรับปรุง</strong> = ขาดงานอย่างน้อย 1 วัน หรือมาสายเกิน 3 ครั้ง ·
              <strong class="text-slate-700">รอดำเนินการ</strong> = มีรายการค้างส่งเหตุผลเกินกำหนด
            </p>
          </div>
        </section>
      </div>

      <div class="mb-5 grid grid-cols-1 items-start gap-5 lg:grid-cols-2">
        <section class="erp-panel" aria-labelledby="topLateTitle">
          <div class="border-b border-slate-200 px-4 py-3">
            <h3 id="topLateTitle" class="text-[13px] font-semibold text-slate-800">มาสายบ่อยที่สุด 10 อันดับ</h3>
          </div>
          <ol id="topLate" class="m-0 list-none space-y-2.5 p-4"></ol>
        </section>
        <section class="erp-panel" aria-labelledby="topAbsentTitle">
          <div class="border-b border-slate-200 px-4 py-3">
            <h3 id="topAbsentTitle" class="text-[13px] font-semibold text-slate-800">ขาดงานบ่อยที่สุด 10 อันดับ</h3>
          </div>
          <ol id="topAbsent" class="m-0 list-none space-y-2.5 p-4"></ol>
        </section>
      </div>

      <!-- Per-person table -->
      <section class="erp-panel overflow-hidden" aria-labelledby="tableTitle">
        <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 p-3">
          <h3 id="tableTitle" class="mr-auto px-1 text-[13px] font-semibold text-slate-800">สรุปรายบุคคล</h3>
          <select id="statusFilter" class="erp-input w-auto" onchange="renderTable()" aria-label="กรองตามสถานะ">
            <option value="">ทุกสถานะ</option>
            <option value="ปกติ">ปกติ</option>
            <option value="ต้องปรับปรุง">ต้องปรับปรุง</option>
            <option value="รอดำเนินการ (Overdue)">รอดำเนินการ</option>
          </select>
          <div class="relative min-w-[220px] sm:w-72">
            <i class="bi bi-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
            <input type="search" id="tableSearch" class="erp-input pl-9" placeholder="ค้นหาชื่อ หรือ รหัส…" oninput="renderTable()" aria-label="ค้นหา">
          </div>
        </div>
        <div class="max-h-[70vh] overflow-auto">
          <table class="w-full border-collapse text-left text-[13px]">
            <thead class="sticky top-0 z-10 bg-slate-50 text-2xs uppercase tracking-wide text-slate-500">
              <tr class="border-b border-slate-200">
                <th class="px-4 py-2.5 font-semibold"><button type="button" class="uppercase hover:text-slate-800" data-sort="name">บุคลากร <i class="bi bi-arrow-down-up text-[10px]"></i></button></th>
                <th class="px-3 py-2.5 font-semibold"><button type="button" class="uppercase hover:text-slate-800" data-sort="dept">กลุ่มงาน <i class="bi bi-arrow-down-up text-[10px]"></i></button></th>
                <th class="px-3 py-2.5 text-right font-semibold"><button type="button" class="uppercase hover:text-slate-800" data-sort="daysPresent">มาทำงาน <i class="bi bi-arrow-down-up text-[10px]"></i></button></th>
                <th class="px-3 py-2.5 text-right font-semibold"><button type="button" class="uppercase hover:text-slate-800" data-sort="lateCount">สาย <i class="bi bi-arrow-down-up text-[10px]"></i></button></th>
                <th class="px-3 py-2.5 text-right font-semibold"><button type="button" class="uppercase hover:text-slate-800" data-sort="absentCount">ขาด <i class="bi bi-arrow-down-up text-[10px]"></i></button></th>
                <th class="px-3 py-2.5 text-right font-semibold"><button type="button" class="uppercase hover:text-slate-800" data-sort="leaveCount">ลา <i class="bi bi-arrow-down-up text-[10px]"></i></button></th>
                <th class="px-3 py-2.5 text-right font-semibold">ค้างส่ง</th>
                <th class="px-4 py-2.5 font-semibold">สถานะ</th>
              </tr>
            </thead>
            <tbody id="reportTableBody" class="divide-y divide-slate-100">
              <tr><td colspan="8" class="px-4 py-16 text-center text-slate-400"><i class="bi bi-hourglass-split mr-1"></i> กำลังโหลดข้อมูล…</td></tr>
            </tbody>
          </table>
        </div>
        <div class="border-t border-slate-200 bg-slate-50/70 px-4 py-2.5 text-xs text-slate-500" id="tableFoot"></div>
      </section>
    </div>
  </div>

  <div id="chartTip" class="erp pointer-events-none fixed z-[10003] hidden rounded-md bg-slate-900 px-2.5 py-1.5 text-xs text-white shadow-lg"></div>

  <script>
    const LATE_COLOR = '#F59E0B';
    const ABSENT_COLOR = '#DC2626';
    const STATUS_META = {
      'ปกติ': ['ปกติ', 'green', '#10B981'],
      'ต้องปรับปรุง': ['ต้องปรับปรุง', 'red', '#DC2626'],
      'รอดำเนินการ (Overdue)': ['รอดำเนินการ', 'amber', '#F59E0B']
    };
    const $ = id => document.getElementById(id);
    const esc = ERP.escapeHtml;
    const fmt = n => Number(n || 0).toLocaleString('th-TH');

    let current = [];
    let previous = [];
    let sortKey = 'lateCount';
    let sortDir = -1;

    const monthParts = v => { const [y, m] = v.split('-').map(Number); return { year: y, month: m }; };
    const prevMonth = ({ year, month }) => (month === 1 ? { year: year - 1, month: 12 } : { year, month: month - 1 });

    async function fetchMonth({ year, month }) {
      const res = await fetch(`/api/report/monthly?month=${month}&year=${year}`, { headers: { Accept: 'application/json' } });
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'failed');
      return data.report || [];
    }

    async function reloadAnalytics() {
      const target = monthParts($('monthInput').value);
      $('reportTableBody').innerHTML = '<tr><td colspan="8" class="px-4 py-16 text-center text-slate-400">กำลังประมวลผล…</td></tr>';
      try {
        [current, previous] = await Promise.all([fetchMonth(target), fetchMonth(prevMonth(target)).catch(() => [])]);
        ERP.fillSelect($('reportDept'), ERP.uniqueSorted(current, 'dept'));
        render();
      } catch (err) {
        console.error(err);
        $('reportTableBody').innerHTML = ERP.emptyRow(8, 'โหลดข้อมูลไม่สำเร็จ', 'bi-exclamation-triangle');
      }
    }
    const loadData = reloadAnalytics;

    const scoped = list => { const d = $('reportDept').value; return d ? list.filter(p => p.dept === d) : list; };

    function summarize(list) {
      const sum = k => list.reduce((a, p) => a + (Number(p[k]) || 0), 0);
      const present = sum('daysPresent');
      const absent = sum('absentCount');
      return {
        staff: list.length,
        rate: present + absent > 0 ? (present / (present + absent)) * 100 : null,
        late: sum('lateCount'),
        absent,
        leave: sum('leaveCount'),
        watch: list.filter(p => p.status && p.status !== 'ปกติ').length
      };
    }

    function setDelta(id, cur, prev, isPct) {
      const el = $(id + 'Delta');
      if (cur == null || prev == null || !previous.length) { el.textContent = ''; return; }
      const diff = cur - prev;
      if (Math.abs(diff) < (isPct ? 0.05 : 0.5)) { el.innerHTML = '<span class="text-slate-400">เท่าเดือนก่อน</span>'; return; }
      const good = el.dataset.good;
      const better = good === 'up' ? diff > 0 : good === 'down' ? diff < 0 : null;
      const tone = better == null ? 'text-slate-500' : better ? 'text-emerald-700' : 'text-red-600';
      const arrow = diff > 0 ? 'bi-arrow-up-right' : 'bi-arrow-down-right';
      const val = isPct ? `${Math.abs(diff).toFixed(1)} จุด` : fmt(Math.abs(diff));
      el.innerHTML = `<span class="${tone}"><i class="bi ${arrow}"></i> ${val}</span> <span class="text-slate-400">vs เดือนก่อน</span>`;
    }

    function renderKpis() {
      const c = summarize(scoped(current));
      const p = summarize(scoped(previous));
      $('kStaff').textContent = fmt(c.staff);
      $('kRate').textContent = c.rate == null ? '–' : c.rate.toFixed(1);
      $('kLate').textContent = fmt(c.late);
      $('kAbsent').textContent = fmt(c.absent);
      $('kLeave').textContent = fmt(c.leave);
      $('kWatch').textContent = fmt(c.watch);
      setDelta('kStaff', c.staff, p.staff);
      setDelta('kRate', c.rate, p.rate, true);
      setDelta('kLate', c.late, p.late);
      setDelta('kAbsent', c.absent, p.absent);
      setDelta('kLeave', c.leave, p.leave);
      setDelta('kWatch', c.watch, p.watch);
    }

    function renderDeptChart() {
      const byDept = new Map();
      scoped(current).forEach(p => {
        const d = byDept.get(p.dept) || { dept: p.dept, late: 0, absent: 0, staff: 0 };
        d.late += Number(p.lateCount) || 0;
        d.absent += Number(p.absentCount) || 0;
        d.staff += 1;
        byDept.set(p.dept, d);
      });
      const rows = [...byDept.values()].sort((a, b) => (b.late + b.absent) - (a.late + a.absent)).slice(0, 12);
      const max = Math.max(1, ...rows.map(r => r.late + r.absent));
      $('deptChart').innerHTML = rows.length && rows.some(r => r.late + r.absent > 0)
        ? rows.map(r => `
          <div data-tip="${esc(r.dept)}<br>มาสาย ${fmt(r.late)} ครั้ง · ขาดงาน ${fmt(r.absent)} วัน · บุคลากร ${fmt(r.staff)} คน">
            <div class="mb-1 flex items-baseline justify-between gap-3 text-xs">
              <span class="truncate text-slate-700">${esc(String(r.dept).replace(/^กลุ่มงาน/, ''))}</span>
              <span class="shrink-0 font-mono text-slate-600">${fmt(r.late)} <span class="text-slate-300">/</span> ${fmt(r.absent)}</span>
            </div>
            <div class="flex h-2.5 gap-[2px]" style="width:${((r.late + r.absent) / max) * 100}%">
              ${r.late ? `<div class="h-full rounded-l-sm ${r.absent ? '' : 'rounded-r-sm'}" style="flex:${r.late};background:${LATE_COLOR}"></div>` : ''}
              ${r.absent ? `<div class="h-full rounded-r-sm ${r.late ? '' : 'rounded-l-sm'}" style="flex:${r.absent};background:${ABSENT_COLOR}"></div>` : ''}
            </div>
          </div>`).join('')
        : '<p class="py-8 text-center text-xs text-slate-400">ไม่มีการมาสายหรือขาดงานในเดือนนี้</p>';
    }

    function renderMix() {
      const list = scoped(current);
      const total = list.length;
      const entries = Object.entries(STATUS_META).map(([k, meta]) => ({ k, meta, n: list.filter(p => (p.status || 'ปกติ') === k).length }));
      $('mixBar').innerHTML = entries.filter(e => e.n).map(e =>
        `<div class="h-full" style="flex:${e.n};background:${e.meta[2]}" data-tip="${esc(e.meta[0])} · ${fmt(e.n)} คน"></div>`).join('');
      $('mixLegend').innerHTML = entries.map(e => `
        <li class="flex items-center justify-between gap-3">
          <span class="flex items-center gap-2 text-slate-600"><span class="h-2.5 w-2.5 rounded-sm" style="background:${e.meta[2]}"></span>${esc(e.meta[0])}</span>
          <span class="font-mono text-slate-800"><span class="font-semibold">${fmt(e.n)}</span> <span class="text-slate-400">${total ? Math.round((e.n / total) * 100) : 0}%</span></span>
        </li>`).join('');
    }

    function renderTop(elId, field, color, unit) {
      const rows = scoped(current).filter(p => Number(p[field]) > 0).sort((a, b) => b[field] - a[field]).slice(0, 10);
      const max = Math.max(1, ...rows.map(r => r[field]));
      $(elId).innerHTML = rows.length
        ? rows.map((r, i) => `
          <li class="flex items-center gap-3">
            <span class="w-5 shrink-0 text-right font-mono text-2xs text-slate-400">${i + 1}</span>
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline justify-between gap-2 text-xs">
                <span class="truncate font-medium text-slate-800">${esc(r.name)}</span>
                <span class="shrink-0 font-mono text-slate-700">${fmt(r[field])} ${unit}</span>
              </div>
              <div class="mt-1 flex items-center gap-2">
                <div class="h-1.5 rounded-sm" style="width:${(r[field] / max) * 100}%;background:${color}"></div>
              </div>
              <div class="truncate text-2xs text-slate-400">${esc(r.dept)}</div>
            </div>
          </li>`).join('')
        : '<li class="py-8 text-center text-xs text-slate-400">ไม่มีรายการ</li>';
    }

    function renderTable() {
      const q = $('tableSearch').value.trim().toLowerCase();
      const st = $('statusFilter').value;
      const rows = scoped(current)
        .filter(p => (!st || (p.status || 'ปกติ') === st) && (!q || `${p.name} ${p.id}`.toLowerCase().includes(q)))
        .sort((a, b) => {
          const x = a[sortKey], y = b[sortKey];
          return (typeof x === 'number' && typeof y === 'number' ? x - y : String(x || '').localeCompare(String(y || ''), 'th')) * sortDir;
        });
      $('tableFoot').textContent = `ทั้งหมด ${fmt(rows.length)} คน`;
      if (!rows.length) { $('reportTableBody').innerHTML = ERP.emptyRow(8, 'ไม่พบข้อมูล'); return; }
      const num = (v, warn) => `<td class="px-3 py-2.5 text-right font-mono text-xs ${Number(v) ? (warn || 'text-slate-800') : 'text-slate-300'}">${Number(v) ? fmt(v) : '–'}</td>`;
      $('reportTableBody').innerHTML = rows.map(p => {
        const [label, tone] = STATUS_META[p.status] || [p.status || 'ปกติ', 'slate'];
        return `<tr class="hover:bg-slate-50">
          <td class="px-4 py-2.5"><div class="flex items-center gap-2.5">${ERP.avatar(p.name, p.id)}
            <div class="min-w-0"><div class="truncate font-medium text-slate-900">${esc(p.name)}</div><div class="font-mono text-2xs text-slate-400">${esc(p.id)}</div></div></div></td>
          <td class="max-w-[220px] px-3 py-2.5"><div class="truncate text-slate-600" title="${esc(p.dept)}">${esc(p.dept)}</div></td>
          ${num(p.daysPresent)}
          ${num(p.lateCount, Number(p.lateCount) > 3 ? 'font-semibold text-amber-700' : 'text-slate-800')}
          ${num(p.absentCount, 'font-semibold text-red-600')}
          ${num(p.leaveCount)}
          ${num(p.overdueCount, 'text-amber-700')}
          <td class="px-4 py-2.5">${ERP.badge(label, tone)}</td>
        </tr>`;
      }).join('');
    }

    function render() {
      renderKpis();
      renderDeptChart();
      renderMix();
      renderTop('topLate', 'lateCount', LATE_COLOR, 'ครั้ง');
      renderTop('topAbsent', 'absentCount', ABSENT_COLOR, 'วัน');
      renderTable();
    }

    function exportToExcel() {
      const rows = scoped(current);
      if (!rows.length) return ERP.toast('ไม่มีข้อมูลสำหรับส่งออก');
      ERP.downloadCsv(`KHH_Analytics_${$('monthInput').value}.csv`,
        ['รหัส', 'ชื่อ-นามสกุล', 'กลุ่มงาน', 'วันมาทำงาน', 'มาสาย (ครั้ง)', 'ขาดงาน (วัน)', 'วันลา', 'ค้างส่งเหตุผล', 'สถานะ'],
        rows.map(p => [p.id, p.name, p.dept, p.daysPresent, p.lateCount, p.absentCount, p.leaveCount, p.overdueCount, p.status]));
    }

    // Tooltip for chart marks
    document.addEventListener('mousemove', e => {
      const tip = $('chartTip');
      const target = e.target.closest('[data-tip]');
      if (!target) { tip.classList.add('hidden'); return; }
      tip.innerHTML = target.dataset.tip;
      tip.classList.remove('hidden');
      tip.style.left = Math.min(e.clientX + 12, window.innerWidth - tip.offsetWidth - 8) + 'px';
      tip.style.top = (e.clientY + 14) + 'px';
    });

    document.querySelectorAll('[data-sort]').forEach(btn => btn.addEventListener('click', () => {
      const k = btn.dataset.sort;
      sortDir = sortKey === k ? -sortDir : (['name', 'dept'].includes(k) ? 1 : -1);
      sortKey = k;
      renderTable();
    }));

    $('reportDept').addEventListener('change', render);
    $('monthInput').addEventListener('change', reloadAnalytics);
    $('monthInput').value = ERP.todayIso().slice(0, 7);
    $('monthInput').max = ERP.todayIso().slice(0, 7);
    reloadAnalytics();
  </script>
</body>

</html>
