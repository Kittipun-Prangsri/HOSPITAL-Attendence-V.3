<%# Shared <head> for Tailwind ERP pages. Usage: include("components/erp-head", { title: "…" }) %>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="csrf-token" content="<%= locals.csrfToken || '' %>" />
<title><%= locals.title ? title + ' · KHH HRM' : 'KHH HRM' %></title>
<%- include('favicon') %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
<link rel="stylesheet" href="<%= asset('/css/erp.css') %>" />
<script src="<%= asset('/js/erp-ui.js') %>"></script>
