<%
  const currentRoute = typeof activeRoute !== 'undefined' ? activeRoute : '/';
  const match = locals.navMatch || null;
  let pageTitle = match ? match.item.label : 'แดชบอร์ด';
  if (currentRoute.startsWith('/department/')) {
    pageTitle = typeof deptName !== 'undefined' && deptName ? deptName : 'ข้อมูลตามกลุ่มงาน';
  }
  const crumbs = [];
  if (match && currentRoute !== '/') {
    crumbs.push(match.section);
    if (match.group) crumbs.push(match.group);
  }
  const topbarName = locals.user && user.fullname ? user.fullname : 'ผู้ใช้งาน';
%>

<!-- TOPBAR -->
<header class="erp erp-topbar" role="banner">
  <button type="button" class="erp-icon-btn lg:hidden" onclick="toggleGlobalSidebar()" aria-label="เปิดหรือปิดเมนูนำทาง" aria-controls="sidebar">
    <i class="bi bi-list" aria-hidden="true"></i>
  </button>

  <div class="min-w-0 flex-1">
    <nav aria-label="breadcrumb" class="hidden sm:block">
      <ol class="m-0 flex list-none items-center gap-1.5 p-0 text-2xs text-slate-400">
        <li><a href="/" class="text-slate-400 hover:text-brand-600"><i class="bi bi-house-door" aria-hidden="true"></i> หน้าหลัก</a></li>
        <% crumbs.forEach(c => { %>
          <li class="flex items-center gap-1.5"><i class="bi bi-chevron-right text-[9px]" aria-hidden="true"></i><span><%= c %></span></li>
        <% }); %>
      </ol>
    </nav>
    <div class="flex min-w-0 items-baseline gap-3">
      <h1 id="page-title" class="truncate text-[15px] font-semibold leading-tight text-slate-900"><%= pageTitle %></h1>
      <small id="currentDate" class="hidden truncate text-2xs text-slate-400 md:inline" aria-live="polite">กำลังโหลด...</small>
    </div>
  </div>

  <button type="button" onclick="openCommandMenu()"
    class="hidden h-9 w-64 items-center gap-2 rounded-md border border-slate-200 bg-slate-50 px-3 text-left text-[13px] text-slate-400 transition-colors hover:border-slate-300 hover:bg-white md:flex"
    aria-label="ค้นหาเมนู">
    <i class="bi bi-search" aria-hidden="true"></i>
    <span class="flex-1">ค้นหาเมนู…</span>
    <kbd class="erp-kbd">⌘K</kbd>
  </button>

  <div class="flex items-center gap-1">
    <span class="mr-1 hidden items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-2xs font-medium text-emerald-700 ring-1 ring-emerald-100 sm:inline-flex" role="status">
      <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span></span>
      ออนไลน์
    </span>
    <button type="button" class="erp-icon-btn md:hidden" onclick="openCommandMenu()" title="ค้นหาเมนู" aria-label="ค้นหาเมนู"><i class="bi bi-search" aria-hidden="true"></i></button>
    <div class="relative" id="inboxWrap">
      <button type="button" id="inboxBtn" class="erp-icon-btn relative" title="แจ้งเตือน" aria-label="แจ้งเตือน" aria-haspopup="true" aria-expanded="false" aria-controls="inboxPanel">
        <i class="bi bi-bell" aria-hidden="true"></i>
        <span id="inboxBadge" class="absolute right-1 top-1 hidden min-w-[16px] rounded-full bg-red-600 px-1 text-center font-mono text-[10px] font-semibold leading-4 text-white"></span>
      </button>
      <div id="inboxPanel" class="absolute right-0 top-11 z-[200] hidden w-[360px] max-w-[calc(100vw-24px)] overflow-hidden rounded-lg bg-white shadow-2xl ring-1 ring-slate-200" role="menu" aria-label="การแจ้งเตือน">
        <div class="flex items-center justify-between border-b border-slate-200 px-4 py-2.5">
          <span class="text-[13px] font-semibold text-slate-800">การแจ้งเตือน</span>
          <button type="button" class="text-2xs text-brand-700 hover:underline" onclick="loadInbox()">รีเฟรช</button>
        </div>
        <ul id="inboxList" class="m-0 max-h-[60vh] list-none divide-y divide-slate-100 overflow-y-auto p-0">
          <li class="px-4 py-8 text-center text-xs text-slate-400">กำลังโหลด…</li>
        </ul>
      </div>
    </div>
    <button type="button" class="erp-icon-btn" title="รีเฟรชข้อมูล" aria-label="รีเฟรชข้อมูล"
      onclick="typeof refreshData === 'function' ? refreshData(this) : (typeof loadData === 'function' ? loadData() : location.reload())"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button>
    <button type="button" class="erp-icon-btn" title="ตั้งค่า" aria-label="ตั้งค่า" onclick="openSettings()"><i class="bi bi-gear" aria-hidden="true"></i></button>
    <span class="mx-1 hidden h-6 w-px bg-slate-200 sm:block" aria-hidden="true"></span>
    <div class="hidden h-8 w-8 items-center justify-center rounded-md bg-brand-600 text-[13px] font-semibold text-white sm:flex" title="<%= topbarName %>" aria-hidden="true">
      <%= topbarName.charAt(0).toUpperCase() %>
    </div>
  </div>
</header>

<!-- QUICK MENU SEARCH (⌘K / Ctrl+K) -->
<div id="commandMenu" class="erp fixed inset-0 z-[10001] hidden items-start justify-center bg-slate-900/40 px-4 pb-4 backdrop-blur-sm" style="padding-top:12vh;" role="dialog" aria-modal="true" aria-label="ค้นหาเมนู">
  <div class="w-full max-w-lg overflow-hidden rounded-lg bg-white shadow-2xl ring-1 ring-slate-200">
    <div class="flex items-center gap-3 border-b border-slate-200 px-4">
      <i class="bi bi-search text-slate-400" aria-hidden="true"></i>
      <input id="commandInput" type="text" autocomplete="off" placeholder="พิมพ์ชื่อเมนู เช่น บุคลากร, รายงาน…"
        class="h-12 flex-1 border-0 bg-transparent text-sm text-slate-800 placeholder:text-slate-400 !shadow-none !outline-none" style="font-family:inherit;">
      <kbd class="erp-kbd">Esc</kbd>
    </div>
    <ul id="commandList" class="m-0 max-h-80 list-none overflow-y-auto p-2" role="listbox"></ul>
  </div>
</div>

<script>
  function toggleGlobalSidebar() {
    const sidebar = document.getElementById('sidebar');
    const main = document.querySelector('.main');
    const overlay = document.getElementById('sidebar-overlay');
    const toggles = document.querySelectorAll('[aria-controls="sidebar"]');

    if (window.innerWidth < 992) {
      sidebar.classList.toggle('mobile-active');
      if (overlay) overlay.classList.toggle('active');
      document.body.classList.toggle('sidebar-open', sidebar.classList.contains('mobile-active'));
      toggles.forEach(button => button.setAttribute('aria-expanded', String(sidebar.classList.contains('mobile-active'))));
    } else {
      if (sidebar) sidebar.classList.toggle('collapsed');
      if (main) main.classList.toggle('expanded');
      const expanded = !sidebar.classList.contains('collapsed');
      toggles.forEach(button => button.setAttribute('aria-expanded', String(expanded)));
      localStorage.setItem('khhSidebarCollapsed', String(!expanded));
    }
  }

  // Restore collapsed state immediately (script runs after sidebar markup) to avoid a layout jump
  (function restoreSidebar() {
    try {
      if (window.innerWidth >= 992 && localStorage.getItem('khhSidebarCollapsed') === 'true') {
        const sidebar = document.getElementById('sidebar');
        const main = document.querySelector('.main');
        if (sidebar) sidebar.classList.add('collapsed');
        if (main) main.classList.add('expanded');
        document.querySelectorAll('[aria-controls="sidebar"]').forEach(button => button.setAttribute('aria-expanded', 'false'));
      }
    } catch (e) { /* storage unavailable */ }
  })();

  /* ---------- Quick menu search ---------- */
  (function initCommandMenu() {
    const menu = document.getElementById('commandMenu');
    const input = document.getElementById('commandInput');
    const list = document.getElementById('commandList');
    let items = [];
    let cursor = 0;

    function collect() {
      items = Array.from(document.querySelectorAll('#sidebar [data-nav-label]')).map(a => ({
        href: a.getAttribute('href'),
        label: a.dataset.navLabel,
        section: a.dataset.navSection,
        icon: (a.querySelector('i.bi') || {}).className || 'bi bi-dot'
      }));
    }

    function render() {
      const q = input.value.trim().toLowerCase();
      const hits = items.filter(i => !q || (i.label + ' ' + i.section).toLowerCase().includes(q));
      cursor = Math.min(cursor, Math.max(hits.length - 1, 0));
      list.innerHTML = '';
      if (!hits.length) {
        list.innerHTML = '<li class="px-3 py-6 text-center text-[13px] text-slate-400">ไม่พบเมนูที่ค้นหา</li>';
        return;
      }
      hits.forEach((hit, idx) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = hit.href;
        a.setAttribute('role', 'option');
        a.className = 'flex items-center gap-3 rounded-md px-3 py-2 text-[13px] ' +
          (idx === cursor ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50');
        const icon = document.createElement('i');
        icon.className = hit.icon + ' w-5 text-center text-slate-400';
        const label = document.createElement('span');
        label.className = 'flex-1';
        label.textContent = hit.label;
        const section = document.createElement('span');
        section.className = 'text-2xs text-slate-400';
        section.textContent = hit.section;
        a.append(icon, label, section);
        li.appendChild(a);
        list.appendChild(li);
      });
    }

    window.openCommandMenu = function () {
      collect();
      cursor = 0;
      input.value = '';
      render();
      menu.classList.remove('hidden');
      menu.classList.add('flex');
      setTimeout(() => input.focus(), 0);
    };

    window.closeCommandMenu = function () {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
    };

    input.addEventListener('input', () => { cursor = 0; render(); });
    input.addEventListener('keydown', e => {
      const links = list.querySelectorAll('a');
      if (e.key === 'ArrowDown') { e.preventDefault(); cursor = Math.min(cursor + 1, links.length - 1); render(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); cursor = Math.max(cursor - 1, 0); render(); }
      else if (e.key === 'Enter' && links[cursor]) { window.location.href = links[cursor].href; }
    });
    menu.addEventListener('click', e => { if (e.target === menu) window.closeCommandMenu(); });
    document.addEventListener('keydown', e => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); window.openCommandMenu(); }
      else if (e.key === 'Escape' && !menu.classList.contains('hidden')) window.closeCommandMenu();
    });
  })();

  /* ---------- Notification inbox (bell) ---------- */
  (function initInbox() {
    const btn = document.getElementById('inboxBtn');
    const panel = document.getElementById('inboxPanel');
    const list = document.getElementById('inboxList');
    const badge = document.getElementById('inboxBadge');
    const TONE = { amber: 'bg-amber-50 text-amber-600', brand: 'bg-brand-50 text-brand-600', red: 'bg-red-50 text-red-600', green: 'bg-emerald-50 text-emerald-600' };
    const esc = v => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    const ago = t => {
      if (!t) return '';
      const mins = Math.round((Date.now() - new Date(t)) / 60000);
      if (mins < 1) return 'เมื่อสักครู่';
      if (mins < 60) return `${mins} นาทีที่แล้ว`;
      if (mins < 1440) return `${Math.round(mins / 60)} ชั่วโมงที่แล้ว`;
      return `${Math.round(mins / 1440)} วันที่แล้ว`;
    };

    window.loadInbox = async function () {
      try {
        const res = await fetch('/api/notifications/inbox', { headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(res.status);
        const data = await res.json();
        const n = Number(data.badge) || 0;
        badge.textContent = n > 99 ? '99+' : n;
        badge.classList.toggle('hidden', n === 0);
        btn.setAttribute('aria-label', n ? `แจ้งเตือน ${n} รายการ` : 'แจ้งเตือน');
        const items = data.items || [];
        list.innerHTML = items.length
          ? items.map(i => `<li><a href="${esc(i.href)}" class="flex items-start gap-3 px-4 py-3 hover:bg-slate-50" role="menuitem">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-md ${TONE[i.tone] || TONE.amber}"><i class="bi ${esc(i.icon)}"></i></span>
              <span class="min-w-0 flex-1">
                <span class="block text-[13px] font-medium text-slate-800">${esc(i.title)}</span>
                <span class="block truncate text-2xs text-slate-500">${esc(i.desc)}</span>
                <span class="block text-2xs text-slate-400">${esc(ago(i.time))}</span>
              </span></a></li>`).join('')
          : '<li class="px-4 py-10 text-center text-xs text-slate-400"><i class="bi bi-check2-circle mb-1 block text-xl text-emerald-500"></i>ไม่มีรายการที่ต้องดำเนินการ</li>';
      } catch (err) {
        list.innerHTML = '<li class="px-4 py-8 text-center text-xs text-slate-400">โหลดการแจ้งเตือนไม่สำเร็จ</li>';
      }
    };

    const toggle = open => {
      panel.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      if (open) window.loadInbox();
    };
    btn.addEventListener('click', e => { e.stopPropagation(); toggle(panel.classList.contains('hidden')); });
    document.addEventListener('click', e => { if (!e.target.closest('#inboxWrap')) toggle(false); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') toggle(false); });
    window.loadInbox();
    setInterval(() => { if (!document.hidden) window.loadInbox(); }, 60000);
  })();

  // Live ticking clock for topbar
  function initTopbarClock() {
    const dateEl = document.getElementById('currentDate');
    if (!dateEl) return;

    window.updateTopbarClock = function() {
      const now = new Date();

      // Check if we are on dashboard and a different date is selected
      const dateInput = document.getElementById('dateInput');
      if (dateInput && dateInput.value) {
        const y = now.getFullYear();
        const m = String(now.getMonth() + 1).padStart(2, '0');
        const d = String(now.getDate()).padStart(2, '0');
        const todayStr = `${y}-${m}-${d}`;

        if (dateInput.value !== todayStr) {
          const selectedDate = new Date(dateInput.value);
          if (window.innerWidth < 768) {
            dateEl.textContent = "วันที่: " + selectedDate.toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: '2-digit' });
          } else {
            dateEl.textContent = "ข้อมูลของวันที่: " + selectedDate.toLocaleDateString('th-TH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
          }
          return;
        }
      }

      if (window.innerWidth < 768) {
        const datePart = now.toLocaleDateString('th-TH', { day: 'numeric', month: 'short' });
        const timePart = now.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
        dateEl.textContent = `${datePart} | ${timePart} น.`;
      } else {
        const datePart = now.toLocaleDateString('th-TH', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        const timePart = now.toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        dateEl.textContent = `${datePart} · ${timePart} น.`;
      }
    };

    window.updateTopbarClock();
    setInterval(window.updateTopbarClock, 1000);
  }
  initTopbarClock();

  // Dashboard Initialization: Store User Role from Session to localStorage
  const sessionRole = "<%= (locals.user && user.role) ? user.role : 'staff' %>";
  localStorage.setItem('userRole', sessionRole);
  const CURRENT_ROLE = localStorage.getItem('userRole');
  const CURRENT_USER_ID = "<%= (locals.user && user.username) ? user.username : '' %>";

  const RBAC_ENABLED = true; // เปิดระบบ RBAC แล้ว
  console.log('Current User Role:', CURRENT_ROLE, '| User ID:', CURRENT_USER_ID, '| RBAC_ENABLED:', RBAC_ENABLED);

  // Load appPermissions from localStorage
  const appPermissions = JSON.parse(localStorage.getItem('APP_PERMISSIONS')) || {
    admin: ['view_dashboard', 'view_phone', 'view_email', 'edit_staff', 'delete_staff', 'manage_permissions'],
    staff: ['view_dashboard'],
    user: ['view_dashboard']
  };

  // Global Check Permission
  function checkPermission(capability) {
    if (!RBAC_ENABLED) return true;
    if (CURRENT_ROLE === 'admin' || CURRENT_ROLE === 'super') return true;
    return appPermissions[CURRENT_ROLE] && appPermissions[CURRENT_ROLE].includes(capability);
  }

  // Enforce UI restrictions based on role
  document.addEventListener("DOMContentLoaded", () => {
     if (CURRENT_ROLE === 'staff' || CURRENT_ROLE === 'user') {
         // Disable settings menu icon in topbar
         const settingsBtn = document.querySelector('[onclick="openSettings()"]');
         if(settingsBtn) {
             settingsBtn.style.pointerEvents = 'none';
             settingsBtn.style.opacity = '0.5';
         }
     }
  });

  function maskSensitiveData(str, capability, dataOwnerId) {
    if (!RBAC_ENABLED) return str;
    if (!str || str === '-') return '-';
    // Owner of the data sees everything
    if (dataOwnerId && String(dataOwnerId) === String(CURRENT_USER_ID)) return str;
    // Admin sees everything
    if (checkPermission(capability)) return str;

    // Masking phone example: 09xxxx
    if (capability === 'view_phone') {
        return str.substring(0, 2) + '*'.repeat(Math.max(0, str.length - 2));
    }
    // Masking email: ITx****@hotmail.com
    if (capability === 'view_email') {
        const parts = str.split('@');
        if(parts.length === 2) {
           return parts[0].substring(0, 2) + '***@' + parts[1];
        }
        return '********';
    }
    // Masking Name: นาย xxx
    if (capability === 'view_name') {
        const titles = ['นายแพทย์', 'พญ.', 'นพ.', 'นาย', 'นางสาว', 'นาง'];
        let title = '';
        let bareName = str;
        for (let t of titles) {
            if (str.startsWith(t)) {
                title = t + ' ';
                bareName = str.substring(t.length).trim();
                break;
            }
        }
        return title + 'x'.repeat(bareName.length > 0 ? bareName.length : 3);
    }
    // Masking ID: KHH00023 -> ***
    if (capability === 'view_id') {
        return '***';
    }

    return '********';
  }
</script>

<!-- ========================================================
     SETTINGS MODAL
     ======================================================== -->
<div id="settingsModal" class="erp fixed inset-0 z-[9999] items-center justify-center bg-slate-900/50 p-4 backdrop-blur-sm" style="display:none;">
  <div class="flex max-h-[90vh] w-[660px] max-w-full flex-col overflow-hidden rounded-lg bg-white shadow-2xl ring-1 ring-slate-200">

    <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-md bg-brand-50 text-brand-600"><i class="bi bi-gear-fill" aria-hidden="true"></i></div>
        <div>
          <div class="text-[15px] font-semibold text-slate-900">ตั้งค่าระบบ</div>
          <div class="text-2xs text-slate-400">System Settings</div>
        </div>
      </div>
      <button type="button" onclick="closeSettings()" class="erp-icon-btn" aria-label="ปิด"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>

    <div class="flex gap-1 border-b border-slate-200 px-6">
      <button type="button" class="erp-tab stab active" id="stab-1" onclick="switchSettingsTab(1)"><i class="bi bi-sliders" aria-hidden="true"></i> ตั้งค่าทำงาน</button>
      <button type="button" class="erp-tab stab" id="stab-2" onclick="switchSettingsTab(2)"><i class="bi bi-clock" aria-hidden="true"></i> เวลาทำงานบุคลากร</button>
      <button type="button" class="erp-tab stab" id="stab-3" onclick="switchSettingsTab(3)"><i class="bi bi-calendar3" aria-hidden="true"></i> ประเภทเวร</button>
    </div>

    <div class="flex-1 overflow-y-auto bg-slate-50/60 px-6 py-5">

      <!-- TAB 1: Work Settings -->
      <div id="spanel-1" class="spanel">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label class="erp-label" for="s-work-start">เวลาเริ่มงาน (เช้า)</label>
            <input type="time" id="s-work-start" class="erp-input" value="08:00">
          </div>
          <div>
            <label class="erp-label" for="s-work-end">เวลาเลิกงาน (เช้า)</label>
            <input type="time" id="s-work-end" class="erp-input" value="16:00">
          </div>
          <div>
            <label class="erp-label" for="s-late-min">เกณฑ์มาสาย (นาที)</label>
            <input type="number" id="s-late-min" class="erp-input" value="31" min="1" max="120">
          </div>
        </div>
        <div class="mt-5">
          <span class="erp-label">วันทำงาน</span>
          <div class="flex flex-wrap gap-2">
            <% const days = ['อา','จ','อ','พ','พฤ','ศ','ส']; %>
            <% const dayIds = ['sun','mon','tue','wed','thu','fri','sat']; %>
            <% for(let d=0;d<7;d++){ %>
            <label class="flex cursor-pointer items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-[13px] has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 has-[:checked]:text-brand-700">
              <input type="checkbox" id="s-day-<%= dayIds[d] %>" class="accent-brand-600" <%= (d>=1&&d<=5)?'checked':'' %>>
              <span><%= days[d] %></span>
            </label>
            <% } %>
          </div>
        </div>
        <div class="mt-5 sm:w-1/2">
          <label class="erp-label" for="s-auto-report">ระบบส่งรายงานอัตโนมัติ</label>
          <select id="s-auto-report" class="erp-input">
            <option value="none">ไม่ส่ง</option>
            <option value="daily" selected>รายวัน</option>
            <option value="weekly">รายสัปดาห์</option>
          </select>
        </div>
      </div>

      <!-- TAB 2: Staff Work Hours -->
      <div id="spanel-2" class="spanel" style="display:none;">
        <p class="mb-3 text-xs text-slate-500">กำหนดเวลาเริ่ม–สิ้นสุดงานตามประเภทบุคลากร</p>
        <% const staffTypes = [
          { id:'doctor', label:'แพทย์', icon:'bi-person-badge' },
          { id:'nurse', label:'พยาบาล', icon:'bi-heart-pulse' },
          { id:'staff', label:'เจ้าหน้าที่ทั่วไป', icon:'bi-people' },
          { id:'support', label:'บุคลากรสนับสนุน', icon:'bi-tools' }
        ]; %>
        <div class="space-y-2">
          <% staffTypes.forEach(function(st){ %>
          <div class="erp-panel p-4">
            <div class="mb-3 flex items-center gap-2 text-[13px] font-semibold text-slate-800">
              <i class="bi <%= st.icon %> text-brand-600" aria-hidden="true"></i><%= st.label %>
            </div>
            <div class="grid grid-cols-3 gap-3">
              <div>
                <label class="erp-label" for="s-<%= st.id %>-start">เวลาเริ่ม</label>
                <input type="time" id="s-<%= st.id %>-start" class="erp-input" value="08:00">
              </div>
              <div>
                <label class="erp-label" for="s-<%= st.id %>-end">เวลาสิ้นสุด</label>
                <input type="time" id="s-<%= st.id %>-end" class="erp-input" value="16:00">
              </div>
              <div>
                <label class="erp-label" for="s-<%= st.id %>-ot">OT เริ่มหลัง (ชม.)</label>
                <input type="number" id="s-<%= st.id %>-ot" class="erp-input" value="8" min="1" max="24">
              </div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>

      <!-- TAB 3: Shift Types -->
      <div id="spanel-3" class="spanel" style="display:none;">
        <p class="mb-3 text-xs text-slate-500">กำหนดช่วงเวลาและชื่อของแต่ละเวร</p>
        <div class="mb-1 hidden grid-cols-[1fr_130px_130px_36px] gap-2 px-3 text-2xs font-medium uppercase tracking-wide text-slate-400 sm:grid">
          <span>ชื่อเวร</span><span>เริ่ม</span><span>สิ้นสุด</span><span></span>
        </div>
        <div id="shiftList"><!-- rendered by JS --></div>
        <button type="button" onclick="addShift()"
          class="mt-2 flex w-full items-center justify-center gap-2 rounded-md border border-dashed border-brand-300 py-2.5 text-[13px] font-medium text-brand-700 hover:bg-brand-50">
          <i class="bi bi-plus-circle" aria-hidden="true"></i> เพิ่มประเภทเวร
        </button>
      </div>

    </div>

    <div class="flex justify-end gap-2 border-t border-slate-200 bg-white px-6 py-3">
      <button type="button" onclick="closeSettings()" class="erp-btn erp-btn-secondary">ยกเลิก</button>
      <button type="button" onclick="saveSettings(event)" class="erp-btn erp-btn-primary">
        <i class="bi bi-check2-circle" aria-hidden="true"></i> บันทึกการตั้งค่า
      </button>
    </div>
  </div>
</div>

<script>
  /* =====================================================
     SETTINGS  —  state & helpers (Global via Topbar)
     ===================================================== */
  const SETTINGS_KEY = 'hospital_settings';

  const DEFAULT_SETTINGS = {
    workStart: '08:00', workEnd: '16:00', lateMin: 31,
    workDays: ['mon','tue','wed','thu','fri'],
    autoReport: 'daily',
    staffHours: {
      doctor:  { start:'08:00', end:'16:00', ot:8 },
      nurse:   { start:'07:00', end:'15:00', ot:8 },
      staff:   { start:'08:00', end:'16:00', ot:8 },
      support: { start:'08:00', end:'16:00', ot:8 }
    },
    shifts: [
      { name:'เช้า',  start:'08:00', end:'16:00', color:'#F59E0B' },
      { name:'บ่าย',  start:'16:00', end:'24:00', color:'#3B82F6' },
      { name:'ดึก',   start:'00:00', end:'08:00', color:'#7C3AED' }
    ]
  };

  // Re-run whichever loader the current page exposes after settings change
  window.refreshPageData = function() {
    if (typeof initGrid === 'function') {
      initGrid();
    } else if (typeof fetchData === 'function') {
      const dateInput = document.getElementById('dateInput') || document.getElementById('report-date-input');
      if (dateInput) fetchData(dateInput.value);
      else fetchData();
    } else if (typeof loadData === 'function') {
      loadData();
    }
  };

  // Pull the shared settings from the server; refresh the page data if this browser's cache was stale
  (async function syncSettingsFromServer() {
    try {
      const res = await fetch('/api/settings', { headers: { Accept: 'application/json' } });
      if (!res.ok) return;
      const data = await res.json();
      if (!data.success || !data.settings) return;
      const next = JSON.stringify(data.settings);
      const prev = localStorage.getItem(SETTINGS_KEY);
      localStorage.setItem(SETTINGS_KEY, next);
      if (prev && prev !== next) window.refreshPageData();
    } catch (e) { /* offline: keep cached settings */ }
  })();

  window.loadSettings = function() {
    try { return JSON.parse(localStorage.getItem(SETTINGS_KEY)) || DEFAULT_SETTINGS; }
    catch { return DEFAULT_SETTINGS; }
  };

  window.openSettings = function() {
    const s = window.loadSettings();
    // Tab 1
    document.getElementById('s-work-start').value  = s.workStart;
    document.getElementById('s-work-end').value    = s.workEnd;
    document.getElementById('s-late-min').value    = s.lateMin;
    document.getElementById('s-auto-report').value = s.autoReport;
    ['sun','mon','tue','wed','thu','fri','sat'].forEach(d => {
      const el = document.getElementById('s-day-' + d);
      if (el) el.checked = s.workDays.includes(d);
    });
    // Tab 2
    ['doctor','nurse','staff','support'].forEach(t => {
      const h = s.staffHours[t] || {};
      if (document.getElementById('s-' + t + '-start'))
        document.getElementById('s-' + t + '-start').value = h.start || '08:00';
      if (document.getElementById('s-' + t + '-end'))
        document.getElementById('s-' + t + '-end').value = h.end || '16:00';
      if (document.getElementById('s-' + t + '-ot'))
        document.getElementById('s-' + t + '-ot').value = h.ot || 8;
    });
    // Tab 3 — render shift rows
    window.renderShiftList(s.shifts);
    window.switchSettingsTab(1);
    const modal = document.getElementById('settingsModal');
    modal.style.display = 'flex';
  };

  window.closeSettings = function() {
    document.getElementById('settingsModal').style.display = 'none';
  };

  window.switchSettingsTab = function(n) {
    [1,2,3].forEach(i => {
      const tabEl = document.getElementById('stab-' + i);
      if (tabEl) tabEl.classList.toggle('active', i === n);
      const panelEl = document.getElementById('spanel-' + i);
      if (panelEl) panelEl.style.display = i === n ? 'block' : 'none';
    });
  };

  /* --- Shift rows --- */
  window._shifts = [];

  const escapeAttr = value => String(value == null ? '' : value)
    .replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');

  window.renderShiftList = function(shifts) {
    window._shifts = shifts ? JSON.parse(JSON.stringify(shifts)) : [];
    const el = document.getElementById('shiftList');
    el.innerHTML = window._shifts.map((sh, i) => `
      <div class="mb-2 grid grid-cols-[1fr_130px_130px_36px] items-center gap-2 rounded-md border border-slate-200 bg-white p-2.5">
        <input type="text" class="erp-input" value="${escapeAttr(sh.name)}" placeholder="ชื่อเวร" aria-label="ชื่อเวร"
          onchange="window._shifts[${i}].name=this.value" style="min-width:0;">
        <input type="time" class="erp-input" value="${escapeAttr(sh.start)}" aria-label="เวลาเริ่ม"
          onchange="window._shifts[${i}].start=this.value">
        <input type="time" class="erp-input" value="${escapeAttr(sh.end)}" aria-label="เวลาสิ้นสุด"
          onchange="window._shifts[${i}].end=this.value">
        <button type="button" onclick="window.removeShift(${i})" aria-label="ลบเวร"
          class="erp-icon-btn text-red-500 hover:bg-red-50 hover:text-red-600"><i class="bi bi-trash3"></i></button>
      </div>
    `).join('');
  };

  window.addShift = function() {
    window._shifts.push({ name:'เวรใหม่', start:'00:00', end:'08:00', color:'#6366F1' });
    window.renderShiftList(window._shifts);
  };

  window.removeShift = function(i) {
    window._shifts.splice(i, 1);
    window.renderShiftList(window._shifts);
  };

  window.saveSettings = function(evt) {
    const days = ['sun','mon','tue','wed','thu','fri','sat'].filter(d => {
      const el = document.getElementById('s-day-' + d);
      return el && el.checked;
    });
    const staffHours = {};
    ['doctor','nurse','staff','support'].forEach(t => {
      staffHours[t] = {
        start: document.getElementById('s-' + t + '-start')?.value || '08:00',
        end:   document.getElementById('s-' + t + '-end')?.value   || '16:00',
        ot:    parseInt(document.getElementById('s-' + t + '-ot')?.value || 8)
      };
    });
    const settings = {
      workStart:   document.getElementById('s-work-start').value,
      workEnd:     document.getElementById('s-work-end').value,
      lateMin:     parseInt(document.getElementById('s-late-min').value),
      workDays:    days,
      autoReport:  document.getElementById('s-auto-report').value,
      staffHours,
      shifts:      window._shifts
    };
    const btn = evt ? evt.currentTarget : null;
    const notify = (msg, tone) => (window.ERP ? ERP.toast(msg, tone) : alert(msg));
    if (btn) btn.disabled = true;

    fetch('/api/settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(settings)
    })
      .then(res => res.json().then(data => ({ ok: res.ok, data })))
      .then(({ ok, data }) => {
        if (!ok || !data.success) {
          notify('บันทึกไม่สำเร็จ: ' + ((data && data.error) || 'ไม่ทราบสาเหตุ'), 'error');
          return;
        }
        localStorage.setItem(SETTINGS_KEY, JSON.stringify(data.settings));
        notify('บันทึกการตั้งค่าแล้ว (ใช้กับทุกเครื่อง)', 'success');
        window.closeSettings();
        window.refreshPageData();
      })
      .catch(() => notify('เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ การตั้งค่ายังไม่ถูกบันทึก', 'error'))
      .finally(() => { if (btn) btn.disabled = false; });
  };

  // Backdrop click listener
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('settingsModal');
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === this) window.closeSettings();
      });
    }
  });
</script>
