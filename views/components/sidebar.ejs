<%
  const route = typeof activeRoute !== 'undefined' ? activeRoute : '/';
  const isAdmin = locals.RBAC_ENABLED === false || (locals.user && (user.role === 'admin' || user.role === 'super'));
  const isSuper = locals.RBAC_ENABLED === false || (locals.user && user.role === 'super');
  const isDepartmentRoute = route.startsWith('/department/');
  const departments = [
    { id: 'srt', name: 'ประกันสุขภาพยุทธศาสตร์', icon: 'bi-clipboard2-data' },
    { id: 'gen', name: 'บริหารทั่วไป', icon: 'bi-briefcase' },
    { id: 'pri', name: 'บริการด้านปฐมภูมิฯ', icon: 'bi-house-heart' },
    { id: 'pha', name: 'เภสัชกรรมฯ', icon: 'bi-capsule' },
    { id: 'dig', name: 'สุขภาพดิจิทัล', icon: 'bi-pc-display' },
    { id: 'nur', name: 'การพยาบาล', icon: 'bi-heart-pulse' },
    { id: 'den', name: 'ทันตกรรม', icon: 'bi-bandaid' },
    { id: 'medtech', name: 'เทคนิคการแพทย์', icon: 'bi-eyedropper' },
    { id: 'rehab', name: 'เวชกรรมฟื้นฟู', icon: 'bi-person-wheelchair' },
    { id: 'altmed', name: 'แพทย์แผนไทยฯ', icon: 'bi-flower1' },
    { id: 'rad', name: 'รังสีวิทยา', icon: 'bi-x-diamond' },
    { id: 'psy', name: 'จิตเวชและยาเสพติด', icon: 'bi-person-hearts' },
    { id: 'med', name: 'การแพทย์', icon: 'bi-clipboard2-pulse' }
  ];
%>

<nav class="sidebar" id="sidebar" aria-label="เมนูหลัก">
  <button type="button" class="sb-toggle-btn" onclick="toggleGlobalSidebar()"
    aria-label="ย่อหรือขยายเมนูนำทาง" aria-controls="sidebar" aria-expanded="true">
    <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>
  </button>

  <a class="sb-logo" href="/" aria-label="โรงพยาบาลคลองหาด หน้าหลัก">
    <span class="sb-logo-icon">
      <img src="/images/LOGO%20KHH.jpg" alt="" />
    </span>
    <span class="sb-brand-copy">
      <span class="sb-brand-name">โรงพยาบาลคลองหาด</span>
      <small>ระบบบริหารเวลาปฏิบัติงาน</small>
    </span>
  </a>

  <div class="sb-nav">
    <div class="sb-sec">ภาพรวม</div>
    <a href="/" class="sb-link <%= route === '/' ? 'active' : '' %>" <%- route === '/' ? 'aria-current="page"' : '' %>>
      <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i><span>แดชบอร์ด</span>
    </a>

    <div class="sb-sec">งานประจำ</div>
    <a href="/schedule" class="sb-link <%= route === '/schedule' ? 'active' : '' %>" <%- route === '/schedule' ? 'aria-current="page"' : '' %>>
      <i class="bi bi-calendar-check" aria-hidden="true"></i><span>ตารางเวรของฉัน</span>
    </a>
    <a href="/excuses" class="sb-link <%= route === '/excuses' ? 'active' : '' %>" <%- route === '/excuses' ? 'aria-current="page"' : '' %>>
      <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i><span>แจ้งสาเหตุการลงเวลา</span>
    </a>

    <% if (isAdmin) { %>
      <div class="sb-sec">บุคลากรและเวลา</div>
      <a href="/attendance" class="sb-link <%= route === '/attendance' ? 'active' : '' %>" <%- route === '/attendance' ? 'aria-current="page"' : '' %>>
        <i class="bi bi-person-check-fill" aria-hidden="true"></i><span>ตรวจสอบเข้า–ออกงาน</span>
      </a>
      <a href="/personnel" class="sb-link <%= route === '/personnel' ? 'active' : '' %>" <%- route === '/personnel' ? 'aria-current="page"' : '' %>>
        <i class="bi bi-people-fill" aria-hidden="true"></i><span>ข้อมูลบุคลากร</span>
      </a>
      <a href="/scheduling" class="sb-link <%= route === '/scheduling' ? 'active' : '' %>" <%- route === '/scheduling' ? 'aria-current="page"' : '' %>>
        <i class="bi bi-calendar2-week-fill" aria-hidden="true"></i><span>จัดตารางเวร</span>
      </a>

      <div class="sb-sec">รายงาน</div>
      <a href="/reports" class="sb-link <%= route === '/reports' ? 'active' : '' %>" <%- route === '/reports' ? 'aria-current="page"' : '' %>>
        <i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span>ภาพรวมการวิเคราะห์</span>
      </a>
      <a href="/report/daily" class="sb-link <%= route === '/report/daily' ? 'active' : '' %>" <%- route === '/report/daily' ? 'aria-current="page"' : '' %>>
        <i class="bi bi-bar-chart-line" aria-hidden="true"></i><span>รายงานรายวัน</span>
      </a>
      <a href="/report/monthly" class="sb-link <%= route === '/report/monthly' ? 'active' : '' %>" <%- route === '/report/monthly' ? 'aria-current="page"' : '' %>>
        <i class="bi bi-calendar3" aria-hidden="true"></i><span>รายงานรายเดือน</span>
      </a>
      <a href="/report/hours" class="sb-link <%= route === '/report/hours' ? 'active' : '' %>" <%- route === '/report/hours' ? 'aria-current="page"' : '' %>>
        <i class="bi bi-clock-history" aria-hidden="true"></i><span>สรุปชั่วโมงทำงาน</span>
      </a>

      <details class="sb-group" <%= isDepartmentRoute ? 'open' : '' %>>
        <summary class="sb-group-summary <%= isDepartmentRoute ? 'active' : '' %>">
          <i class="bi bi-diagram-3-fill" aria-hidden="true"></i>
          <span>ข้อมูลตามกลุ่มงาน</span>
          <i class="bi bi-chevron-down sb-group-chevron" aria-hidden="true"></i>
        </summary>
        <div class="sb-group-links">
          <% departments.forEach(department => { const departmentRoute = '/department/' + department.id; %>
            <a href="<%= departmentRoute %>" class="sb-link sb-link-nested <%= route === departmentRoute ? 'active' : '' %>"
              <%- route === departmentRoute ? 'aria-current="page"' : '' %>>
              <i class="bi <%= department.icon %>" aria-hidden="true"></i><span><%= department.name %></span>
            </a>
          <% }); %>
        </div>
      </details>
    <% } %>

    <% if (isSuper) { %>
      <div class="sb-sec">บริหารระบบ</div>
      <a href="/admin/users" class="sb-link <%= route === '/admin/users' ? 'active' : '' %>" <%- route === '/admin/users' ? 'aria-current="page"' : '' %>>
        <i class="bi bi-person-gear" aria-hidden="true"></i><span>จัดการผู้เข้าใช้</span>
      </a>
      <a href="/admin/permissions" class="sb-link <%= route === '/admin/permissions' ? 'active' : '' %>" <%- route === '/admin/permissions' ? 'aria-current="page"' : '' %>>
        <i class="bi bi-shield-lock-fill" aria-hidden="true"></i><span>ระดับสิทธิ์</span>
      </a>
      <a href="/flex-preview" class="sb-link <%= route === '/flex-preview' ? 'active' : '' %>" <%- route === '/flex-preview' ? 'aria-current="page"' : '' %>>
        <i class="bi bi-line" aria-hidden="true"></i><span>จำลอง LINE Flex</span>
      </a>
    <% } %>
  </div>

  <div class="sb-foot">
    <div class="sb-user">
      <div class="sb-av" aria-hidden="true"><%= locals.user && user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %></div>
      <div class="sb-user-copy">
        <div class="sb-uname"><%= locals.user && user.fullname ? user.fullname : 'ผู้ใช้งาน' %></div>
        <div class="sb-urole">
          <% if (locals.user && user.role === 'super') { %>
            <span class="badge" style="background-color:#056839;font-size:10px;font-weight:700;">ผู้ดูแลระบบสูงสุด</span>
          <% } else if (locals.user && user.role === 'admin') { %>
            <span class="badge bg-danger" style="font-size:10px;font-weight:700;">ผู้ดูแลระบบ</span>
          <% } else { %>
            <span class="badge bg-success" style="font-size:10px;font-weight:700;">เจ้าหน้าที่</span>
          <% } %>
        </div>
      </div>
      <a href="/logout" class="sb-logout" title="ออกจากระบบ" aria-label="ออกจากระบบ">
        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</nav>

<div class="sb-overlay" id="sidebar-overlay" onclick="toggleGlobalSidebar()" aria-hidden="true"></div>

<button type="button" id="scrollToTopBtn" class="scroll-to-top" onclick="scrollToTop()"
  title="กลับไปข้างบน" aria-label="กลับไปด้านบนของหน้า">
  <i class="bi bi-chevron-up" aria-hidden="true"></i>
</button>

<script>
  window.addEventListener('scroll', () => {
    const button = document.getElementById('scrollToTopBtn');
    if (button) button.classList.toggle('show', window.scrollY > 300);
  }, { passive: true });

  function scrollToTop() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
</script>
