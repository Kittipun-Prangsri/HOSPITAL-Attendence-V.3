<%
  const route = typeof activeRoute !== 'undefined' ? activeRoute : '/';
  const navRole = locals.RBAC_ENABLED === false ? 'super' : (locals.user && user.role ? user.role : 'staff');
  const sections = locals.NAV_SECTIONS || [];
  const allowed = access => (locals.navCanAccess ? navCanAccess(access, navRole) : access === 'all');
  const fullname = locals.user && user.fullname ? user.fullname : 'ผู้ใช้งาน';
  const roleMeta = {
    super: { label: 'ผู้ดูแลระบบสูงสุด', cls: 'bg-brand-400/20 text-brand-200' },
    admin: { label: 'ผู้ดูแลระบบ', cls: 'bg-amber-400/20 text-amber-200' }
  }[navRole] || { label: 'เจ้าหน้าที่', cls: 'bg-white/10 text-slate-300' };
%>
<%# ERP shell stylesheet is linked here so every page picks it up after its own CSS %>
<link rel="stylesheet" href="/css/erp.css" />

<nav class="erp erp-sidebar" id="sidebar" aria-label="เมนูหลัก">
  <a href="/" class="flex h-14 shrink-0 items-center gap-3 border-b border-white/10 px-4" aria-label="โรงพยาบาลคลองหาด หน้าหลัก">
    <span class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-md bg-white ring-1 ring-white/20">
      <img src="/images/LOGO%20KHH.jpg" alt="" class="h-full w-full object-cover" />
    </span>
    <span class="erp-hide-collapsed min-w-0 leading-tight">
      <span class="block truncate text-[13px] font-semibold text-white">KHH · HRM</span>
      <span class="block truncate text-2xs text-plum-300/70">โรงพยาบาลคลองหาด</span>
    </span>
  </a>

  <div class="erp-nav flex-1 overflow-y-auto overflow-x-hidden py-2">
    <% sections.forEach(section => {
         const items = section.items.filter(i => allowed(i.access));
         const showGroup = section.group && allowed(section.group.access);
         if (!items.length && !showGroup) return; %>
      <div class="erp-sec"><%= section.title %></div>
      <% items.forEach(item => { const active = locals.navIsActive ? navIsActive(item, route) : route === item.href; %>
        <a href="<%= item.href %>" class="erp-nav-link <%= active ? 'active' : '' %>" title="<%= item.label %>"
          data-nav-label="<%= item.label %>" data-nav-section="<%= section.title %>" <%- active ? 'aria-current="page"' : '' %>>
          <i class="bi <%= item.icon %>" aria-hidden="true"></i>
          <span class="erp-hide-collapsed truncate"><%= item.label %></span>
        </a>
      <% }); %>
      <% if (showGroup) {
           const groupActive = section.group.items.some(i => i.href === route); %>
        <details class="erp-nav-group" <%= groupActive ? 'open' : '' %>>
          <summary class="<%= groupActive ? 'active' : '' %>" title="<%= section.group.label %>">
            <i class="bi <%= section.group.icon %> w-5 shrink-0 text-center text-[15px]" aria-hidden="true"></i>
            <span class="erp-hide-collapsed flex-1 truncate"><%= section.group.label %></span>
            <i class="erp-chevron erp-hide-collapsed bi bi-chevron-down text-xs transition-transform" aria-hidden="true"></i>
          </summary>
          <div class="erp-nav-sub">
            <% section.group.items.forEach(item => { const active = route === item.href; %>
              <a href="<%= item.href %>" class="erp-nav-link <%= active ? 'active' : '' %>"
                data-nav-label="<%= item.label %>" data-nav-section="<%= section.group.label %>" <%- active ? 'aria-current="page"' : '' %>>
                <span class="truncate"><%= item.label %></span>
              </a>
            <% }); %>
          </div>
        </details>
      <% } %>
    <% }); %>
  </div>

  <div class="shrink-0 border-t border-white/10 p-3">
    <div class="flex items-center gap-2.5 rounded-md bg-white/5 p-2">
      <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-brand-500 text-[13px] font-semibold text-white" aria-hidden="true">
        <%= fullname.charAt(0).toUpperCase() %>
      </div>
      <div class="erp-hide-collapsed min-w-0 flex-1">
        <div class="truncate text-xs font-medium text-white"><%= fullname %></div>
        <span class="erp-badge mt-0.5 <%= roleMeta.cls %>"><%= roleMeta.label %></span>
      </div>
      <a href="/logout" class="erp-hide-collapsed erp-icon-btn h-8 w-8 text-slate-400 hover:bg-white/10 hover:text-white" title="ออกจากระบบ" aria-label="ออกจากระบบ">
        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
    <button type="button" onclick="toggleGlobalSidebar()" aria-controls="sidebar" aria-expanded="true"
      class="mt-2 hidden w-full items-center justify-center gap-2 rounded-md py-1.5 text-2xs text-slate-400 transition-colors hover:bg-white/5 hover:text-white lg:flex"
      aria-label="ย่อหรือขยายเมนูนำทาง">
      <i class="bi bi-chevron-bar-left" aria-hidden="true"></i><span class="erp-hide-collapsed">ย่อเมนู</span>
    </button>
  </div>
</nav>

<div class="erp-overlay fixed inset-0 z-[998] bg-slate-900/50 backdrop-blur-sm" id="sidebar-overlay" onclick="toggleGlobalSidebar()" aria-hidden="true"></div>

<button type="button" id="scrollToTopBtn" class="erp erp-scroll-top" onclick="scrollToTop()"
  title="กลับไปข้างบน" aria-label="กลับไปด้านบนของหน้า">
  <i class="bi bi-chevron-up" aria-hidden="true"></i>
</button>

<script>
  window.addEventListener('scroll', () => {
    const button = document.getElementById('scrollToTopBtn');
    if (button) button.classList.toggle('show', window.scrollY > 300);
  }, { passive: true });

  function scrollToTop() {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
</script>
