<!DOCTYPE html>
<html lang="th">

<head>
  <%- include("components/erp-head", { title: "แดชบอร์ด" }) %>
  <link rel="stylesheet" href="<%= asset('/css/staff-schedule-modal.css') %>" />
</head>

<body class="erp-page">
  <%- include("components/sidebar") %>
  <div class="main" role="main">
    <%- include("components/topbar") %>
    <% const firstName = locals.user && user.fullname ? user.fullname.split(' ')[0] : 'ผู้ใช้งาน'; %>

    <div class="erp px-4 py-5 lg:px-6">

      <!-- Page header -->
      <section class="mb-5 flex flex-wrap items-end justify-between gap-4" aria-labelledby="dashboard-heading">
        <div>
          <p class="text-xs text-slate-500">สวัสดี คุณ<%= firstName %></p>
          <h2 id="dashboard-heading" class="text-xl font-semibold text-slate-900">ภาพรวมการปฏิบัติงาน <span id="headingDate" class="text-slate-400"></span></h2>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <div class="flex items-center rounded-md border border-slate-300 bg-white">
            <button type="button" class="erp-icon-btn h-9 rounded-r-none" onclick="shiftDate(-1)" aria-label="วันก่อนหน้า"><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
            <input type="date" id="dateInput" class="h-9 border-x border-slate-200 bg-transparent px-2 text-[13px] text-slate-800 outline-none" style="font-family:inherit;" aria-label="เลือกวันที่">
            <button type="button" class="erp-icon-btn h-9 rounded-l-none" onclick="shiftDate(1)" aria-label="วันถัดไป"><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
          </div>
          <button type="button" class="erp-btn erp-btn-secondary" onclick="setToday()">วันนี้</button>
          <button type="button" class="erp-btn erp-btn-secondary" onclick="exportCSV()"><i class="bi bi-download" aria-hidden="true"></i> ส่งออก CSV</button>
          <button type="button" class="erp-btn erp-btn-primary" id="reloadBtn" onclick="refreshData(this)"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> อัปเดต</button>
        </div>
      </section>

      <!-- KPI strip -->
      <section class="erp-panel mb-5 grid grid-cols-2 divide-slate-100 sm:grid-cols-3 xl:grid-cols-6 xl:divide-x" aria-label="สรุปสถานะวันนี้">
        <% const kpis = [
          { id: 'totalStaff', label: 'บุคลากรทั้งหมด', icon: 'bi-people', tone: 'text-brand-600' },
          { id: 'totalIn', label: 'มาปฏิบัติงาน', icon: 'bi-person-check', tone: 'text-emerald-600', sub: 'rateSub' },
          { id: 'totalLate', label: 'มาสาย', icon: 'bi-alarm', tone: 'text-amber-600' },
          { id: 'totalLeave', label: 'ลา / ไปราชการ', icon: 'bi-calendar-x', tone: 'text-violet-600' },
          { id: 'totalAbsent', label: 'ยังไม่บันทึกเวลา', icon: 'bi-question-circle', tone: 'text-slate-500' },
          { id: 'totalFaceFail', label: 'สแกนไม่ผ่าน', icon: 'bi-shield-x', tone: 'text-red-600' }
        ]; %>
        <% kpis.forEach(k => { %>
          <div class="p-4">
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span class="truncate"><%= k.label %></span><i class="bi <%= k.icon %> <%= k.tone %>" aria-hidden="true"></i>
            </div>
            <div class="mt-1 flex items-baseline gap-1.5">
              <span id="<%= k.id %>" class="font-mono text-2xl font-semibold tabular-nums text-slate-900">–</span>
              <% if (k.sub) { %><span id="<%= k.sub %>" class="text-2xs text-slate-400"></span><% } %>
            </div>
          </div>
        <% }); %>
      </section>

      <!-- Status distribution -->
      <section class="erp-panel mb-5 p-4" aria-labelledby="distTitle">
        <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
          <h3 id="distTitle" class="text-[13px] font-semibold text-slate-800">สัดส่วนสถานะการลงเวลา</h3>
          <span id="distTotal" class="text-2xs text-slate-400"></span>
        </div>
        <div id="distBar" class="flex h-3 w-full gap-[2px] overflow-hidden rounded bg-slate-100" role="img" aria-label="สัดส่วนสถานะการลงเวลา"></div>
        <ul id="distLegend" class="m-0 mt-3 flex list-none flex-wrap gap-x-5 gap-y-1.5 p-0 text-xs text-slate-600"></ul>
      </section>

      <div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-2 xl:grid-cols-3">

        <!-- Attendance table -->
        <section class="erp-panel overflow-hidden lg:col-span-2 xl:col-span-3" aria-labelledby="tableTitle" id="attendanceTableCard">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-4 py-3">
            <div>
              <h3 id="tableTitle" class="text-[13px] font-semibold text-slate-800">บันทึกการเข้า–ออกงาน</h3>
              <p class="text-2xs text-slate-400">กะเช้า 08:00–16:00 · กะบ่าย 16:00–24:00 · กะดึก 00:00–08:00</p>
            </div>
            <button type="button" class="erp-btn erp-btn-ghost h-8" onclick="window.print()"><i class="bi bi-printer" aria-hidden="true"></i> พิมพ์</button>
          </div>
          <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 p-3">
            <div class="relative min-w-[200px] flex-1">
              <i class="bi bi-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
              <input type="search" id="searchInput" class="erp-input pl-9" placeholder="ค้นหาชื่อ / แผนก / รหัส…" oninput="applyFilter()" aria-label="ค้นหา">
            </div>
            <select id="shiftFilter" class="erp-input w-auto" onchange="applyFilter()" aria-label="กรองตามกะ">
              <option value="all">ทุกกะ</option>
              <option value="morning">เช้า</option>
              <option value="afternoon">บ่าย</option>
              <option value="night">ดึก</option>
            </select>
            <select id="deptFilter" class="erp-input w-auto min-w-[180px] max-w-[240px]" onchange="applyFilter()" aria-label="กรองตามกลุ่มงาน">
              <option value="">ทุกกลุ่มงาน</option>
            </select>
            <span class="ml-auto text-xs text-slate-500">พบ <span id="rowCountSpan" class="font-semibold text-slate-800">0</span> รายการ</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left text-[13px]">
              <thead class="bg-slate-50 text-2xs uppercase tracking-wide text-slate-500">
                <tr class="border-b border-slate-200">
                  <th class="px-4 py-2.5 font-semibold">บุคลากร</th>
                  <th class="px-3 py-2.5 font-semibold">กลุ่มงาน</th>
                  <th class="px-3 py-2.5 font-semibold">กะ</th>
                  <th class="px-3 py-2.5 font-semibold">สถานะ</th>
                  <th class="px-3 py-2.5 text-center font-semibold">เข้า</th>
                  <th class="px-3 py-2.5 text-center font-semibold">ออก</th>
                  <th class="px-3 py-2.5 text-right font-semibold">ชม. <span class="normal-case text-slate-400">(OT)</span></th>
                  <th class="admin-col px-4 py-2.5 text-right font-semibold">จัดการ</th>
                </tr>
              </thead>
              <tbody id="tableBody" class="divide-y divide-slate-100">
                <tr><td colspan="9" class="px-4 py-16 text-center text-slate-400"><i class="bi bi-hourglass-split mr-1"></i> กำลังโหลดข้อมูล…</td></tr>
              </tbody>
            </table>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 bg-slate-50/70 px-4 py-2.5 text-xs text-slate-500">
            <span id="pagerInfo">แสดง 0 รายการ</span>
            <nav aria-label="เปลี่ยนหน้า"><ul id="pagination" class="m-0 flex list-none items-center gap-1 p-0"></ul></nav>
          </div>
        </section>

        <!-- Right column -->
        <div class="space-y-5">
          <section class="erp-panel p-4" aria-labelledby="selfTitle">
            <h3 id="selfTitle" class="mb-3 text-[13px] font-semibold text-slate-800">บริการตนเอง</h3>
            <div class="grid grid-cols-3 gap-2">
              <button type="button" onclick="openStaffDetail('<%= locals.user ? user.username : '' %>')"
                class="flex flex-col items-center gap-1.5 rounded-md border border-slate-200 p-3 text-center text-xs text-slate-700 transition-colors hover:border-brand-300 hover:bg-brand-50">
                <i class="bi bi-person-vcard text-lg text-brand-600" aria-hidden="true"></i>โปรไฟล์ของฉัน
              </button>
              <a href="/leave" class="flex flex-col items-center gap-1.5 rounded-md border border-slate-200 p-3 text-center text-xs text-slate-700 transition-colors hover:border-brand-300 hover:bg-brand-50">
                <i class="bi bi-calendar2-x text-lg text-brand-600" aria-hidden="true"></i>ยื่นใบลา
              </a>
              <a href="/excuses" class="flex flex-col items-center gap-1.5 rounded-md border border-slate-200 p-3 text-center text-xs text-slate-700 transition-colors hover:border-brand-300 hover:bg-brand-50">
                <i class="bi bi-clipboard2-pulse text-lg text-brand-600" aria-hidden="true"></i>แจ้งสาเหตุ ขาด/ลา/สาย
              </a>
              <a href="/ot" class="flex flex-col items-center gap-1.5 rounded-md border border-slate-200 p-3 text-center text-xs text-slate-700 transition-colors hover:border-brand-300 hover:bg-brand-50">
                <i class="bi bi-stopwatch text-lg text-brand-600" aria-hidden="true"></i>ขอทำ OT
              </a>
              <a href="/schedule" class="flex flex-col items-center gap-1.5 rounded-md border border-slate-200 p-3 text-center text-xs text-slate-700 transition-colors hover:border-brand-300 hover:bg-brand-50">
                <i class="bi bi-calendar-check text-lg text-brand-600" aria-hidden="true"></i>ตารางเวรของฉัน
              </a>
            </div>
          </section>

          <section class="erp-panel overflow-hidden" aria-labelledby="tlTitle">
            <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
              <div>
                <h3 id="tlTitle" class="text-[13px] font-semibold text-slate-800">ประวัติสแกนล่าสุด</h3>
                <p class="text-2xs text-slate-400">30 รายการล่าสุดของวันที่เลือก</p>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2 py-0.5 text-2xs font-medium text-emerald-700"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>สด</span>
            </div>
            <ul id="timeline" class="m-0 max-h-[420px] list-none divide-y divide-slate-100 overflow-y-auto p-0"></ul>
          </section>
        </div>

        <!-- Department breakdown -->
        <section class="erp-panel" aria-labelledby="deptTitle">
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-slate-200 px-4 py-3">
            <h3 id="deptTitle" class="text-[13px] font-semibold text-slate-800">อัตราการมารายกลุ่มงาน</h3>
            <span class="text-2xs text-slate-400">ไม่นับผู้ลา · ต่ำสุดก่อน</span>
          </div>
          <div id="deptBreakdown" class="grid max-h-[520px] grid-cols-1 gap-y-3 overflow-y-auto p-4"></div>
        </section>

        <!-- Service work / leave -->
        <section class="erp-panel overflow-hidden" aria-labelledby="leaveTitle">
          <div class="border-b border-slate-200 px-4 py-3">
            <h3 id="leaveTitle" class="text-[13px] font-semibold text-slate-800">ไปราชการ / ลา</h3>
            <p class="text-2xs text-slate-400">ข้อมูลของวันที่เลือก</p>
          </div>
          <ul id="serviceWorkBody" class="m-0 max-h-[520px] list-none divide-y divide-slate-100 overflow-y-auto p-0"></ul>
        </section>
      </div>
    </div>
  </div>

  <!-- Chart tooltip -->
  <div id="chartTip" class="erp pointer-events-none fixed z-[10003] hidden rounded-md bg-slate-900 px-2.5 py-1.5 text-xs text-white shadow-lg"></div>

  <!-- STAFF DETAIL DRAWER -->
  <div id="staffDetailModal" class="erp fixed inset-0 z-[10000] hidden" role="dialog" aria-modal="true" aria-labelledby="sdmName">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[2px]" onclick="closeStaffDetail()"></div>
    <aside class="absolute inset-y-0 right-0 flex w-full max-w-[560px] flex-col bg-white shadow-drawer">
      <header class="border-b border-slate-200 px-5 pt-4">
        <div class="flex items-start gap-3">
          <div id="sdmAv" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg text-lg font-semibold text-white"></div>
          <div class="min-w-0 flex-1">
            <div id="sdmName" class="truncate text-base font-semibold text-slate-900"></div>
            <div id="sdmNickname" class="truncate text-xs text-slate-500"></div>
            <div id="sdmStatusBar" class="mt-1.5 flex flex-wrap gap-1.5"></div>
          </div>
          <div class="flex items-center gap-1">
            <button id="sdmEditBtn" type="button" class="erp-btn erp-btn-secondary h-8 px-2.5" onclick="toggleEditMode(true)"><i class="bi bi-pencil-square" aria-hidden="true"></i> แก้ไข</button>
            <button id="sdmCancelBtn" type="button" class="erp-btn erp-btn-ghost h-8 px-2.5" onclick="toggleEditMode(false)" style="display:none;">ยกเลิก</button>
            <button id="sdmSaveBtn" type="button" class="erp-btn erp-btn-primary h-8 px-2.5" onclick="saveStaffEdit()" style="display:none;"><i class="bi bi-check2" aria-hidden="true"></i> บันทึก</button>
            <button type="button" class="erp-icon-btn" onclick="closeStaffDetail()" aria-label="ปิด"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
          </div>
        </div>
        <div class="mt-4 flex gap-1" role="tablist">
          <button type="button" class="erp-tab active" id="sdmTab1" onclick="sdmSwitchTab(1)" role="tab"><i class="bi bi-person-vcard" aria-hidden="true"></i> ข้อมูลทั่วไป</button>
          <button type="button" class="erp-tab" id="sdmTab2" onclick="sdmSwitchTab(2)" role="tab"><i class="bi bi-clock-history" aria-hidden="true"></i> ประวัติ 7 วัน</button>
        </div>
      </header>

      <div class="flex-1 overflow-y-auto bg-slate-50/60 p-5">
        <div id="sdmPanel1" class="space-y-4">
          <%
            const groups = [
              { title: 'วันนี้', fields: [
                { key: 'TimeIn', label: 'เวลาเข้างาน', icon: 'bi-box-arrow-in-right' },
                { key: 'TimeOut', label: 'เวลาออกงาน', icon: 'bi-box-arrow-right' },
                { key: 'Hours', label: 'ชั่วโมงทำงาน', icon: 'bi-hourglass-split' },
                { key: 'Shift', label: 'กะ', icon: 'bi-arrow-repeat' }
              ]},
              { title: 'ข้อมูลงาน', fields: [
                { key: 'Id', label: 'รหัสพนักงาน', icon: 'bi-fingerprint' },
                { key: 'Role', label: 'สถานะบุคลากร', icon: 'bi-award' },
                { key: 'Dept', label: 'กลุ่มงาน', icon: 'bi-diagram-3', wide: true },
                { key: 'StartDate', label: 'วันเริ่มงาน', icon: 'bi-calendar-event' },
                { key: 'Cid', label: 'เลขบัตรประชาชน', icon: 'bi-person-vcard' }
              ]},
              { title: 'ข้อมูลติดต่อ', fields: [
                { key: 'NicknameField', inputKey: 'Nickname', label: 'ชื่อเล่น', icon: 'bi-emoji-smile', input: 'text' },
                { key: 'Phone', label: 'โทรศัพท์', icon: 'bi-telephone', input: 'tel' },
                { key: 'Email', label: 'อีเมล', icon: 'bi-envelope', input: 'email', wide: true },
                { key: 'LineId', label: 'LINE User ID', icon: 'bi-line' },
                { key: 'TelegramId', label: 'Telegram Chat ID', icon: 'bi-telegram' }
              ]}
            ];
          %>
          <% groups.forEach(g => { %>
            <section class="erp-panel">
              <h4 class="border-b border-slate-100 px-4 py-2.5 text-2xs font-semibold uppercase tracking-wide text-slate-500"><%= g.title %></h4>
              <dl class="m-0 grid grid-cols-1 gap-x-4 gap-y-3 p-4 sm:grid-cols-2">
                <% g.fields.forEach(f => { %>
                  <div class="<%= f.wide ? 'sm:col-span-2' : '' %>">
                    <dt class="mb-1 flex items-center gap-1.5 text-2xs text-slate-500"><i class="bi <%= f.icon %>" aria-hidden="true"></i><%= f.label %></dt>
                    <dd class="m-0">
                      <div id="sdm<%= f.key %>" class="sdm-view-field min-h-[20px] break-all text-[13px] font-medium text-slate-800"></div>
                      <% if (f.input) { %>
                        <input id="sdm<%= f.inputKey || f.key %>Input" type="<%= f.input %>" class="sdm-edit-field erp-input" style="display:none;" aria-label="<%= f.label %>">
                      <% } %>
                    </dd>
                  </div>
                <% }); %>
              </dl>
            </section>
          <% }); %>
          <div class="flex justify-end">
            <button type="button" class="erp-btn erp-btn-secondary" onclick="const id=_currentStaffId; closeStaffDetail(); viewStaff(id);">
              <i class="bi bi-calendar2-week" aria-hidden="true"></i> ดูตารางเวร
            </button>
          </div>
        </div>

        <div id="sdmPanel2" style="display:none;">
          <section class="erp-panel overflow-hidden">
            <table class="w-full border-collapse text-left text-[13px]">
              <thead class="bg-slate-50 text-2xs uppercase tracking-wide text-slate-500">
                <tr class="border-b border-slate-200">
                  <th class="px-4 py-2.5 font-semibold">วันที่</th>
                  <th class="px-3 py-2.5 font-semibold">เข้า</th>
                  <th class="px-3 py-2.5 font-semibold">ออก</th>
                  <th class="px-3 py-2.5 text-right font-semibold">ชม.</th>
                  <th class="px-3 py-2.5 font-semibold">สถานะ</th>
                </tr>
              </thead>
              <tbody id="sdmHistBody" class="divide-y divide-slate-100"></tbody>
            </table>
          </section>
        </div>
      </div>
    </aside>
  </div>

  <script>
    /* ================================================================
       DATA (names kept global: staff-schedule-modal.js reads them)
    ================================================================ */
    const AV_COLORS = ['#DB2777', '#9333EA', '#0F766E', '#1D4ED8', '#B45309', '#475569', '#0E7490', '#9D174D'];
    const SHIFTS = {
      morning: { label: 'กะเช้า', time: '08:00–16:00', cls: 'morning', start: '08:00', end: '16:00' },
      afternoon: { label: 'กะบ่าย', time: '16:00–24:00', cls: 'afternoon', start: '16:00', end: '24:00' },
      night: { label: 'กะดึก', time: '00:00–08:00', cls: 'night', start: '00:00', end: '08:00' }
    };
    // Fixed status order + colours (validated: CVD-safe adjacent pairs; gray = neutral remainder)
    const STATUS = {
      in: { label: 'กำลังทำงาน', tone: 'green', color: '#10B981' },
      late: { label: 'มาสาย', tone: 'amber', color: '#F59E0B' },
      out: { label: 'ออกงานแล้ว', tone: 'sky', color: '#0EA5E9' },
      leave: { label: 'ลา / ไปราชการ', tone: 'violet', color: '#8B5CF6' },
      none: { label: 'ยังไม่บันทึก', tone: 'slate', color: '#CBD5E1' }
    };
    const STATUS_ORDER = ['in', 'late', 'out', 'leave', 'none'];

    let employees = [];
    let timelineData = [];
    let scanQueue = [];
    let serviceWorkData = [];
    let totalFaceFail = 0;

    const currentUserUsername = '<%= locals.user ? user.username : "" %>';
    const PER_PAGE = 10;
    let currentPage = 1;
    let filteredData = [];

    const $ = id => document.getElementById(id);
    const esc = ERP.escapeHtml;
    const statusKey = e => (STATUS[e.status] ? e.status : 'none');
    const cameIn = e => e.status === 'in' || e.status === 'late' || e.status === 'out';
    const shiftLabel = s => (s && SHIFTS[String(s).toLowerCase()] ? SHIFTS[String(s).toLowerCase()].label : (s || ''));
    const shiftShort = s => shiftLabel(s).replace(/^กะ/, '');
    const timeOf = v => (v && v !== '-' ? String(v).slice(0, 5) : '');
    const fmt = n => Number(n || 0).toLocaleString('th-TH');

    /* ================================================================
       STATS, DISTRIBUTION, DEPARTMENTS
    ================================================================ */
    function computeDeptStats(dept) {
      const data = employees.filter(e => e.dept === dept);
      const total = data.length;
      const present = data.filter(cameIn).length;
      const late = data.filter(e => e.status === 'late').length;
      const leave = data.filter(e => e.status === 'leave').length;
      const absent = data.filter(e => statusKey(e) === 'none').length;
      const expected = total - leave;
      const pct = expected > 0 ? Math.round((present / expected) * 100) : 0;
      return { dept, total, present, late, absent, leave, pct, expected };
    }

    function renderStats() {
      const came = employees.filter(cameIn).length;
      const leave = employees.filter(e => e.status === 'leave').length;
      const expected = employees.length - leave;
      $('totalStaff').textContent = fmt(employees.length);
      $('totalIn').textContent = fmt(came);
      $('rateSub').textContent = expected > 0 ? Math.round((came / expected) * 100) + '%' : '';
      $('totalLate').textContent = fmt(employees.filter(e => e.status === 'late').length);
      $('totalLeave').textContent = fmt(leave);
      $('totalAbsent').textContent = fmt(employees.filter(e => statusKey(e) === 'none').length);
      $('totalFaceFail').textContent = fmt(totalFaceFail);
    }

    function renderDistribution() {
      const total = employees.length;
      const counts = STATUS_ORDER.map(k => ({ key: k, n: employees.filter(e => statusKey(e) === k).length }));
      $('distTotal').textContent = `รวม ${fmt(total)} คน`;
      $('distBar').innerHTML = counts.filter(c => c.n > 0).map(c => {
        const pct = total ? Math.round((c.n / total) * 100) : 0;
        return `<div class="h-full transition-opacity hover:opacity-80" style="flex:${c.n} 1 0;background:${STATUS[c.key].color}"
          data-tip="${esc(STATUS[c.key].label)} · ${fmt(c.n)} คน (${pct}%)"></div>`;
      }).join('');
      $('distLegend').innerHTML = counts.map(c => {
        const pct = total ? Math.round((c.n / total) * 100) : 0;
        return `<li class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-sm" style="background:${STATUS[c.key].color}"></span>
          ${esc(STATUS[c.key].label)} <span class="font-mono font-semibold text-slate-800">${fmt(c.n)}</span><span class="text-slate-400">(${pct}%)</span>
        </li>`;
      }).join('');
    }

    function renderDeptBreakdown() {
      const el = $('deptBreakdown');
      const stats = ERP.uniqueSorted(employees, 'dept').map(computeDeptStats).filter(s => s.total > 0)
        .sort((a, b) => a.pct - b.pct || b.total - a.total);
      if (!stats.length) {
        el.innerHTML = '<p class="col-span-full py-6 text-center text-xs text-slate-400">ไม่มีข้อมูล</p>';
        return;
      }
      el.innerHTML = stats.map(s => `
        <button type="button" class="group block w-full rounded text-left" data-dept="${esc(s.dept)}"
          data-tip="${esc(s.dept)}<br>มา ${fmt(s.present)}/${fmt(s.expected)} · สาย ${fmt(s.late)} · ลา ${fmt(s.leave)} · ยังไม่บันทึก ${fmt(s.absent)}">
          <div class="mb-1 flex items-baseline justify-between gap-3 text-xs">
            <span class="truncate text-slate-700 group-hover:text-brand-700">${esc(s.dept.replace(/^กลุ่มงาน/, ''))}</span>
            <span class="shrink-0 font-mono text-slate-800"><span class="font-semibold">${s.pct}%</span> <span class="text-slate-400">${fmt(s.present)}/${fmt(s.expected)}</span></span>
          </div>
          <div class="h-1.5 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-brand-500" style="width:${s.pct}%"></div></div>
        </button>`).join('');
    }

    /* ================================================================
       TABLE
    ================================================================ */
    function applyFilter() {
      const search = $('searchInput').value.trim().toLowerCase();
      const dept = $('deptFilter').value;
      const shift = $('shiftFilter').value;
      filteredData = employees.filter(e => {
        if (dept && e.dept !== dept) return false;
        if (shift !== 'all' && e.shift !== shift) return false;
        if (!search) return true;
        return (e.name || '').toLowerCase().includes(search) ||
          String(e.id || '').toLowerCase().includes(search) ||
          (e.dept || '').toLowerCase().includes(search);
      });
      currentPage = 1;
      renderTable();
    }

    function renderTable() {
      const tbody = $('tableBody');
      const canManage = checkPermission('edit_staff');
      document.querySelectorAll('.admin-col').forEach(el => { el.style.display = canManage ? '' : 'none'; });
      $('rowCountSpan').textContent = fmt(filteredData.length);
      currentPage = ERP.pager($('pagination'), {
        page: currentPage, total: filteredData.length, perPage: PER_PAGE,
        onChange: p => { currentPage = p; renderTable(); }
      });
      const start = (currentPage - 1) * PER_PAGE;
      const pageData = filteredData.slice(start, start + PER_PAGE);
      $('pagerInfo').textContent = ERP.pagerText(start, pageData.length, filteredData.length);

      if (!pageData.length) {
        tbody.innerHTML = ERP.emptyRow(9, 'ไม่พบข้อมูลตามเงื่อนไขที่เลือก');
        return;
      }

      tbody.innerHTML = pageData.map((e, i) => {
        const key = statusKey(e);
        const label = key === 'leave' && e.leave_status ? e.leave_status : STATUS[key].label;
        const hours = Number(e.hours) || 0;
        const ot = e.ot && e.ot !== '0' ? e.ot : '';
        const tout = e.out && e.out !== e.in ? timeOf(e.out) : '';
        const id = esc(e.id || '');
        return `<tr class="transition-colors hover:bg-slate-50">
          <td class="px-4 py-2.5">
            <div class="flex min-w-[150px] items-center gap-2.5">
              ${ERP.avatar(e.name, e.id)}
              <div class="min-w-0">
                <div class="truncate font-medium text-slate-900">${esc(maskSensitiveData(e.name || 'ไม่มีชื่อ', 'view_name', e.id))}</div>
                <div class="font-mono text-2xs text-slate-400">${esc(maskSensitiveData(e.id || '', 'view_id', e.id))}</div>
              </div>
            </div>
          </td>
          <td class="max-w-[170px] px-3 py-2.5"><div class="truncate text-slate-600" title="${esc(e.dept || '')}">${esc((e.dept || '—').replace(/^กลุ่มงาน/, ''))}</div></td>
          <td class="whitespace-nowrap px-3 py-2.5 text-xs text-slate-600">${esc(shiftShort(e.shift) || '—')}</td>
          <td class="whitespace-nowrap px-3 py-2.5">${ERP.badge(label, STATUS[key].tone)}</td>
          <td class="px-3 py-2.5 text-center font-mono text-xs ${key === 'late' ? 'font-semibold text-amber-700' : 'text-slate-700'}">${esc(timeOf(e.in) || '--:--')}</td>
          <td class="px-3 py-2.5 text-center font-mono text-xs text-slate-700">${esc(tout || '--:--')}</td>
          <td class="whitespace-nowrap px-3 py-2.5 text-right font-mono text-xs ${hours ? 'text-slate-800' : 'text-slate-300'}">${hours ? hours.toFixed(1) : '–'}${ot ? ` <span class="text-brand-700">+${esc(ot)}</span>` : ''}</td>
          ${canManage ? `<td class="whitespace-nowrap px-4 py-1.5 text-right">
            <button type="button" class="erp-icon-btn h-8 w-8" data-act="detail" data-id="${id}" title="ดูข้อมูล" aria-label="ดูข้อมูล"><i class="bi bi-person-vcard"></i></button>
            <button type="button" class="erp-icon-btn h-8 w-8" data-act="schedule" data-id="${id}" title="ตารางเวร" aria-label="ตารางเวร"><i class="bi bi-calendar2-week"></i></button>
          </td>` : ''}
        </tr>`;
      }).join('');
    }

    /* ================================================================
       TIMELINE & LEAVE
    ================================================================ */
    function renderTimeline() {
      const el = $('timeline');
      if (!timelineData.length) {
        el.innerHTML = '<li class="px-4 py-10 text-center text-xs text-slate-400">ยังไม่มีการสแกน</li>';
        return;
      }
      el.innerHTML = timelineData.map(t => {
        const isIn = t.type === 'in' || t.type === 'i';
        const isOut = t.type === 'out' || t.type === 'o';
        const icon = isIn ? 'bi-box-arrow-in-right text-emerald-600 bg-emerald-50' : isOut ? 'bi-box-arrow-right text-sky-600 bg-sky-50' : 'bi-fingerprint text-slate-500 bg-slate-100';
        const temp = t.temp ? `<span class="${t.tempStatus === 'Normal' ? 'text-slate-500' : 'font-semibold text-red-600'}"><i class="bi bi-thermometer-half"></i>${esc(t.temp)}°C</span>` : '';
        return `<li class="flex items-start gap-3 px-4 py-2.5">
          <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-md ${icon.split(' ').slice(1).join(' ')}"><i class="bi ${icon.split(' ')[0]}"></i></span>
          <div class="min-w-0 flex-1">
            <div class="truncate text-[13px] font-medium text-slate-800">${esc(maskSensitiveData(t.name || 'ไม่ทราบชื่อ', 'view_name', t.id))}</div>
            <div class="flex flex-wrap gap-x-2 text-2xs text-slate-400">
              <span>${esc(t.action || '')}</span>
              ${t.location ? `<span><i class="bi bi-geo-alt"></i> ${esc(t.location)}</span>` : ''}
              ${temp}
            </div>
          </div>
          <span class="shrink-0 font-mono text-xs text-slate-600">${esc(timeOf(t.time))}</span>
        </li>`;
      }).join('');
    }

    function renderServiceWork() {
      const el = $('serviceWorkBody');
      if (!serviceWorkData || !serviceWorkData.length) {
        el.innerHTML = '<li class="px-4 py-10 text-center text-xs text-slate-400">ไม่มีการแจ้งลา / ไปราชการ</li>';
        return;
      }
      el.innerHTML = serviceWorkData.map(s => `
        <li class="px-4 py-2.5">
          <div class="truncate text-[13px] font-medium text-slate-800">${esc(maskSensitiveData(s.name, 'view_name', s.id))}</div>
          <div class="truncate text-2xs text-slate-400">${esc(s.dept || '')}</div>
          <div class="mt-1 flex flex-wrap gap-1.5 text-2xs">
            <span class="text-slate-400">เช้า</span>${ERP.badge(s.morning || '–', s.morning ? 'violet' : 'slate')}
            <span class="ml-1 text-slate-400">บ่าย</span>${ERP.badge(s.afternoon || '–', s.afternoon ? 'violet' : 'slate')}
          </div>
        </li>`).join('');
    }

    /* ================================================================
       EXPORT
    ================================================================ */
    function exportCSV() {
      if (!filteredData.length) return ERP.toast('ไม่มีข้อมูลสำหรับส่งออก');
      const header = ['ลำดับ', 'รหัส', 'ชื่อ', 'แผนก', 'กะ', 'สถานะ', 'เวลาเข้า', 'เวลาออก', 'ชั่วโมงทำงาน', 'OT'];
      const rows = filteredData.map((e, i) => {
        const key = statusKey(e);
        return [i + 1, e.id, e.name, e.dept, shiftLabel(e.shift), key === 'leave' && e.leave_status ? e.leave_status : STATUS[key].label,
          timeOf(e.in), e.out && e.out !== e.in ? timeOf(e.out) : '', Number(e.hours) ? Number(e.hours).toFixed(1) : '', e.ot && e.ot !== '0' ? e.ot : ''];
      });
      ERP.downloadCsv(`hospital_attendance_${$('dateInput').value}.csv`, header, rows);
    }

    /* ================================================================
       DATE / LOAD
    ================================================================ */
    function setHeadingDate() {
      const v = $('dateInput').value;
      $('headingDate').textContent = v === ERP.todayIso() ? '· วันนี้'
        : '· ' + new Date(v + 'T00:00:00').toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    function shiftDate(days) {
      const d = new Date(($('dateInput').value || ERP.todayIso()) + 'T00:00:00');
      d.setDate(d.getDate() + days);
      $('dateInput').value = d.toLocaleDateString('sv-SE');
      fetchData($('dateInput').value);
    }

    function setToday() {
      $('dateInput').value = ERP.todayIso();
      fetchData($('dateInput').value);
    }

    async function fetchData(date) {
      const target = date || $('dateInput').value;
      setHeadingDate();
      if (window.updateTopbarClock) window.updateTopbarClock();
      try {
        const s = loadSettings();
        const qs = new URLSearchParams({ date: target || '', lateMin: s.lateMin || 31, workStart: s.workStart || '08:00' });
        const res = await fetch(`/api/data?${qs}`, { headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(res.status);
        const db = await res.json();
        employees = db.employees || [];
        timelineData = db.timelineData || [];
        scanQueue = db.scanQueue || [];
        serviceWorkData = db.serviceWorkData || [];
        totalFaceFail = db.totalFaceFail || 0;
      } catch (err) {
        console.error('API Error:', err);
        ERP.toast('โหลดข้อมูลไม่สำเร็จ', 'error');
      }
      ERP.fillSelect($('deptFilter'), ERP.uniqueSorted(employees, 'dept'));
      renderStats();
      renderDistribution();
      renderDeptBreakdown();
      applyFilter();
      renderTimeline();
      renderServiceWork();
    }

    async function refreshData(btn) {
      const button = btn && btn.id === 'reloadBtn' ? btn : $('reloadBtn');
      button.disabled = true;
      await fetchData($('dateInput').value);
      button.disabled = false;
    }

    /* ================================================================
       STAFF DETAIL DRAWER
    ================================================================ */
    let _currentStaffId = null;
    let _currentPerson = null;
    const NA = '<span class="font-normal text-slate-400">–</span>';
    const setField = (id, value) => { $(id).innerHTML = value ? esc(value) : NA; };

    function sdmSwitchTab(n) {
      [1, 2].forEach(i => {
        $(`sdmTab${i}`).classList.toggle('active', i === n);
        $(`sdmPanel${i}`).style.display = i === n ? '' : 'none';
      });
      if (n === 2 && _currentStaffId) loadAttendanceHistory(_currentStaffId);
    }

    const canEditStaff = staffId => checkPermission('edit_staff') || String(staffId) === String(currentUserUsername);

    function toggleEditMode(isEdit) {
      $('sdmEditBtn').style.display = !isEdit && canEditStaff(_currentStaffId) ? '' : 'none';
      $('sdmSaveBtn').style.display = isEdit ? '' : 'none';
      $('sdmCancelBtn').style.display = isEdit ? '' : 'none';
      if (isEdit) {
        const p = _currentPerson || {};
        $('sdmNicknameInput').value = p.NICKNAME || '';
        $('sdmPhoneInput').value = p.HR_PHONE || '';
        $('sdmEmailInput').value = p.HR_EMAIL || '';
        sdmSwitchTab(1);
      }
      document.querySelectorAll('#sdmPanel1 dd').forEach(dd => {
        const input = dd.querySelector('.sdm-edit-field');
        if (!input) return;
        dd.querySelector('.sdm-view-field').style.display = isEdit ? 'none' : '';
        input.style.display = isEdit ? 'block' : 'none';
      });
    }

    function fillPersonFields(p, staffId) {
      _currentPerson = p;
      const nn = p && p.NICKNAME;
      $('sdmNickname').textContent = [nn && `ชื่อเล่น ${maskSensitiveData(nn, 'view_name', staffId)}`, maskSensitiveData(staffId, 'view_id', staffId)].filter(Boolean).join(' · ');
      setField('sdmNicknameField', nn);
      setField('sdmPhone', p && p.HR_PHONE ? maskSensitiveData(p.HR_PHONE, 'view_phone', staffId) : '');
      setField('sdmEmail', p && p.HR_EMAIL ? maskSensitiveData(p.HR_EMAIL, 'view_email', staffId) : '');
      setField('sdmStartDate', p && p.HR_STARTWORK_DATE ? new Date(p.HR_STARTWORK_DATE).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) : '');
      setField('sdmCid', p && p.HR_CID ? maskSensitiveData(p.HR_CID, 'view_id', staffId) : '');
      setField('sdmLineId', p && p.line_user_id);
      setField('sdmTelegramId', p && p.telegram_chat_id);
      if (p && !$('sdmName').textContent.trim()) $('sdmName').textContent = `${p.HR_FNAME || ''} ${p.HR_LNAME || ''}`.trim();
      if (p && !$('sdmDept').textContent.trim()) setField('sdmDept', p.HR_DEPARTMENT_NAME);
    }

    async function openStaffDetail(staffId) {
      if (!staffId) return;
      _currentStaffId = staffId;
      _currentPerson = null;
      const emp = employees.find(e => String(e.id) === String(staffId)) || {};
      const key = statusKey(emp);

      $('sdmAv').textContent = (emp.name || '?').charAt(0);
      $('sdmAv').style.background = ERP.avatarColor(staffId);
      $('sdmName').textContent = emp.name || '';
      $('sdmNickname').textContent = maskSensitiveData(staffId, 'view_id', staffId);
      $('sdmStatusBar').innerHTML = emp.id
        ? ERP.badge(key === 'leave' && emp.leave_status ? emp.leave_status : STATUS[key].label, STATUS[key].tone) +
          (emp.shift ? ERP.badge(shiftLabel(emp.shift), 'brand') : '')
        : '';
      setField('sdmId', staffId);
      $('sdmDept').innerHTML = emp.dept ? esc(emp.dept) : '';
      setField('sdmRole', emp.role);
      setField('sdmTimeIn', timeOf(emp.in));
      setField('sdmTimeOut', emp.out && emp.out !== emp.in ? timeOf(emp.out) : '');
      setField('sdmHours', Number(emp.hours) ? `${Number(emp.hours).toFixed(1)} ชม.` : '');
      setField('sdmShift', shiftLabel(emp.shift));
      ['sdmNicknameField', 'sdmPhone', 'sdmEmail', 'sdmStartDate', 'sdmCid', 'sdmLineId', 'sdmTelegramId']
        .forEach(id => { $(id).innerHTML = '<span class="text-2xs text-slate-400">กำลังโหลด…</span>'; });

      toggleEditMode(false);
      sdmSwitchTab(1);
      ERP.showOverlay($('staffDetailModal'), true);

      try {
        const res = await fetch(`/api/personnel/${encodeURIComponent(staffId)}`, { headers: { Accept: 'application/json' } });
        const data = res.ok ? await res.json() : {};
        fillPersonFields(data.person || null, staffId);
      } catch {
        fillPersonFields(null, staffId);
      }
    }

    async function saveStaffEdit() {
      // Only send the fields edited here — the API now updates just the columns provided
      const payload = {
        id: _currentStaffId,
        nickname: $('sdmNicknameInput').value.trim(),
        phone: $('sdmPhoneInput').value.trim(),
        email: $('sdmEmailInput').value.trim()
      };
      const btn = $('sdmSaveBtn');
      btn.disabled = true;
      try {
        const res = await fetch('/api/staff/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (!result.success) return ERP.toast('บันทึกไม่สำเร็จ: ' + (result.message || 'ไม่ทราบสาเหตุ'), 'error');
        fillPersonFields({ ...(_currentPerson || {}), NICKNAME: payload.nickname, HR_PHONE: payload.phone, HR_EMAIL: payload.email }, _currentStaffId);
        toggleEditMode(false);
        ERP.toast('บันทึกข้อมูลเรียบร้อยแล้ว', 'success');
      } catch {
        ERP.toast('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์', 'error');
      } finally {
        btn.disabled = false;
      }
    }

    function closeStaffDetail() {
      ERP.showOverlay($('staffDetailModal'), false);
      toggleEditMode(false);
    }

    const HISTORY_STATUS = {
      normal: ['ตรงเวลา', 'green'],
      late: ['มาสาย', 'amber'],
      leave: ['ลา', 'violet'],
      absent: ['ไม่พบการสแกน', 'slate']
    };

    async function loadAttendanceHistory(staffId) {
      const tbody = $('sdmHistBody');
      tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-10 text-center text-slate-400">กำลังโหลด…</td></tr>';
      try {
        const workStart = loadSettings().workStart || '08:00';
        const res = await fetch(`/api/attendance/history/${encodeURIComponent(staffId)}?workStart=${encodeURIComponent(workStart)}`, { headers: { Accept: 'application/json' } });
        const data = await res.json();
        const rows = (data.history || []).slice().reverse();
        if (!rows.length) {
          tbody.innerHTML = ERP.emptyRow(5, data.error || 'ไม่มีข้อมูลประวัติการเข้างาน');
          return;
        }
        tbody.innerHTML = rows.map(r => {
          const [label, tone] = HISTORY_STATUS[r.status] || HISTORY_STATUS.absent;
          const tin = timeOf(r.check_in);
          const tout = timeOf(r.check_out);
          let hours = '–';
          if (tin && tout) {
            const [hi, mi] = tin.split(':').map(Number);
            const [ho, mo] = tout.split(':').map(Number);
            const mins = ho * 60 + mo - (hi * 60 + mi);
            if (mins > 0) hours = (mins / 60).toFixed(1);
          }
          return `<tr>
            <td class="px-4 py-2.5 text-slate-700">${new Date(r.date + 'T00:00:00').toLocaleDateString('th-TH', { weekday: 'short', day: 'numeric', month: 'short' })}</td>
            <td class="px-3 py-2.5 font-mono text-xs">${esc(tin || '–')}</td>
            <td class="px-3 py-2.5 font-mono text-xs">${esc(tout || '–')}</td>
            <td class="px-3 py-2.5 text-right font-mono text-xs">${hours}</td>
            <td class="px-3 py-2.5">${ERP.badge(label, tone)}</td>
          </tr>`;
        }).join('');
      } catch {
        tbody.innerHTML = ERP.emptyRow(5, 'โหลดประวัติไม่สำเร็จ', 'bi-exclamation-triangle');
      }
    }

    /* ================================================================
       EVENTS
    ================================================================ */
    // Chart tooltip (distribution bar + department rows)
    (function initChartTip() {
      const tip = $('chartTip');
      document.addEventListener('mousemove', e => {
        const target = e.target.closest('[data-tip]');
        if (!target) { tip.classList.add('hidden'); return; }
        tip.innerHTML = target.dataset.tip;
        tip.classList.remove('hidden');
        const x = Math.min(e.clientX + 12, window.innerWidth - tip.offsetWidth - 8);
        tip.style.left = x + 'px';
        tip.style.top = (e.clientY + 14) + 'px';
      });
    })();

    $('tableBody').addEventListener('click', e => {
      const btn = e.target.closest('button[data-act]');
      if (!btn) return;
      if (btn.dataset.act === 'detail') openStaffDetail(btn.dataset.id);
      else viewStaff(btn.dataset.id);
    });

    // Clicking a department bar filters the table to that department
    $('deptBreakdown').addEventListener('click', e => {
      const row = e.target.closest('[data-dept]');
      if (!row) return;
      $('deptFilter').value = row.dataset.dept;
      applyFilter();
      $('attendanceTableCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    $('dateInput').addEventListener('change', e => fetchData(e.target.value));

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !$('staffDetailModal').classList.contains('hidden')) closeStaffDetail();
    });

    $('dateInput').value = ERP.todayIso();
    fetchData($('dateInput').value);
  </script>

  <%- include("components/staff-schedule-modal") %>
  <script src="<%= asset('/js/staff-schedule-modal.js') %>"></script>
</body>

</html>
