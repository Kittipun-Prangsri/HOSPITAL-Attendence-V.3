<!DOCTYPE html>
<html lang="th">

<head>
  <%- include("components/erp-head", { title: "จัดตารางเวร" }) %>
  <style>
    /* Shift cell colours (kept in CSS so JS can swap one class per cell) */
    .sc-off { background: #fff; color: #94a3b8; }
    .sc-morning { background: #fef3c7; color: #92400e; }
    .sc-afternoon { background: #e0f2fe; color: #075985; }
    .sc-night { background: #ede9fe; color: #5b21b6; }
    .sc-leave { background: #ffe4e6; color: #be123c; }
    .sc-today { box-shadow: inset 0 0 0 2px #db2777; }
    .sc-weekend.sc-off { background: #f8fafc; }
    .shift-select { appearance: none; -webkit-appearance: none; background: transparent; border: 0; width: 100%; height: 30px;
      text-align: center; text-align-last: center; font: inherit; font-size: 11px; font-weight: 600; color: inherit; cursor: pointer; outline: none; }
    .shift-select:focus-visible { box-shadow: inset 0 0 0 2px #ec4899; border-radius: 4px; }
    .shift-select:disabled { cursor: not-allowed; }
  </style>
</head>

<body class="erp-page">
  <%- include("components/sidebar") %>
  <div class="main" role="main">
    <%- include("components/topbar") %>
    <% const months = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"]; %>
    <% const now = new Date(); const currentMonth = now.getMonth() + 1; const currentYear = now.getFullYear(); %>

    <div class="erp px-4 py-5 lg:px-6">
      <section class="mb-5 flex flex-wrap items-end justify-between gap-4" aria-labelledby="scheduling-heading">
        <div>
          <h2 id="scheduling-heading" class="flex items-center gap-2 text-xl font-semibold text-slate-900">
            จัดตารางเวรพยาบาล
            <span id="dirtyBadge" class="erp-badge hidden bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200"><i class="bi bi-pencil"></i> ยังไม่บันทึก</span>
          </h2>
          <p class="mt-1 text-[13px] text-slate-500">วางแผนการปฏิบัติงานรายเดือนสำหรับกลุ่มงานการพยาบาล</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="erp-btn erp-btn-secondary" id="btnAuditLog" onclick="openAuditLog()"><i class="bi bi-clock-history" aria-hidden="true"></i> ประวัติการแก้ไข</button>
          <button type="button" class="erp-btn erp-btn-secondary" onclick="exportExcel()"><i class="bi bi-download" aria-hidden="true"></i> ส่งออก CSV</button>
          <button type="button" class="erp-btn erp-btn-secondary" id="btnAutoGen" onclick="autoGenerate()"><i class="bi bi-magic" aria-hidden="true"></i> จัดเวรอัตโนมัติ</button>
          <button type="button" class="erp-btn erp-btn-primary" id="btnSave" onclick="saveSchedule()"><i class="bi bi-floppy" aria-hidden="true"></i> บันทึกตารางเวร</button>
        </div>
      </section>

      <section class="erp-panel mb-5 grid grid-cols-2 sm:grid-cols-5 sm:divide-x sm:divide-slate-100" aria-label="สรุปเวร">
        <% [['statNurses','พยาบาลทั้งหมด','bi-people','text-brand-600'],['statMorning','เวรเช้า (ครั้ง)','bi-brightness-high','text-amber-600'],
            ['statAfternoon','เวรบ่าย (ครั้ง)','bi-cloud-sun','text-sky-600'],['statNight','เวรดึก (ครั้ง)','bi-moon-stars','text-violet-600'],
            ['statLeave','ลา / บล็อค','bi-calendar-x','text-red-600']].forEach(([id, label, icon, tone]) => { %>
          <div class="p-4">
            <div class="flex items-center justify-between text-xs text-slate-500"><span class="truncate"><%= label %></span><i class="bi <%= icon %> <%= tone %>" aria-hidden="true"></i></div>
            <div id="<%= id %>" class="mt-1 font-mono text-2xl font-semibold tabular-nums text-slate-900">–</div>
          </div>
        <% }); %>
      </section>

      <section class="erp-panel overflow-hidden" aria-labelledby="gridTitle">
        <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 p-3">
          <select id="monthSelect" class="erp-input w-auto" onchange="initGrid()" aria-label="เดือน">
            <% months.forEach((m, i) => { %><option value="<%= i + 1 %>" <%= (i + 1) === currentMonth ? 'selected' : '' %>><%= m %></option><% }); %>
          </select>
          <select id="yearSelect" class="erp-input w-auto" onchange="initGrid()" aria-label="ปี">
            <% for (let y = currentYear - 1; y <= currentYear + 1; y++) { %><option value="<%= y %>" <%= y === currentYear ? 'selected' : '' %>><%= y + 543 %></option><% } %>
          </select>
          <button type="button" class="erp-btn erp-btn-ghost" onclick="initGrid()"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> โหลดใหม่</button>
          <div class="ml-2 min-w-0">
            <div id="gridTitle" class="truncate text-[13px] font-semibold text-slate-800">ตารางเวรประจำเดือน</div>
            <div id="gridSub" class="text-2xs text-slate-400">กำลังโหลดข้อมูล…</div>
          </div>
          <div class="ml-auto flex items-center gap-2 text-2xs text-slate-400">
            <span id="nurseCountBadge" class="erp-badge bg-brand-50 text-brand-700 ring-1 ring-inset ring-brand-200"></span>
            <span id="lastFetchInfo"></span>
          </div>
        </div>

        <div class="relative max-h-[calc(100vh-330px)] min-h-[300px] overflow-auto">
          <table class="w-full border-separate border-spacing-0 text-center text-[11px]" id="schedTable">
            <thead id="schedHeader"></thead>
            <tbody id="schedBody">
              <tr><td class="px-4 py-16 text-center text-[13px] text-slate-400"><i class="bi bi-hourglass-split mr-1"></i> กำลังโหลดข้อมูล…</td></tr>
            </tbody>
            <tfoot id="schedFoot"></tfoot>
          </table>
          <div id="loadingOverlay" class="absolute inset-0 z-40 hidden items-center justify-center bg-white/70 backdrop-blur-[1px]">
            <div class="flex items-center gap-2 rounded-md bg-white px-4 py-2 text-[13px] text-slate-600 shadow ring-1 ring-slate-200">
              <span class="h-4 w-4 animate-spin rounded-full border-2 border-slate-200 border-t-brand-600"></span> กำลังประมวลผล…
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-slate-200 bg-slate-50/70 px-4 py-2.5 text-xs text-slate-600">
          <span class="flex items-center gap-1.5"><span class="sc-morning h-3 w-3 rounded-sm ring-1 ring-amber-200"></span>เช้า</span>
          <span class="flex items-center gap-1.5"><span class="sc-afternoon h-3 w-3 rounded-sm ring-1 ring-sky-200"></span>บ่าย</span>
          <span class="flex items-center gap-1.5"><span class="sc-night h-3 w-3 rounded-sm ring-1 ring-violet-200"></span>ดึก</span>
          <span class="flex items-center gap-1.5"><span class="sc-leave h-3 w-3 rounded-sm ring-1 ring-red-200"></span>ลา (ระบบบล็อค)</span>
          <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm bg-white ring-1 ring-slate-200"></span>OFF</span>
          <span class="ml-auto text-2xs text-slate-400">Auto-Gen: หยุดอย่างน้อย 1 วัน/สัปดาห์ · ไม่ขึ้นเวรซ้ำวันเดียวกัน · บล็อควันลา</span>
        </div>
      </section>
    </div>
  </div>

  <!-- AUDIT LOG DRAWER -->
  <div id="auditLogModal" class="erp fixed inset-0 z-[10000] hidden" role="dialog" aria-modal="true" aria-labelledby="auditTitle">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[2px]" onclick="closeAuditLog()"></div>
    <aside class="absolute inset-y-0 right-0 flex w-full max-w-[640px] flex-col bg-white shadow-drawer">
      <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
        <h3 id="auditTitle" class="text-base font-semibold text-slate-900"><i class="bi bi-clock-history text-brand-600" aria-hidden="true"></i> ประวัติการแก้ไขตารางเวร</h3>
        <button type="button" class="erp-icon-btn" onclick="closeAuditLog()" aria-label="ปิด"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
      </header>
      <div class="flex-1 overflow-auto">
        <table class="w-full border-collapse text-left text-[13px]">
          <thead class="sticky top-0 bg-slate-50 text-2xs uppercase tracking-wide text-slate-500">
            <tr class="border-b border-slate-200">
              <th class="px-4 py-2.5 font-semibold">พนักงาน</th>
              <th class="px-3 py-2.5 font-semibold">วันที่</th>
              <th class="px-3 py-2.5 font-semibold">การเปลี่ยนแปลง</th>
              <th class="px-3 py-2.5 font-semibold">แก้ไขโดย</th>
              <th class="px-4 py-2.5 font-semibold">เมื่อ</th>
            </tr>
          </thead>
          <tbody id="auditLogBody" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
    </aside>
  </div>

  <script>
    const DAY_NAMES_TH = ['อา', 'จ', 'อ', 'พ', 'พฤ', 'ศ', 'ส'];
    const MONTH_NAMES_TH = [''].concat(<%- JSON.stringify(months) %>);
    const SHIFT_CLASS = { 'เช้า': 'sc-morning', 'บ่าย': 'sc-afternoon', 'ดึก': 'sc-night', 'ลา': 'sc-leave' };
    const $ = id => document.getElementById(id);
    const esc = ERP.escapeHtml;

    let nurses = [];
    let scheduleData = {};   // { nurseId: { day: shiftName } }
    let monthLeaveData = {}; // { 'YYYY-MM-DD': { name: true } }
    let dirty = false;

    const period = () => {
      const month = Number($('monthSelect').value);
      const year = Number($('yearSelect').value);
      return { month, year, days: new Date(year, month, 0).getDate() };
    };
    const dateKey = (y, m, d) => `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
    const shiftNames = () => ((window.loadSettings && window.loadSettings().shifts) || []).map(s => s.name).filter(Boolean);
    const cellClass = v => SHIFT_CLASS[v] || 'sc-off';

    function setDirty(value) {
      dirty = value;
      $('dirtyBadge').classList.toggle('hidden', !value);
    }
    window.addEventListener('beforeunload', e => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });

    function showLoading(show) {
      $('loadingOverlay').classList.toggle('hidden', !show);
      $('loadingOverlay').classList.toggle('flex', show);
    }

    /* ---------------- Load ---------------- */
    async function initGrid() {
      if (dirty && !confirm('มีการแก้ไขที่ยังไม่บันทึก ต้องการโหลดใหม่และทิ้งการแก้ไขหรือไม่?')) return;
      showLoading(true);
      const { month, year, days } = period();
      $('gridTitle').textContent = `ตารางเวรประจำเดือน${MONTH_NAMES_TH[month]} ${year + 543}`;
      $('gridSub').textContent = `${days} วัน · กลุ่มงานการพยาบาล`;
      await fetchGridData(year, month);
      renderGrid();
      updateStats();
      setDirty(false);
      $('lastFetchInfo').textContent = `อัปเดต ${new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' })}`;
      showLoading(false);
    }

    function readLocal(year, month) {
      try { return JSON.parse(localStorage.getItem(`schedule_${year}_${month}`)) || {}; } catch { return {}; }
    }

    async function fetchGridData(year, month) {
      try {
        const res = await fetch('/api/data', { headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error('API error');
        const db = await res.json();
        nurses = (db.employees || []).filter(e => e.dept === 'กลุ่มงานการพยาบาล');

        try {
          const loadRes = await fetch(`/api/schedule/load?year=${year}&month=${month}`, { headers: { Accept: 'application/json' } });
          const loaded = loadRes.ok ? await loadRes.json() : null;
          scheduleData = loaded && loaded.success && loaded.data && loaded.data.schedule ? loaded.data.schedule : readLocal(year, month);
        } catch (loadErr) {
          console.error('Error loading schedule:', loadErr);
          scheduleData = readLocal(year, month);
        }
        nurses.forEach(n => { if (!scheduleData[n.id]) scheduleData[n.id] = {}; });
        $('nurseCountBadge').textContent = `พยาบาล ${nurses.length} คน`;

        // /api/data only reports today's leave, so only today's column is blocked
        const todayStr = ERP.todayIso();
        monthLeaveData = {};
        (db.serviceWorkData || []).forEach(sw => {
          const isText = v => v && String(v).trim() !== '' && !/^\d{2}:\d{2}/.test(v);
          if (isText(sw.morning) || isText(sw.afternoon)) {
            (monthLeaveData[todayStr] = monthLeaveData[todayStr] || {})[sw.name] = true;
          }
        });
      } catch (err) {
        console.error('Fetch error:', err);
        nurses = [];
        ERP.toast('ไม่สามารถดึงข้อมูลจาก API ได้', 'error');
      }
    }

    /* ---------------- Render ---------------- */
    function renderGrid() {
      const { month, year, days } = period();
      const todayStr = ERP.todayIso();
      const options = shiftNames();
      const stickyName = 'sticky left-0 z-10 min-w-[200px] max-w-[200px] border-b border-r-2 border-slate-200 border-r-slate-300 bg-white px-3 py-1.5 text-left';

      let head = `<tr><th class="${stickyName} top-0 z-30 bg-slate-50 py-2 text-2xs font-semibold uppercase tracking-wide text-slate-500">บุคลากร</th>`;
      for (let d = 1; d <= days; d++) {
        const dow = new Date(year, month - 1, d).getDay();
        const isToday = dateKey(year, month, d) === todayStr;
        const tone = isToday ? 'bg-brand-600 text-white' : dow === 0 || dow === 6 ? 'bg-slate-100 text-slate-400' : 'bg-slate-50 text-slate-600';
        head += `<th class="sticky top-0 z-20 min-w-[44px] border-b border-r border-slate-200 px-0.5 py-1.5 ${tone}"><div class="text-[13px] font-semibold leading-none">${d}</div><div class="text-[9px] font-normal">${DAY_NAMES_TH[dow]}</div></th>`;
      }
      head += ['เช้า', 'บ่าย', 'ดึก', 'OFF'].map(l => `<th class="sticky top-0 z-20 min-w-[40px] border-b border-r border-slate-200 bg-slate-50 px-1 py-1.5 text-2xs font-semibold text-slate-500">${l}</th>`).join('') + '</tr>';
      $('schedHeader').innerHTML = head;

      if (!nurses.length) {
        $('schedBody').innerHTML = `<tr><td colspan="${days + 5}" class="px-4 py-16 text-center text-[13px] text-slate-400"><i class="bi bi-people mb-2 block text-2xl"></i>ไม่พบข้อมูลบุคลากรกลุ่มงานการพยาบาล</td></tr>`;
        $('schedFoot').innerHTML = '';
        return;
      }

      $('schedBody').innerHTML = nurses.map(nurse => {
        let row = `<tr class="group"><td class="${stickyName} group-hover:bg-brand-50/60">
          <div class="flex items-center gap-2">${ERP.avatar(nurse.name, nurse.id, 'h-7 w-7 text-2xs')}
            <div class="min-w-0"><div class="truncate text-xs font-medium text-slate-900">${esc(nurse.name)}</div>
            <div class="truncate text-[10px] text-slate-400">${esc(nurse.role || 'พยาบาลวิชาชีพ')}</div></div>
          </div></td>`;
        for (let d = 1; d <= days; d++) {
          const dk = dateKey(year, month, d);
          const dow = new Date(year, month - 1, d).getDay();
          const onLeave = monthLeaveData[dk] && monthLeaveData[dk][nurse.name];
          const value = onLeave ? 'ลา' : (scheduleData[nurse.id][d] || 'OFF');
          const cls = [cellClass(value), dk === todayStr ? 'sc-today' : '', dow === 0 || dow === 6 ? 'sc-weekend' : ''].join(' ');
          const opts = ['OFF', ...options, 'ลา'].map(o => `<option value="${esc(o)}" ${o === value ? 'selected' : ''}>${esc(o)}</option>`).join('');
          row += `<td class="${cls} border-b border-r border-slate-100 p-0"><select class="shift-select" data-nurse="${esc(nurse.id)}" data-day="${d}" ${onLeave ? 'disabled' : ''} aria-label="${esc(nurse.name)} วันที่ ${d}">${opts}</select></td>`;
        }
        row += `<td class="border-b border-r border-slate-100 font-mono text-2xs text-amber-700" data-total="${esc(nurse.id)}:เช้า"></td>
          <td class="border-b border-r border-slate-100 font-mono text-2xs text-sky-700" data-total="${esc(nurse.id)}:บ่าย"></td>
          <td class="border-b border-r border-slate-100 font-mono text-2xs text-violet-700" data-total="${esc(nurse.id)}:ดึก"></td>
          <td class="border-b border-r border-slate-100 font-mono text-2xs text-slate-400" data-total="${esc(nurse.id)}:OFF"></td></tr>`;
        return row;
      }).join('');

      // Coverage footer: staff count per shift per day
      const footRow = (label, shift, tone) => {
        let html = `<tr><th class="sticky left-0 z-10 border-r-2 border-t border-slate-200 border-r-slate-300 bg-slate-50 px-3 py-1 text-left text-2xs font-semibold ${tone}">${label}</th>`;
        for (let d = 1; d <= days; d++) html += `<td class="border-r border-t border-slate-200 bg-slate-50 py-1 font-mono text-2xs ${tone}" data-cover="${d}:${shift}"></td>`;
        return html + '<td colspan="4" class="border-t border-slate-200 bg-slate-50"></td></tr>';
      };
      $('schedFoot').innerHTML = footRow('คนเวรเช้า', 'เช้า', 'text-amber-700') + footRow('คนเวรบ่าย', 'บ่าย', 'text-sky-700') + footRow('คนเวรดึก', 'ดึก', 'text-violet-700');
    }

    function valueOf(nurse, d) {
      const { month, year } = period();
      const dk = dateKey(year, month, d);
      if (monthLeaveData[dk] && monthLeaveData[dk][nurse.name]) return 'ลา';
      return scheduleData[nurse.id]?.[d] || 'OFF';
    }

    function updateStats() {
      const { days } = period();
      const totals = { 'เช้า': 0, 'บ่าย': 0, 'ดึก': 0, 'ลา': 0 };
      const cover = {};
      nurses.forEach(n => {
        const mine = { 'เช้า': 0, 'บ่าย': 0, 'ดึก': 0, OFF: 0 };
        for (let d = 1; d <= days; d++) {
          const v = valueOf(n, d);
          if (v in totals) totals[v]++;
          if (v in mine) mine[v]++;
          cover[`${d}:${v}`] = (cover[`${d}:${v}`] || 0) + 1;
        }
        Object.entries(mine).forEach(([k, c]) => {
          const cell = document.querySelector(`[data-total="${CSS.escape(String(n.id))}:${k}"]`);
          if (cell) cell.textContent = c || '–';
        });
      });
      document.querySelectorAll('[data-cover]').forEach(td => { td.textContent = cover[td.dataset.cover] || '–'; });
      $('statNurses').textContent = nurses.length;
      $('statMorning').textContent = totals['เช้า'];
      $('statAfternoon').textContent = totals['บ่าย'];
      $('statNight').textContent = totals['ดึก'];
      $('statLeave').textContent = totals['ลา'];
    }

    function updateShift(nurseId, day, value) {
      if (!scheduleData[nurseId]) scheduleData[nurseId] = {};
      scheduleData[nurseId][day] = value;
      setDirty(true);
      updateStats();
    }

    $('schedBody').addEventListener('change', e => {
      const sel = e.target.closest('.shift-select');
      if (!sel) return;
      updateShift(sel.dataset.nurse, Number(sel.dataset.day), sel.value);
      const td = sel.closest('td');
      td.classList.remove('sc-off', 'sc-morning', 'sc-afternoon', 'sc-night', 'sc-leave');
      td.classList.add(cellClass(sel.value));
    });

    /* ---------------- Auto-generate ---------------- */
    function autoGenerate() {
      if (!nurses.length) return ERP.toast('ไม่มีข้อมูลพยาบาล กรุณาโหลดข้อมูลก่อน', 'error');
      if (!confirm('จัดเวรอัตโนมัติจะเขียนทับตารางเดือนนี้ทั้งหมด ต้องการดำเนินการต่อหรือไม่?')) return;
      const { month, year, days } = period();
      const names = shiftNames();
      nurses.forEach(nurse => {
        let weekWorkCount = 0;
        for (let day = 1; day <= days; day++) {
          const dk = dateKey(year, month, day);
          if (monthLeaveData[dk] && monthLeaveData[dk][nurse.name]) { scheduleData[nurse.id][day] = 'ลา'; continue; }
          if (weekWorkCount >= 6) { scheduleData[nurse.id][day] = 'OFF'; weekWorkCount = 0; continue; }
          if (Math.random() > 0.3 && names.length) {
            scheduleData[nurse.id][day] = names[Math.floor(Math.random() * names.length)];
            weekWorkCount++;
          } else {
            scheduleData[nurse.id][day] = 'OFF';
            weekWorkCount = 0;
          }
          if (day % 7 === 0) weekWorkCount = 0;
        }
      });
      renderGrid();
      updateStats();
      setDirty(true);
      ERP.toast('จัดตารางเวรอัตโนมัติแล้ว ตรวจสอบและกดบันทึก', 'success');
    }

    /* ---------------- Save ---------------- */
    async function saveSchedule() {
      if (!nurses.length) return ERP.toast('ไม่มีข้อมูลตารางเวร', 'error');
      const { month, year } = period();
      const btn = $('btnSave');
      btn.disabled = true;
      showLoading(true);
      try {
        const res = await fetch('/api/schedule/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ year, month, schedule: scheduleData })
        });
        if (res.ok) {
          setDirty(false);
          ERP.toast('บันทึกตารางเวรสำเร็จ', 'success');
        } else if (res.status === 404) {
          localStorage.setItem(`schedule_${year}_${month}`, JSON.stringify(scheduleData));
          setDirty(false);
          ERP.toast('บันทึกไว้ในเบราว์เซอร์นี้ (ไม่พบ API บันทึก)');
        } else {
          ERP.toast('เกิดข้อผิดพลาดในการบันทึก', 'error');
        }
      } catch {
        localStorage.setItem(`schedule_${year}_${month}`, JSON.stringify(scheduleData));
        ERP.toast('เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ บันทึกไว้ในเบราว์เซอร์ชั่วคราว', 'error');
      } finally {
        btn.disabled = false;
        showLoading(false);
      }
    }

    /* ---------------- Export ---------------- */
    function exportExcel() {
      if (!nurses.length) return ERP.toast('ไม่มีข้อมูลสำหรับส่งออก', 'error');
      const { month, year, days } = period();
      const header = ['บุคลากร', 'ตำแหน่ง'];
      for (let d = 1; d <= days; d++) header.push(`${d}(${DAY_NAMES_TH[new Date(year, month - 1, d).getDay()]})`);
      header.push('รวมเช้า', 'รวมบ่าย', 'รวมดึก', 'รวมOFF');
      const rows = nurses.map(n => {
        const c = { 'เช้า': 0, 'บ่าย': 0, 'ดึก': 0, OFF: 0 };
        const row = [n.name, n.role || ''];
        for (let d = 1; d <= days; d++) { const v = valueOf(n, d); row.push(v); if (v in c) c[v]++; }
        return row.concat([c['เช้า'], c['บ่าย'], c['ดึก'], c.OFF]);
      });
      ERP.downloadCsv(`Nurse_Schedule_${year}_${String(month).padStart(2, '0')}.csv`, header, rows);
    }

    /* ---------------- Audit log ---------------- */
    function openAuditLog() {
      ERP.showOverlay($('auditLogModal'), true);
      loadAuditLog();
    }

    function closeAuditLog() {
      ERP.showOverlay($('auditLogModal'), false);
    }

    async function loadAuditLog() {
      const body = $('auditLogBody');
      body.innerHTML = '<tr><td colspan="5" class="px-4 py-12 text-center text-slate-400">กำลังโหลด…</td></tr>';
      try {
        const res = await fetch('/api/schedule/audit', { headers: { Accept: 'application/json' } });
        const data = await res.json();
        const log = (data && data.log) || [];
        body.innerHTML = log.length
          ? log.map(e => `<tr class="hover:bg-slate-50">
              <td class="px-4 py-2.5 font-medium text-slate-900">${esc(e.employeeName)}</td>
              <td class="whitespace-nowrap px-3 py-2.5 font-mono text-xs">${esc(e.date)}</td>
              <td class="whitespace-nowrap px-3 py-2.5 text-xs">${ERP.badge(e.previousShift || 'OFF', 'slate')} <i class="bi bi-arrow-right text-slate-400"></i> ${ERP.badge(e.newShift || 'OFF', 'brand')}</td>
              <td class="px-3 py-2.5 text-xs text-slate-600">${esc(e.changedBy || '—')}</td>
              <td class="whitespace-nowrap px-4 py-2.5 text-xs text-slate-500">${e.changedAt ? new Date(e.changedAt).toLocaleString('th-TH') : '—'}</td>
            </tr>`).join('')
          : ERP.emptyRow(5, 'ไม่มีประวัติการแก้ไข');
      } catch {
        body.innerHTML = ERP.emptyRow(5, 'โหลดประวัติการแก้ไขไม่สำเร็จ', 'bi-exclamation-triangle');
      }
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !$('auditLogModal').classList.contains('hidden')) closeAuditLog();
    });

    initGrid();
  </script>
</body>

</html>
