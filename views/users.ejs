<!DOCTYPE html>
<html lang="th">

<head>
  <%- include("components/erp-head", { title: "จัดการผู้เข้าใช้" }) %>
</head>

<body class="erp-page">
  <%- include('components/sidebar') %>
  <div class="main" role="main">
    <%- include('components/topbar') %>

    <div class="erp px-4 py-5 lg:px-6">

      <!-- Page header -->
      <section class="mb-5 flex flex-wrap items-end justify-between gap-4" aria-labelledby="users-heading">
        <div>
          <h2 id="users-heading" class="text-xl font-semibold text-slate-900">จัดการผู้เข้าใช้งาน</h2>
          <p class="mt-1 text-[13px] text-slate-500">กำหนดระดับสิทธิ์ ช่องทางแจ้งเตือน และดูแลบัญชีผู้ใช้งานระบบ</p>
        </div>
        <button type="button" class="erp-btn erp-btn-primary" onclick="openModal()">
          <i class="bi bi-person-plus" aria-hidden="true"></i> เพิ่มผู้ใช้งาน
        </button>
      </section>

      <!-- KPI strip -->
      <section class="mb-5 grid grid-cols-2 gap-3 xl:grid-cols-4" aria-label="สรุปผู้ใช้งาน">
        <% const kpis = [
          { id: 'kpiUsers', label: 'บัญชีผู้ใช้ทั้งหมด', icon: 'bi-person-badge', tone: 'bg-brand-50 text-brand-600' },
          { id: 'kpiSuper', label: 'Super Admin', icon: 'bi-shield-lock', tone: 'bg-red-50 text-red-600' },
          { id: 'kpiAdmin', label: 'ผู้ดูแลระบบ', icon: 'bi-person-gear', tone: 'bg-amber-50 text-amber-600' },
          { id: 'kpiLinked', label: 'เชื่อมช่องทางแจ้งเตือน', icon: 'bi-bell', tone: 'bg-sky-50 text-sky-600' }
        ]; %>
        <% kpis.forEach(k => { %>
          <div class="erp-panel flex items-center gap-3 p-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md text-lg <%= k.tone %>"><i class="bi <%= k.icon %>" aria-hidden="true"></i></div>
            <div class="min-w-0">
              <div class="truncate text-xs text-slate-500"><%= k.label %></div>
              <div class="flex items-baseline gap-1.5">
                <span id="<%= k.id %>" class="font-mono text-xl font-semibold tabular-nums text-slate-900">–</span>
                <span id="<%= k.id %>Sub" class="truncate text-2xs text-slate-400"></span>
              </div>
            </div>
          </div>
        <% }); %>
      </section>

      <section class="erp-panel overflow-hidden">
        <div class="flex gap-1 border-b border-slate-200 px-3" role="tablist">
          <button type="button" role="tab" class="erp-tab tab-btn active" id="tabBtn-users" onclick="switchUsersTab('users')">
            <i class="bi bi-people" aria-hidden="true"></i> ผู้ใช้งาน
            <span id="userCountSpan" class="rounded bg-slate-100 px-1.5 font-mono text-2xs text-slate-500">0</span>
          </button>
          <button type="button" role="tab" class="erp-tab tab-btn" id="tabBtn-failed" onclick="switchUsersTab('failed')">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> การแจ้งเตือนที่ล้มเหลว
            <span id="failedCountSpan" class="hidden rounded bg-red-100 px-1.5 font-mono text-2xs text-red-600"></span>
          </button>
        </div>

        <!-- TAB 1: USERS -->
        <div id="tab-users" class="tab-content">
          <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 p-3">
            <div class="relative min-w-[220px] flex-1 sm:max-w-sm">
              <i class="bi bi-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
              <input type="search" id="userSearchInput" class="erp-input pl-9" placeholder="ค้นหาชื่อ / ชื่อผู้ใช้…" oninput="applyFilters()" aria-label="ค้นหาผู้ใช้งาน">
            </div>
            <select id="userDeptFilter" class="erp-input w-auto min-w-[200px] max-w-[280px]" onchange="applyFilters()" aria-label="กรองตามกลุ่มงาน">
              <option value="">ทุกกลุ่มงาน</option>
            </select>
            <select id="userRoleFilter" class="erp-input w-auto min-w-[150px]" onchange="applyFilters()" aria-label="กรองตามระดับสิทธิ์">
              <option value="">ทุกระดับสิทธิ์</option>
              <option value="super">Super Admin</option>
              <option value="admin">ผู้ดูแลระบบ</option>
              <option value="user">ผู้ใช้ทั่วไป</option>
            </select>
          </div>

          <div class="max-h-[calc(100vh-360px)] min-h-[320px] overflow-auto">
            <table class="w-full border-collapse text-left text-[13px]">
              <thead class="sticky top-0 z-10 bg-slate-50 text-2xs uppercase tracking-wide text-slate-500">
                <tr class="border-b border-slate-200">
                  <th class="px-4 py-2.5 font-semibold">ผู้ใช้งาน</th>
                  <th class="px-3 py-2.5 font-semibold">กลุ่มงาน</th>
                  <th class="px-3 py-2.5 font-semibold">ระดับสิทธิ์</th>
                  <th class="px-3 py-2.5 font-semibold">LINE</th>
                  <th class="px-3 py-2.5 font-semibold">Telegram</th>
                  <th class="px-4 py-2.5 text-right font-semibold">จัดการ</th>
                </tr>
              </thead>
              <tbody id="userList" class="divide-y divide-slate-100">
                <tr><td colspan="6" class="px-4 py-16 text-center text-slate-400"><i class="bi bi-hourglass-split mr-1"></i> กำลังโหลดข้อมูล…</td></tr>
              </tbody>
            </table>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 bg-slate-50/70 px-4 py-2.5 text-xs text-slate-500">
            <span id="pagerInfo">แสดง 0 รายการ</span>
            <nav aria-label="เปลี่ยนหน้า"><ul id="pagination" class="m-0 flex list-none items-center gap-1 p-0"></ul></nav>
          </div>
        </div>

        <!-- TAB 2: FAILED NOTIFICATIONS -->
        <div id="tab-failed" class="tab-content" style="display:none;">
          <div id="notifStatus" class="grid grid-cols-1 gap-3 border-b border-slate-200 bg-slate-50/60 p-3 md:grid-cols-3 2xl:grid-cols-5" aria-live="polite">
            <div class="text-xs text-slate-400">กำลังตรวจสอบช่องทางแจ้งเตือน…</div>
          </div>
          <div class="flex items-center justify-between border-b border-slate-200 p-3">
            <p class="text-xs text-slate-500">รายการแจ้งเตือนการสแกนที่ส่งไม่สำเร็จ (ไม่มีการส่งซ้ำ — ดูสาเหตุในคอลัมน์ข้อผิดพลาด)</p>
            <button type="button" class="erp-btn erp-btn-secondary h-8" onclick="fetchFailedNotifications()"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> โหลดใหม่</button>
          </div>
          <div class="max-h-[calc(100vh-360px)] min-h-[320px] overflow-auto">
            <table class="w-full border-collapse text-left text-[13px]">
              <thead class="sticky top-0 z-10 bg-slate-50 text-2xs uppercase tracking-wide text-slate-500">
                <tr class="border-b border-slate-200">
                  <th class="px-4 py-2.5 font-semibold">พนักงาน</th>
                  <th class="px-3 py-2.5 font-semibold">วันที่ / เวลาสแกน</th>
                  <th class="px-3 py-2.5 text-center font-semibold">ลองส่ง (ครั้ง)</th>
                  <th class="px-3 py-2.5 font-semibold">ข้อผิดพลาดล่าสุด</th>
                  <th class="px-4 py-2.5 font-semibold">อัปเดตล่าสุด</th>
                </tr>
              </thead>
              <tbody id="failedNotifBody" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- ADD / EDIT DRAWER -->
  <div id="userModal" class="erp fixed inset-0 z-[10000] hidden" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-[2px]" onclick="closeModal()"></div>
    <form id="userForm" accept-charset="UTF-8" autocomplete="off"
      class="absolute inset-y-0 right-0 m-0 flex w-full max-w-[520px] flex-col bg-white shadow-drawer">
      <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
        <div>
          <h3 id="modalTitle" class="text-base font-semibold text-slate-900">เพิ่มผู้ใช้งานใหม่</h3>
          <p class="text-2xs text-slate-500">ข้อมูลบุคลากรดึงจากทะเบียน HR</p>
        </div>
        <button type="button" class="erp-icon-btn" onclick="closeModal()" aria-label="ปิด"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
      </header>

      <div class="flex-1 space-y-4 overflow-y-auto bg-slate-50/60 p-5">
        <input type="hidden" id="userId">

        <section class="erp-panel p-4" id="personPickSection">
          <label class="erp-label" for="personSearch">ค้นหาและเลือกบุคลากร</label>
          <div class="relative">
            <i class="bi bi-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
            <input type="text" id="personSearch" class="erp-input pl-9" placeholder="พิมพ์เลขบัตร 13 หลัก หรือชื่อ-นามสกุล…" oninput="searchPersonnel(this.value)">
            <div id="searchResults" class="absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-60 overflow-y-auto rounded-md border border-slate-200 bg-white shadow-lg"></div>
          </div>
          <p class="mt-1.5 text-2xs text-slate-400">เลือกแล้วระบบจะเติมชื่อและชื่อผู้ใช้ให้อัตโนมัติ</p>
        </section>

        <section class="erp-panel">
          <h4 class="border-b border-slate-100 px-4 py-2.5 text-2xs font-semibold uppercase tracking-wide text-slate-500">ข้อมูลบัญชี</h4>
          <div class="space-y-3 p-4">
            <div>
              <label class="erp-label" for="fullname">ชื่อ-นามสกุล <span class="text-red-500">*</span></label>
              <input type="text" id="fullname" class="erp-input" placeholder="ระบบจะเติมให้อัตโนมัติเมื่อเลือกคน" required>
            </div>
            <div>
              <label class="erp-label" for="username">ชื่อผู้ใช้ (เลขบัตรประชาชน) <span class="text-red-500">*</span></label>
              <input type="text" id="username" class="erp-input font-mono" placeholder="ระบบจะใช้เลข CID อัตโนมัติ" required>
            </div>
            <div>
              <label class="erp-label" for="password" id="passLabel">รหัสผ่าน</label>
              <input type="password" id="password" class="erp-input" placeholder="อย่างน้อย 8 ตัวอักษร" minlength="8" autocomplete="new-password">
              <p id="passHint" class="mt-1 text-2xs text-slate-400" style="display:none;">เว้นว่างไว้หากไม่ต้องการเปลี่ยนรหัสผ่าน</p>
            </div>
          </div>
        </section>

        <section class="erp-panel">
          <h4 class="border-b border-slate-100 px-4 py-2.5 text-2xs font-semibold uppercase tracking-wide text-slate-500">ระดับสิทธิ์</h4>
          <div class="grid gap-2 p-4" id="roleOptions">
            <% const roles = [
              { value: 'super', label: 'Super Admin', desc: 'จัดการผู้ใช้ สิทธิ์ และการตั้งค่าระบบทั้งหมด', icon: 'bi-shield-lock', tone: 'text-red-600' },
              { value: 'admin', label: 'ผู้ดูแลระบบ', desc: 'ดูรายงาน ทะเบียนบุคลากร และจัดตารางเวร', icon: 'bi-person-gear', tone: 'text-amber-600' },
              { value: 'user', label: 'ผู้ใช้ทั่วไป', desc: 'ดูตารางเวรและแจ้งสาเหตุการลงเวลาของตนเอง', icon: 'bi-person', tone: 'text-slate-500' }
            ]; %>
            <% roles.forEach(r => { %>
              <label class="flex cursor-pointer items-start gap-3 rounded-md border border-slate-200 bg-white p-3 transition-colors hover:border-slate-300 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50/60">
                <input type="radio" name="role" value="<%= r.value %>" class="mt-1 accent-brand-600" <%= r.value === 'user' ? 'checked' : '' %>>
                <i class="bi <%= r.icon %> mt-0.5 <%= r.tone %>" aria-hidden="true"></i>
                <span>
                  <span class="block text-[13px] font-medium text-slate-800"><%= r.label %></span>
                  <span class="block text-2xs text-slate-500"><%= r.desc %></span>
                </span>
              </label>
            <% }); %>
          </div>
        </section>

        <section class="erp-panel">
          <h4 class="border-b border-slate-100 px-4 py-2.5 text-2xs font-semibold uppercase tracking-wide text-slate-500">ช่องทางแจ้งเตือน</h4>
          <div class="space-y-3 p-4">
            <div>
              <div class="mb-1.5 flex items-center justify-between">
                <label class="erp-label mb-0" for="line_user_id"><i class="bi bi-line text-[#06C755]" aria-hidden="true"></i> LINE User ID</label>
                <button type="button" class="text-2xs text-brand-600 hover:underline" onclick="showHowToGetLineId()">วิธีหา ID?</button>
              </div>
              <input type="text" id="line_user_id" class="erp-input font-mono" placeholder="ขึ้นต้นด้วย U…">
            </div>
            <div>
              <div class="mb-1.5 flex items-center justify-between">
                <label class="erp-label mb-0" for="telegram_chat_id"><i class="bi bi-telegram text-sky-500" aria-hidden="true"></i> Telegram Chat ID</label>
                <button type="button" class="text-2xs text-brand-600 hover:underline" onclick="showHowToGetTelegramId()">วิธีหา ID?</button>
              </div>
              <input type="text" id="telegram_chat_id" class="erp-input font-mono" placeholder="ตัวเลข Chat ID (ช่องทางสำรอง)">
            </div>
          </div>
        </section>
      </div>

      <footer class="flex justify-end gap-2 border-t border-slate-200 px-5 py-3">
        <button type="button" class="erp-btn erp-btn-secondary" onclick="closeModal()">ยกเลิก</button>
        <button type="submit" class="erp-btn erp-btn-primary" id="saveUserBtn"><i class="bi bi-check2" aria-hidden="true"></i> บันทึกข้อมูล</button>
      </footer>
    </form>
  </div>

  <!-- TEMPORARY PASSWORD DIALOG -->
  <div id="tempPassModal" class="erp fixed inset-0 z-[10001] hidden items-center justify-center bg-slate-900/50 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="tempPassTitle">
    <div class="w-full max-w-sm rounded-lg bg-white p-5 shadow-2xl ring-1 ring-slate-200">
      <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-md bg-amber-50 text-amber-600"><i class="bi bi-key" aria-hidden="true"></i></div>
      <h3 id="tempPassTitle" class="text-base font-semibold text-slate-900">รหัสผ่านชั่วคราว</h3>
      <p id="tempPassFor" class="mt-1 text-xs text-slate-500"></p>
      <div class="mt-4 flex items-center gap-2 rounded-md border border-slate-200 bg-slate-50 p-2 pl-3">
        <code id="tempPassValue" class="flex-1 select-all break-all font-mono text-sm font-semibold text-slate-900"></code>
        <button type="button" class="erp-btn erp-btn-secondary h-8 px-2.5" onclick="copyTempPass()"><i class="bi bi-clipboard" aria-hidden="true"></i> คัดลอก</button>
      </div>
      <p class="mt-3 text-2xs text-amber-700"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> แสดงเพียงครั้งเดียว โปรดส่งให้ผู้ใช้ผ่านช่องทางที่ปลอดภัย</p>
      <div class="mt-4 flex justify-end">
        <button type="button" class="erp-btn erp-btn-primary" onclick="closeTempPass()">เสร็จสิ้น</button>
      </div>
    </div>
  </div>

  <script>
    const PER_PAGE = 25;
    const ROLE_META = {
      super: ['Super Admin', 'red'],
      admin: ['ผู้ดูแลระบบ', 'amber'],
      manager: ['ผู้ดูแลระบบ', 'amber'],
      staff: ['ผู้ดูแลระบบ', 'amber'],
      user: ['ผู้ใช้ทั่วไป', 'slate']
    };
    const $ = id => document.getElementById(id);
    const esc = ERP.escapeHtml;
    const normRole = r => (r === 'manager' || r === 'staff' ? 'admin' : (ROLE_META[r] ? r : 'user'));
    // Username is the national ID — show only the edges in lists
    const maskCid = v => {
      const s = String(v || '');
      return s.length >= 10 ? `${s.slice(0, 1)}-xxxx-xxxx${s.slice(-4)}` : s;
    };

    let allUsers = [];
    let allPersonnel = [];
    let filteredUsers = [];
    let currentPage = 1;
    let failedNotifLoaded = false;

    function switchUsersTab(tabId) {
      ['users', 'failed'].forEach(t => {
        $('tabBtn-' + t).classList.toggle('active', t === tabId);
        $('tabBtn-' + t).setAttribute('aria-selected', String(t === tabId));
        $('tab-' + t).style.display = t === tabId ? '' : 'none';
      });
      if (tabId === 'failed' && !failedNotifLoaded) fetchFailedNotifications();
    }

    async function fetchNotifStatus() {
      const box = $('notifStatus');
      try {
        const res = await fetch('/api/notifications/status', { headers: { Accept: 'application/json' } });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || `HTTP ${res.status}`);
        const { line, telegram, today, realtime, adminTargets, scanner, backup } = data.status;
        const pill = (ok, label) => `<span class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-2xs font-semibold ring-1 ring-inset ${ok ? 'bg-emerald-50 text-emerald-700 ring-emerald-200' : 'bg-red-50 text-red-700 ring-red-200'}"><i class="bi ${ok ? 'bi-check-circle' : 'bi-x-circle'}" aria-hidden="true"></i>${label}</span>`;
        const card = (title, icon, body) => `<div class="rounded-lg bg-white p-3 ring-1 ring-slate-200"><div class="mb-1.5 flex items-center gap-2 text-[13px] font-semibold text-slate-800"><i class="bi ${icon}" aria-hidden="true"></i>${title}</div>${body}</div>`;

        let lineBody;
        if (!line.configured) lineBody = pill(false, 'ยังไม่ได้ตั้งค่า') + '<p class="mt-1 text-2xs text-slate-500">ใส่ LINE_CHANNEL_ACCESS_TOKEN ใน .env</p>';
        else if (!line.ok) lineBody = pill(false, 'เชื่อมต่อไม่ได้') + `<p class="mt-1 text-2xs text-red-600">${esc(line.error)}</p>`;
        else {
          const limited = line.quota != null;
          const pct = limited ? Math.min(100, Math.round(line.used / Math.max(line.quota, 1) * 100)) : 0;
          const bar = pct >= 90 ? 'bg-red-500' : pct >= 70 ? 'bg-amber-500' : 'bg-emerald-500';
          lineBody = `${pill(true, esc(line.name || 'OA'))} <span class="text-2xs text-slate-400">${esc(line.basicId || '')}</span>
            <div class="mt-2 text-2xs text-slate-600">ส่งทาง LINE: ${data.status.linePolicy === 'all' ? 'ทุกการแจ้งเตือน' : 'เฉพาะเรื่องสำคัญ (อนุมัติ/เตือนค้างส่ง/แจ้งแอดมิน) · การ์ดสแกนไป Telegram'}</div>
            <div class="mt-1 text-2xs text-slate-600">ข้อความ push เดือนนี้: <b class="font-mono">${line.used.toLocaleString()}</b>${limited ? ` / <span class="font-mono">${line.quota.toLocaleString()}</span>` : ' (ไม่จำกัด)'}</div>
            ${limited ? `<div class="mt-1 h-1.5 overflow-hidden rounded bg-slate-100" role="progressbar" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100"><div class="h-full ${bar}" style="width:${pct}%"></div></div>
            ${pct >= 90 ? '<p class="mt-1 text-2xs font-medium text-red-600">โควตาใกล้หมด — ข้อความ push จะส่งไม่ได้จนถึงต้นเดือน</p>' : ''}` : ''}`;
        }
        let tgBody;
        if (!telegram.configured) tgBody = pill(false, 'ยังไม่ได้ตั้งค่า') + '<p class="mt-1 text-2xs text-slate-500">ใส่ TELEGRAM_BOT_TOKEN ใน .env</p>';
        else if (!telegram.ok) tgBody = pill(false, 'เชื่อมต่อไม่ได้') + `<p class="mt-1 text-2xs text-red-600">${esc(telegram.error)}</p>`;
        else tgBody = `${pill(true, '@' + esc(telegram.username || ''))}<div class="mt-2 text-2xs text-slate-600">รับคำสั่งแชต: ${telegram.polling ? 'เปิด' : 'ปิด (ส่งอย่างเดียว)'}</div>`;

        const todayBody = `<div class="flex gap-4 text-2xs text-slate-600"><div>ส่งสำเร็จ <b class="block font-mono text-base text-slate-900">${today.sent}</b></div><div>ล้มเหลว <b class="block font-mono text-base ${today.failed ? 'text-red-600' : 'text-slate-900'}">${today.failed}</b></div><div title="ไม่มีช่องทางที่ส่งได้ตามนโยบาย เช่น ผูกแค่ LINE">ไม่ได้ส่ง <b class="block font-mono text-base text-slate-500">${today.skipped || 0}</b></div></div>
          <div class="mt-1 text-2xs text-slate-500">แจ้งเตือนทันทีเมื่อสแกน: ${realtime.enabled ? 'เปิด' : 'ปิด'} · สำเนาถึงแอดมิน: ${realtime.copyAdmin && adminTargets.telegram ? 'เปิด' : 'ปิด'}</div>`;
        let scanBody;
        if (!scanner || scanner.error) scanBody = pill(false, 'ตรวจไม่ได้') + `<p class="mt-1 text-2xs text-red-600">${esc((scanner && scanner.error) || '')}</p>`;
        else {
          const quiet = scanner.overallSilent || (scanner.silentDevices || []).length;
          scanBody = `${pill(!quiet, scanner.overallSilent ? 'ไม่มีข้อมูลเข้า' : quiet ? 'บางเครื่องเงียบ' : 'ปกติ')}
            <div class="mt-2 text-2xs text-slate-600">สแกนล่าสุด: <b class="font-mono">${esc(scanner.lastScan ? scanner.lastScan.slice(5, 16) : '—')}</b>${scanner.minutesSince != null ? ` (${scanner.minutesSince} นาที)` : ''}</div>
            ${(scanner.silentDevices || []).length ? `<div class="mt-1 text-2xs text-amber-700">เงียบ: ${scanner.silentDevices.map(esc).join(', ')}</div>` : ''}
            <div class="mt-1 text-2xs text-slate-400">เฝ้าดู ${esc(scanner.window)} วันทำการ · เตือนเมื่อเงียบ ${scanner.silenceMin} นาที</div>`;
        }
        const bkAgeH = backup ? (Date.now() - new Date(backup.at).getTime()) / 3600000 : null;
        const bkBody = backup
          ? `${pill(bkAgeH < 30, bkAgeH < 30 ? 'ล่าสุด ' + Math.round(bkAgeH) + ' ชม.ก่อน' : 'เก่าเกิน 1 วัน')}
             <div class="mt-2 truncate font-mono text-2xs text-slate-600" title="${esc(backup.name)}">${esc(backup.name)}</div>
             <div class="mt-1 text-2xs text-slate-500">${(backup.bytes / 1024 / 1024).toFixed(2)} MB · เก็บไว้ ${backup.count} ไฟล์ · ทุกคืน 03:00</div>`
          : pill(false, 'ยังไม่มีไฟล์สำรอง') + '<p class="mt-1 text-2xs text-slate-500">ระบบจะสำรองทุกคืน 03:00 หรือรัน npm run backup บน server</p>';
        box.innerHTML = card('LINE OA', 'bi-line', lineBody) + card('Telegram', 'bi-telegram', tgBody) + card('การสแกนวันนี้', 'bi-bell', todayBody)
          + card('เครื่องสแกน Hikvision', 'bi-fingerprint', scanBody) + card('สำรองฐานข้อมูล', 'bi-database-check', bkBody);
      } catch (err) {
        box.innerHTML = `<div class="text-xs text-red-600 md:col-span-3">ตรวจสอบสถานะไม่สำเร็จ: ${esc(err.message)}</div>`;
      }
    }

    async function fetchFailedNotifications() {
      fetchNotifStatus();
      const tbody = $('failedNotifBody');
      tbody.innerHTML = '<tr><td colspan="5" class="px-4 py-12 text-center text-slate-400">กำลังโหลด…</td></tr>';
      try {
        const res = await fetch('/api/notifications/failed', { headers: { Accept: 'application/json' } });
        const data = await res.json();
        const failures = (data && data.failures) || [];
        failedNotifLoaded = true;
        const badge = $('failedCountSpan');
        badge.textContent = failures.length;
        badge.classList.toggle('hidden', failures.length === 0);
        if (!failures.length) {
          tbody.innerHTML = ERP.emptyRow(5, 'ไม่มีการแจ้งเตือนที่ล้มเหลว', 'bi-check2-circle');
          return;
        }
        tbody.innerHTML = failures.map(f => `
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-2.5 font-medium text-slate-900">${esc(f.employeeName)}</td>
            <td class="px-3 py-2.5 font-mono text-xs text-slate-600">${esc(f.accessDate)} ${esc(f.accessTime)}</td>
            <td class="px-3 py-2.5 text-center font-mono text-xs">${esc(f.attempts)}</td>
            <td class="max-w-[320px] px-3 py-2.5"><div class="truncate text-xs text-red-600" title="${esc(f.lastError || '')}">${esc(f.lastError || '—')}</div></td>
            <td class="whitespace-nowrap px-4 py-2.5 text-xs text-slate-500">${f.updatedAt ? new Date(f.updatedAt).toLocaleString('th-TH') : '—'}</td>
          </tr>`).join('');
      } catch (err) {
        console.error('Fetch failed notifications error:', err);
        tbody.innerHTML = ERP.emptyRow(5, 'โหลดข้อมูลไม่สำเร็จ', 'bi-exclamation-triangle');
      }
    }

    async function fetchUsers() {
      try {
        const res = await fetch('/api/users', { headers: { Accept: 'application/json' } });
        const data = await res.json();
        allUsers = data.users || [];
        renderKpis();
        ERP.fillSelect($('userDeptFilter'), ERP.uniqueSorted(allUsers, 'dept'));
        applyFilters();
      } catch (err) {
        console.error('Fetch error:', err);
        $('userList').innerHTML = ERP.emptyRow(6, 'โหลดข้อมูลผู้ใช้ไม่สำเร็จ', 'bi-exclamation-triangle');
      }
    }

    async function fetchPersonnel() {
      try {
        const res = await fetch('/api/personnel', { headers: { Accept: 'application/json' } });
        const data = await res.json();
        allPersonnel = data.personnel || [];
      } catch (err) { console.error('Personnel Fetch error:', err); }
    }
    // Topbar refresh hook
    const loadData = () => { fetchUsers(); if (failedNotifLoaded) fetchFailedNotifications(); };

    function renderKpis() {
      const count = r => allUsers.filter(u => normRole(u.role) === r).length;
      const linked = allUsers.filter(u => u.line_user_id || u.telegram_chat_id).length;
      $('kpiUsers').textContent = allUsers.length.toLocaleString('th-TH');
      $('kpiUsersSub').textContent = 'บัญชี';
      $('kpiSuper').textContent = count('super');
      $('kpiAdmin').textContent = count('admin');
      $('kpiLinked').textContent = linked.toLocaleString('th-TH');
      $('kpiLinkedSub').textContent = allUsers.length ? Math.round((linked / allUsers.length) * 100) + '%' : '';
    }

    function applyFilters() {
      const query = $('userSearchInput').value.toLowerCase().trim();
      const dept = $('userDeptFilter').value;
      const role = $('userRoleFilter').value;
      filteredUsers = allUsers.filter(u => {
        if (dept && u.dept !== dept) return false;
        if (role && normRole(u.role) !== role) return false;
        return !query || (u.fullname || '').toLowerCase().includes(query) || (u.username || '').toLowerCase().includes(query);
      });
      $('userCountSpan').textContent = filteredUsers.length;
      currentPage = 1;
      renderUsers();
    }

    function actionBtn(action, id, icon, label, extra = '') {
      return `<button type="button" data-action="${action}" data-id="${esc(id)}" title="${label}" aria-label="${label}"
        class="erp-icon-btn h-8 w-8 ${extra}"><i class="bi ${icon}"></i></button>`;
    }

    // Keeps action icons in fixed columns when a row has no LINE/Telegram test button
    const ACTION_SPACER = '<span class="inline-block h-8 w-8 align-middle" aria-hidden="true"></span>';

    function channelCell(value, icon, color) {
      return value
        ? `<span class="inline-flex items-center gap-1.5 text-xs text-slate-700"><i class="bi ${icon} ${color}"></i><span class="font-mono">${esc(String(value).slice(0, 10))}${String(value).length > 10 ? '…' : ''}</span></span>`
        : '<span class="text-xs italic text-slate-300">ยังไม่เชื่อม</span>';
    }

    function renderUsers() {
      const tbody = $('userList');
      currentPage = ERP.pager($('pagination'), {
        page: currentPage, total: filteredUsers.length, perPage: PER_PAGE,
        onChange: p => { currentPage = p; renderUsers(); }
      });
      const start = (currentPage - 1) * PER_PAGE;
      const pageData = filteredUsers.slice(start, start + PER_PAGE);
      $('pagerInfo').textContent = ERP.pagerText(start, pageData.length, filteredUsers.length);

      if (!pageData.length) {
        tbody.innerHTML = ERP.emptyRow(6, 'ไม่พบผู้ใช้งานตามเงื่อนไขที่เลือก');
        return;
      }

      tbody.innerHTML = pageData.map(u => {
        const [roleLabel, tone] = ROLE_META[u.role] || ROLE_META.user;
        return `<tr class="transition-colors hover:bg-slate-50">
          <td class="px-4 py-2.5">
            <div class="flex items-center gap-2.5">
              ${ERP.avatar(u.fullname, u.username)}
              <div class="min-w-0">
                <div class="truncate font-medium text-slate-900">${esc(u.fullname || '—')}</div>
                <div class="font-mono text-2xs text-slate-400">${esc(maskCid(u.username))}</div>
              </div>
            </div>
          </td>
          <td class="max-w-[240px] px-3 py-2.5"><div class="truncate text-slate-600" title="${esc(u.dept || '')}">${esc(u.dept || '—')}</div></td>
          <td class="px-3 py-2.5">${ERP.badge(roleLabel, tone)}</td>
          <td class="px-3 py-2.5">${channelCell(u.line_user_id, 'bi-line', 'text-[#06C755]')}</td>
          <td class="px-3 py-2.5">${channelCell(u.telegram_chat_id, 'bi-telegram', 'text-sky-500')}</td>
          <td class="whitespace-nowrap px-4 py-1.5 text-right">
            ${actionBtn('edit', u.id, 'bi-pencil-square', 'แก้ไข')}
            ${actionBtn('reset', u.id, 'bi-key', 'รีเซ็ตรหัสผ่าน', 'hover:text-amber-600')}
            ${u.line_user_id ? actionBtn('test-line', u.id, 'bi-line', 'ทดสอบส่ง LINE', 'hover:text-[#06C755]') : ACTION_SPACER}
            ${u.telegram_chat_id ? actionBtn('test-telegram', u.id, 'bi-telegram', 'ทดสอบส่ง Telegram', 'hover:text-sky-500') : ACTION_SPACER}
            ${actionBtn('delete', u.id, 'bi-trash3', 'ลบผู้ใช้', 'hover:bg-red-50 hover:text-red-600')}
          </td>
        </tr>`;
      }).join('');
    }

    /* ---------- Personnel picker ---------- */
    let personMatches = [];
    function searchPersonnel(query) {
      const resultsBox = $('searchResults');
      if (!query || query.trim().length < 2) {
        resultsBox.classList.add('hidden');
        return;
      }
      const term = query.trim().toLowerCase();
      personMatches = allPersonnel.filter(p => {
        const fullName = `${p.HR_FNAME || ''} ${p.HR_LNAME || ''}`.toLowerCase();
        return fullName.includes(term) || (p.HR_CID || '').toLowerCase().includes(term);
      }).slice(0, 10);

      resultsBox.innerHTML = personMatches.length
        ? personMatches.map((p, i) => `
          <button type="button" data-pick="${i}" class="flex w-full items-center gap-2.5 border-b border-slate-100 px-3 py-2 text-left last:border-0 hover:bg-brand-50/60">
            ${ERP.avatar(p.HR_FNAME, p.FINGLE_ID || p.ID, 'h-7 w-7 text-2xs')}
            <span class="min-w-0">
              <span class="block truncate text-[13px] font-medium text-slate-800">${esc(`${p.HR_FNAME || ''} ${p.HR_LNAME || ''}`)}</span>
              <span class="block truncate text-2xs text-slate-500">CID ${esc(maskCid(p.HR_CID) || '—')} · ${esc(p.HR_DEPARTMENT_NAME || '—')}</span>
            </span>
          </button>`).join('')
        : '<div class="px-3 py-4 text-center text-xs text-slate-400">ไม่พบบุคลากร</div>';
      resultsBox.classList.remove('hidden');
    }

    function selectPersonnel(p) {
      const name = `${p.HR_FNAME || ''} ${p.HR_LNAME || ''}`.trim();
      $('fullname').value = name;
      $('username').value = p.HR_CID || '';
      $('personSearch').value = name;
      $('line_user_id').value = $('line_user_id').value || p.line_user_id || '';
      $('telegram_chat_id').value = $('telegram_chat_id').value || p.telegram_chat_id || '';
      $('searchResults').classList.add('hidden');
    }

    /* ---------- Drawer ---------- */
    function setRole(value) {
      const radio = document.querySelector(`input[name="role"][value="${normRole(value)}"]`);
      if (radio) radio.checked = true;
    }

    function openModal() {
      $('userForm').reset();
      $('userId').value = '';
      $('modalTitle').textContent = 'เพิ่มผู้ใช้งานใหม่';
      $('passLabel').textContent = 'รหัสผ่าน';
      $('passHint').style.display = 'none';
      $('password').required = true;
      $('personPickSection').style.display = '';
      $('searchResults').classList.add('hidden');
      setRole('user');
      ERP.showOverlay($('userModal'), true);
      setTimeout(() => $('personSearch').focus(), 0);
    }

    function closeModal() {
      ERP.showOverlay($('userModal'), false);
    }

    function editUser(id) {
      const user = allUsers.find(u => String(u.id) === String(id));
      if (!user) return;
      openModal();
      $('modalTitle').textContent = 'แก้ไขผู้ใช้งาน';
      $('personPickSection').style.display = 'none';
      $('userId').value = user.id;
      $('fullname').value = user.fullname || '';
      $('username').value = user.username || '';
      $('line_user_id').value = user.line_user_id || '';
      $('telegram_chat_id').value = user.telegram_chat_id || '';
      setRole(user.role);
      $('passLabel').textContent = 'เปลี่ยนรหัสผ่าน';
      $('passHint').style.display = '';
      $('password').required = false;
    }

    async function deleteUser(id) {
      const user = allUsers.find(u => String(u.id) === String(id));
      if (!confirm(`ยืนยันการลบผู้ใช้งาน ${user ? user.fullname : ''} หรือไม่?`)) return;
      try {
        const res = await fetch(`/api/users/${encodeURIComponent(id)}`, { method: 'DELETE', headers: { Accept: 'application/json' } });
        const result = await res.json();
        if (result.success) { ERP.toast('ลบผู้ใช้งานแล้ว', 'success'); fetchUsers(); }
        else ERP.toast(result.error || 'ลบไม่สำเร็จ', 'error');
      } catch (err) { ERP.toast('เกิดข้อผิดพลาดในการลบ', 'error'); }
    }

    $('userForm').addEventListener('submit', async e => {
      e.preventDefault();
      const id = $('userId').value;
      const data = {
        id: id || undefined,
        fullname: $('fullname').value.trim(),
        username: $('username').value.trim(),
        password: $('password').value || undefined,
        line_user_id: $('line_user_id').value.trim() || null,
        telegram_chat_id: $('telegram_chat_id').value.trim() || null,
        role: (document.querySelector('input[name="role"]:checked') || {}).value || 'user'
      };
      const btn = $('saveUserBtn');
      btn.disabled = true;
      try {
        const res = await fetch('/api/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
          closeModal();
          ERP.toast(id ? 'บันทึกการแก้ไขแล้ว' : 'เพิ่มผู้ใช้งานแล้ว', 'success');
          fetchUsers();
        } else {
          ERP.toast(result.error || 'เกิดข้อผิดพลาด', 'error');
        }
      } catch (err) {
        ERP.toast('เกิดข้อผิดพลาดในการบันทึก', 'error');
      } finally {
        btn.disabled = false;
      }
    });

    function showHowToGetLineId() {
      alert(
        "💬 วิธีหา LINE User ID:\n\n" +
        "1. แอดไลน์บอทของระบบเป็นเพื่อน\n" +
        "2. พิมพ์ข้อความอะไรก็ได้ส่งให้บอท (เช่น 'ขอไอดี' หรือ 'hello')\n" +
        "3. บอทจะตอบกลับเป็น LINE User ID ของคุณทันที (ขึ้นต้นด้วยตัว U ยาวๆ)\n" +
        "4. คัดลอก ID นั้นมาใส่ในช่องนี้เพื่อบันทึกและเชื่อมต่อระบบ"
      );
    }

    function showHowToGetTelegramId() {
      alert(
        "💬 วิธีหา Telegram Chat ID:\n\n" +
        "1. แอดบอทของระบบหรือแอดบอท @userinfobot ใน Telegram\n" +
        "2. พิมพ์ข้อความหรือส่งคำสั่ง /start ไปยังบอท\n" +
        "3. บอทจะตอบกลับข้อมูลพร้อมระบุ ID ของคุณ (ตัวเลขยาวๆ เช่น 123456789)\n" +
        "4. คัดลอกตัวเลข ID นั้นมาใส่ในช่องนี้เพื่อบันทึกและเชื่อมต่อระบบ"
      );
    }

    async function postTest(url, userId, channel) {
      ERP.toast(`กำลังส่งข้อความทดสอบ ${channel}…`);
      try {
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ userId })
        });
        const result = await res.json();
        if (result.success) ERP.toast(result.message || `ส่ง ${channel} สำเร็จ`, 'success');
        else ERP.toast(`ส่ง ${channel} ล้มเหลว: ${result.error || 'ไม่ทราบสาเหตุ'}`, 'error');
      } catch (err) {
        ERP.toast('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์', 'error');
      }
    }
    const testLine = userId => postTest('/api/users/test-line', userId, 'LINE');
    const testTelegram = userId => postTest('/api/users/test-telegram', userId, 'Telegram');

    async function resetUserPassword(userId) {
      const user = allUsers.find(u => String(u.id) === String(userId));
      const fullname = user ? user.fullname : '';
      if (!confirm(`ต้องการสร้างรหัสผ่านชั่วคราวแบบสุ่มสำหรับ ${fullname} หรือไม่?`)) return;
      try {
        const res = await fetch(`/api/users/${encodeURIComponent(userId)}/reset-password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' }
        });
        const result = await res.json();
        if (!result.success) return ERP.toast('รีเซ็ตไม่สำเร็จ: ' + (result.error || 'ไม่ทราบสาเหตุ'), 'error');
        $('tempPassFor').textContent = `${result.message || 'รีเซ็ตรหัสผ่านแล้ว'} — ${fullname}`;
        $('tempPassValue').textContent = result.temporaryPassword || '';
        $('tempPassModal').classList.remove('hidden');
        $('tempPassModal').classList.add('flex');
      } catch (err) {
        ERP.toast('เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์', 'error');
      }
    }

    async function copyTempPass() {
      try {
        await navigator.clipboard.writeText($('tempPassValue').textContent);
        ERP.toast('คัดลอกรหัสผ่านแล้ว', 'success');
      } catch {
        ERP.toast('คัดลอกไม่สำเร็จ กรุณาเลือกข้อความแล้วคัดลอกเอง', 'error');
      }
    }

    function closeTempPass() {
      $('tempPassValue').textContent = '';
      $('tempPassModal').classList.add('hidden');
      $('tempPassModal').classList.remove('flex');
    }

    const ACTIONS = {
      edit: editUser,
      reset: resetUserPassword,
      'test-line': testLine,
      'test-telegram': testTelegram,
      delete: deleteUser
    };

    $('userList').addEventListener('click', e => {
      const btn = e.target.closest('button[data-action]');
      if (btn && ACTIONS[btn.dataset.action]) ACTIONS[btn.dataset.action](btn.dataset.id);
    });

    $('searchResults').addEventListener('click', e => {
      const item = e.target.closest('[data-pick]');
      if (item) selectPersonnel(personMatches[Number(item.dataset.pick)]);
    });

    document.addEventListener('click', e => {
      if (!e.target.closest('#personPickSection')) $('searchResults').classList.add('hidden');
    });

    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      if (!$('tempPassModal').classList.contains('hidden')) closeTempPass();
      else if (!$('userModal').classList.contains('hidden')) closeModal();
    });

    fetchUsers();
    fetchPersonnel();
  </script>
</body>

</html>
