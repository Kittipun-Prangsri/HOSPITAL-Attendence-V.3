<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>เข้าสู่ระบบ · KHH HRM</title>
  <%- include('components/favicon') %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="<%= asset('/css/erp.css') %>">
</head>

<body class="erp-page">
  <div class="erp grid min-h-screen lg:grid-cols-[1.1fr_1fr]">
    <!-- Brand panel -->
    <aside class="relative hidden overflow-hidden bg-plum-950 bg-gradient-to-br from-plum-800 via-plum-950 to-plum-950 p-12 text-white lg:flex lg:flex-col">
      <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-brand-500/25 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-20 h-[28rem] w-[28rem] rounded-full bg-plum-500/20 blur-3xl" aria-hidden="true"></div>

      <div class="relative flex items-center gap-3">
        <img src="/images/LOGO%20KHH.jpg" alt="" class="h-11 w-11 rounded-md bg-white object-cover ring-1 ring-white/20">
        <div class="leading-tight">
          <div class="text-sm font-semibold">KHH · HRM</div>
          <div class="text-xs text-plum-300/80">โรงพยาบาลคลองหาด</div>
        </div>
      </div>

      <div class="relative mt-auto max-w-md">
        <h1 class="text-3xl font-semibold leading-snug">ระบบบริหารงานบุคคล<br>และเวลาปฏิบัติงาน</h1>
        <p class="mt-3 text-sm text-plum-300/80">บันทึกเวลาเข้า–ออก จัดตารางเวร แจ้งสาเหตุการลงเวลา และรายงานสำหรับผู้บริหาร ในที่เดียว</p>
        <ul class="m-0 mt-8 grid list-none grid-cols-2 gap-3 p-0 text-[13px]">
          <% [['bi-fingerprint','เชื่อมเครื่องสแกนใบหน้า'],['bi-calendar2-week','จัดตารางเวรรายเดือน'],['bi-line','แจ้งเตือนผ่าน LINE'],['bi-graph-up-arrow','รายงานเชิงวิเคราะห์']].forEach(([icon, label]) => { %>
            <li class="flex items-center gap-2.5 rounded-md bg-white/5 px-3 py-2.5 ring-1 ring-white/10">
              <i class="bi <%= icon %> text-brand-300" aria-hidden="true"></i><span class="text-white/90"><%= label %></span>
            </li>
          <% }); %>
        </ul>
      </div>

      <div class="relative mt-12 text-2xs text-plum-300/50">© <%= new Date().getFullYear() %> โรงพยาบาลคลองหาด - Kittipun Prangsri</div>
    </aside>

    <!-- Form -->
    <main class="flex items-center justify-center px-4 py-10 sm:px-8">
      <div class="w-full max-w-sm">
        <div class="mb-8 flex items-center gap-3 lg:hidden">
          <img src="/images/LOGO%20KHH.jpg" alt="" class="h-11 w-11 rounded-md object-cover ring-1 ring-slate-200">
          <div class="leading-tight">
            <div class="text-sm font-semibold text-slate-900">KHH · HRM</div>
            <div class="text-xs text-slate-500">โรงพยาบาลคลองหาด</div>
          </div>
        </div>

        <h2 class="text-2xl font-semibold text-slate-900">เข้าสู่ระบบ</h2>
        <p class="mt-1 text-[13px] text-slate-500">ลงชื่อเข้าใช้งานสำหรับเจ้าหน้าที่โรงพยาบาล</p>

        <% if (locals.error) { %>
          <div class="mt-5 flex items-start gap-2 rounded-md bg-red-50 px-3 py-2.5 text-[13px] text-red-700 ring-1 ring-inset ring-red-200" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-0.5" aria-hidden="true"></i><span><%= error %></span>
          </div>
        <% } %>

        <form action="/login" method="POST" class="m-0 mt-6 space-y-4" id="loginForm">
          <div>
            <label class="erp-label" for="usernameInput">ชื่อผู้ใช้งาน (ID)</label>
            <div class="relative">
              <i class="bi bi-person pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
              <input type="text" id="usernameInput" name="username" class="erp-input h-11 pl-9" placeholder="กรอกชื่อผู้ใช้งาน" autocomplete="username" required autofocus>
            </div>
          </div>
          <div>
            <div class="mb-1.5 flex items-center justify-between">
              <label class="erp-label mb-0" for="passwordInput">รหัสผ่าน</label>
              <a href="#" onclick="forgotPasswordAlert(event)" class="text-xs font-medium text-brand-700 hover:underline">ลืมรหัสผ่าน?</a>
            </div>
            <div class="relative">
              <i class="bi bi-lock pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" aria-hidden="true"></i>
              <input type="password" id="passwordInput" name="password" class="erp-input h-11 pl-9 pr-10" placeholder="กรอกรหัสผ่าน" autocomplete="current-password" required>
              <button type="button" id="togglePasswordBtn" class="erp-icon-btn absolute right-1 top-1/2 h-9 w-9 -translate-y-1/2" aria-label="แสดงรหัสผ่าน" aria-pressed="false">
                <i class="bi bi-eye" id="togglePasswordIcon" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <button type="submit" id="loginBtn" class="erp-btn erp-btn-primary h-11 w-full text-sm">เข้าสู่ระบบ <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
        </form>

        <p class="mt-8 text-center text-2xs text-slate-400 lg:hidden">© <%= new Date().getFullYear() %> โรงพยาบาลคลองหาด - Kittipun Prangsri</p>
      </div>
    </main>
  </div>

  <script>
    document.getElementById('togglePasswordBtn').addEventListener('click', function () {
      const input = document.getElementById('passwordInput');
      const icon = document.getElementById('togglePasswordIcon');
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      icon.classList.toggle('bi-eye', !show);
      icon.classList.toggle('bi-eye-slash', show);
      this.setAttribute('aria-pressed', String(show));
      this.setAttribute('aria-label', show ? 'ซ่อนรหัสผ่าน' : 'แสดงรหัสผ่าน');
    });

    document.getElementById('loginForm').addEventListener('submit', () => {
      const btn = document.getElementById('loginBtn');
      btn.disabled = true;
      btn.innerHTML = '<span class="h-4 w-4 animate-spin rounded-full border-2 border-white/40 border-t-white"></span> กำลังเข้าสู่ระบบ…';
    });

    function forgotPasswordAlert(e) {
      e.preventDefault();
      alert('🔒 ระบบความปลอดภัย:\n\nกรุณาติดต่อผู้ดูแลระบบระดับสูง (Super Admin) เพื่อสร้างรหัสผ่านชั่วคราวใหม่ให้คุณ');
    }
  </script>
</body>

</html>
