# Server Configuration
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Bangkok
DB_TIMEZONE=+07:00
# Optional comma-separated browser origins allowed to call the API cross-site.
# Leave empty when the web app and API are served from the same domain.
CORS_ORIGIN=

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME_HOSPITAL=hospital_db
DB_NAME_HOSOFFICE=hosoffice

# Notification Service (Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# Notification Service (LINE)
LINE_CHANNEL_ACCESS_TOKEN=your_line_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_ADMIN_USER_ID=your_line_admin_user_id
