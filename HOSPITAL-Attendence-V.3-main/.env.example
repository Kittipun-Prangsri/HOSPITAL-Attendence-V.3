# Server Configuration
PORT=3000
NODE_ENV=development
# Required in production — sessions are forged/hijackable without a real secret.
SESSION_SECRET=your-secret-key
# Comma-separated list of origins allowed to call /api from outside this app.
# Leave empty unless an external client needs cross-origin access — the app
# itself is same-origin and doesn't need CORS enabled.
ALLOWED_ORIGINS=

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME_HOSPITAL=hospital_db
DB_NAME_HOSOFFICE=hosoffice

# Notification Service (Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# Notification Service (LINE)
LINE_CHANNEL_ACCESS_TOKEN=your_line_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_ADMIN_USER_ID=your_line_admin_user_id
